@model IEnumerable<LTW.Models.Test>

@{
    ViewData["Title"] = "Hệ Thống Khảo Thí & Kiểm Tra Năng Lực - LUMORA";
}

<div class="py-5 bg-lumora-header text-white">
    <div class="container text-center">
        <span class="badge rounded-pill px-3 py-2 text-white mb-3" style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25);">
            <i class="bi bi-patch-check-fill me-1 text-info"></i> SIMULATION TEST SYSTEM
        </span>
        <h1 class="fw-bold mb-3">Hệ Thống Kiểm Tra Năng Lực 4 Kỹ Năng</h1>
        <p class="text-white-50 mx-auto" style="max-width: 650px;">
            Mô phỏng 100% giao diện thi IELTS trên máy tính chuẩn British Council & IDP. Đánh giá chính xác Listening, Reading, Writing, Speaking và nhận phân tích trình độ chi tiết.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        @if (Model != null && Model.Any())
        {
            foreach (var test in Model)
            {
                <div class="col-md-6 col-lg-5">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            @if (test.Type == LTW.Models.ExamType.ExampleTest)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-bold">
                                    <i class="bi bi-star-fill me-1"></i> EXAMPLE TEST (MIỄN PHÍ)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold">
                                    <i class="bi bi-award-fill me-1"></i> PLACEMENT TEST (XẾP LỚP)
                                </span>
                            }
                            <span class="text-muted small"><i class="bi bi-clock me-1"></i>@test.TimeLimitMinutes phút</span>
                        </div>

                        <h4 class="fw-bold text-dark mb-2">@test.Title</h4>
                        <p class="text-muted small mb-4 flex-grow-1" style="line-height: 1.7;">
                            @test.Description
                        </p>

                        <div class="p-3 bg-light rounded-3 mb-4 small text-secondary">
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="bi bi-headphones me-1 text-primary"></i> Listening:</span>
                                <span class="fw-semibold">Trắc nghiệm & Nghe audio</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="bi bi-book me-1 text-success"></i> Reading:</span>
                                <span class="fw-semibold">Đoạn văn học thuật Cambridge</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="bi bi-pencil-square me-1 text-warning"></i> Writing:</span>
                                <span class="fw-semibold">Viết luận đề thực tế</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span><i class="bi bi-mic me-1 text-danger"></i> Speaking:</span>
                                <span class="fw-semibold">Phỏng vấn giả lập</span>
                            </div>
                        </div>

                        <div class="mt-auto">
                            @if (test.Type == LTW.Models.ExamType.ExampleTest)
                            {
                                <a asp-action="ExampleTest" class="btn btn-outline-success w-100 py-3 fw-bold rounded-3 shadow-sm">
                                    <i class="bi bi-play-circle-fill me-2 fs-5"></i> Trải Nghiệm Example Test Ngay
                                </a>
                            }
                            else
                            {
                                <a asp-action="PlacementTest" class="btn btn-lumora-secondary text-white w-100 py-3 fw-bold rounded-3 shadow-sm">
                                    <i class="bi bi-clipboard2-check-fill me-2 fs-5"></i> Làm Bài Placement Test Ngay
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

