@model LTW.Models.Exercise
@using System.Text.Json
@using LTW.Models

@{
    ViewData["Title"] = Model.Title + " - Làm Bài Tập";
    var submission = ViewBag.Submission as ExerciseSubmission;
    Dictionary<string, string>? submittedAnswers = null;
    if (submission != null && !string.IsNullOrEmpty(submission.AnswersJson))
    {
        try { submittedAnswers = JsonSerializer.Deserialize<Dictionary<string, string>>(submission.AnswersJson); } catch { }
    }
}

<div class="container py-5" style="max-width: 960px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Lesson" asp-route-id="@Model.LessonId" class="text-decoration-none">@Model.Lesson?.Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <!-- Header Box -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div>
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">BÀI TẬP BẮT BUỘC</span>
                <h2 class="fw-bold text-dark m-0">@Model.Title</h2>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-light text-secondary border px-3 py-2 small"><i class="bi bi-clock me-1"></i>@Model.TimeLimitMinutes phút</span>
                <span class="badge bg-light text-secondary border px-3 py-2 small"><i class="bi bi-check-circle me-1"></i>Điểm đạt: @Model.PassingScore/100</span>
            </div>
        </div>

        <p class="text-secondary small m-0" style="line-height: 1.6;">
            @(string.IsNullOrEmpty(Model.Description) ? "Đọc kỹ các câu hỏi và chọn đáp án chính xác nhất." : Model.Description)
        </p>

        <!-- Previous Submission Alert -->
        @if (submission != null)
        {
            bool hasWriting = Model.Questions.Any(q => q.Format == QuestionFormat.Writing || q.Format == QuestionFormat.Speaking);
            bool hasMc = Model.Questions.Any(q => q.Format != QuestionFormat.Writing && q.Format != QuestionFormat.Speaking);
            decimal totalMcPoints = Model.Questions.Where(q => q.Format != QuestionFormat.Writing && q.Format != QuestionFormat.Speaking).Sum(q => q.Points > 0 ? q.Points : 10m);
            decimal autoScore = submission.AutoScore;
            string earnedStr = (autoScore % 1 == 0) ? ((int)autoScore).ToString() : autoScore.ToString("F1");
            string totalStr = (totalMcPoints % 1 == 0) ? ((int)totalMcPoints).ToString() : totalMcPoints.ToString("F1");
            string mcScoreDisplay = totalMcPoints > 0 ? $"{earnedStr}/{totalStr}" : earnedStr;

            <div class="alert alert-light border shadow-sm mt-4 p-4 rounded-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                            <i class="bi bi-award-fill fs-2"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark m-0">Kết Quả Bài Làm Của Bạn</h5>
                            <small class="text-muted">Nộp lúc: @submission.SubmittedAt.ToString("HH:mm - dd/MM/yyyy")</small>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @if (hasWriting)
                        {
                            <div class="px-3 py-2 bg-light rounded-pill border small">
                                <span class="text-muted">Điểm trắc nghiệm:</span>
                                <strong class="text-primary ms-1">@mcScoreDisplay</strong>
                            </div>

                            <div class="px-3 py-2 bg-light rounded-pill border small">
                                <span class="text-muted">Điểm tự luận:</span>
                                @if (submission.TeacherScore.HasValue)
                                {
                                    <strong class="text-success ms-1">@submission.TeacherScore.Value.ToString("G29") điểm</strong>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark ms-1">Chờ GV chấm</span>
                                }
                            </div>

                            <div class="px-3 py-2 rounded-pill small @(submission.TeacherScore.HasValue ? "bg-success text-white" : "bg-secondary text-white")">
                                <span>Tổng điểm:</span>
                                @if (submission.TeacherScore.HasValue)
                                {
                                    <strong class="ms-1">@submission.TotalScore.ToString("G29")</strong>
                                }
                                else
                                {
                                    <span class="ms-1">@mcScoreDisplay (+ Chờ GV chấm)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="px-3 py-2 bg-light rounded-pill border small">
                                <span class="text-muted">Điểm tự chấm (Đáp án cố định):</span>
                                <strong class="text-success ms-1">@mcScoreDisplay</strong>
                            </div>
                            <div class="px-3 py-2 bg-success text-white rounded-pill small">
                                <span>Tổng điểm:</span>
                                <strong class="ms-1">@submission.TotalScore.ToString("G29")</strong>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(submission.TeacherComment))
                {
                    <div class="p-3 bg-white rounded-3 border">
                        <div class="fw-bold text-dark mb-1"><i class="bi bi-chat-quote-fill me-2 text-primary"></i>Nhận xét từ Giảng viên:</div>
                        <div class="text-secondary small" style="line-height: 1.6;">@submission.TeacherComment</div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Questions Form -->
    <form asp-action="SubmitExercise" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="exerciseId" value="@Model.ExerciseId" />

        @{ int qCount = 0; }
        @foreach (var q in Model.Questions)
        {
            qCount++;
            var userAns = submittedAnswers != null ? submittedAnswers.GetValueOrDefault($"q_{q.QuestionId}") : null;
            bool isWriting = q.Format == QuestionFormat.Writing || q.Format == QuestionFormat.Speaking;
            var isAnswerCorrect = submission != null && !isWriting && !string.IsNullOrEmpty(userAns) && q.CorrectAnswer.Trim().StartsWith(userAns.Substring(0, Math.Min(2, userAns.Length)));

            string borderClass = "";
            if (submission != null)
            {
                if (isWriting)
                {
                    borderClass = submission.TeacherScore.HasValue ? "border-start border-4 border-info" : "border-start border-4 border-warning";
                }
                else
                {
                    borderClass = isAnswerCorrect ? "border-start border-4 border-success" : "border-start border-4 border-danger";
                }
            }

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white @borderClass">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary px-3 py-2 rounded-pill fw-semibold" style="background-color: #00A896 !important;">
                            @q.Skill
                        </span>
                        <span class="fw-bold text-dark">Câu @qCount: @(isWriting ? "Tự Luận (Writing)" : "Trắc Nghiệm")</span>
                    </div>

                    @if (submission != null)
                    {
                        if (isWriting)
                        {
                            if (submission.TeacherScore.HasValue)
                            {
                                <span class="badge bg-success text-white px-3 py-2 rounded-pill"><i class="bi bi-person-check-fill me-1"></i> Điểm GV chấm: @submission.TeacherScore.Value.ToString("G29") điểm</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> Chờ GV chấm</span>
                            }
                        }
                        else if (isAnswerCorrect)
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle me-1"></i> Chính xác (+@q.Points đ)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle me-1"></i> Chưa chính xác (0/@q.Points đ)</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-light text-secondary border small">@q.Points Điểm</span>
                    }
                </div>

                <h6 class="fw-bold text-dark mb-3">@q.Content</h6>

                <!-- Options / Answer Area -->
                @{
                    string[]? options = null;
                    if (!string.IsNullOrEmpty(q.OptionsJson))
                    {
                        try { options = JsonSerializer.Deserialize<string[]>(q.OptionsJson); } catch { }
                    }
                }

                @if (isWriting || options == null || options.Length == 0)
                {
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">
                            <i class="bi bi-pencil-square me-1"></i> Bài làm / Câu trả lời tự luận của bạn:
                        </label>
                        <textarea name="q_@q.QuestionId" class="form-control" rows="5" 
                                  placeholder="Nhập nội dung bài làm tự luận của bạn tại đây..." 
                                  @(submission != null ? "readonly" : "required")>@(userAns ?? "")</textarea>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var opt in options)
                        {
                            var isChecked = userAns == opt;
                            <div class="form-check p-3 border rounded-3 bg-light-subtle @(submission != null && isChecked ? (isAnswerCorrect ? "border-success bg-success bg-opacity-10" : "border-danger bg-danger bg-opacity-10") : "")">
                                <input class="form-check-input ms-0 me-3" type="radio" 
                                       name="q_@q.QuestionId" id="opt_@(q.QuestionId)_@opt.GetHashCode()" 
                                       value="@opt" @(isChecked ? "checked" : "") @(submission != null ? "disabled" : "") />
                                <label class="form-check-label w-100 cursor-pointer text-dark" for="opt_@(q.QuestionId)_@opt.GetHashCode()">
                                    @opt
                                </label>
                            </div>
                        }
                    </div>
                }

                <!-- Review Breakdown after submission -->
                @if (submission != null)
                {
                    <div class="p-3 bg-light rounded-3 mt-2 border small">
                        @if (isWriting)
                        {
                            <div class="mb-1 text-primary">
                                <i class="bi bi-info-circle-fill me-1"></i> <strong>Gợi ý đáp án / Tiêu chí đánh giá:</strong> @q.CorrectAnswer
                            </div>
                            @if (!string.IsNullOrEmpty(submission.TeacherComment))
                            {
                                <div class="text-secondary mt-1">
                                    <strong class="text-dark"><i class="bi bi-chat-quote-fill me-1 text-warning"></i> Lời nhận xét của Giảng viên:</strong> @submission.TeacherComment
                                </div>
                            }
                        }
                        else
                        {
                            <div class="mb-1"><strong class="text-success"><i class="bi bi-check-circle-fill me-1"></i> Đáp án đúng:</strong> @q.CorrectAnswer</div>
                        }
                        @if (!string.IsNullOrEmpty(q.Explanation))
                        {
                            <div class="text-secondary mt-1"><strong class="text-primary"><i class="bi bi-lightbulb-fill me-1"></i> Giải thích chi tiết:</strong> @q.Explanation</div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Submit or Return buttons -->
        <div class="d-flex justify-content-between align-items-center pt-3">
            <a asp-action="Lesson" asp-route-id="@Model.LessonId" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Quay Lại Bài Học
            </a>

            @if (submission == null)
            {
                <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill fw-bold shadow-sm fs-6" style="background-color: #00A896; border-color: #00A896;">
                    <i class="bi bi-send-check-fill me-2"></i> Nộp Bài Chấm Điểm
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-outline-primary px-4 py-2 rounded-pill fw-semibold">
                    <i class="bi bi-arrow-repeat me-1"></i> Làm Lại Bài Tập
                </button>
            }
        </div>
    </form>
</div>

