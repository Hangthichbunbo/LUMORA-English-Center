@using LTW.Data
@using LTW.Models
@{
    ViewData["Title"] = "Bàn Học Cá Nhân (Student Dashboard) - LUMORA";
    var user = ViewBag.User as ApplicationUser;
    var enrollments = ViewBag.Enrollments as List<Enrollment> ?? new List<Enrollment>();
    var completedLessonIds = ViewBag.CompletedLessonIds as List<int> ?? new List<int>();
    var upcomingClasses = ViewBag.UpcomingClasses as List<LiveClass> ?? new List<LiveClass>();
    var pendingExercises = ViewBag.PendingExercises as List<Exercise> ?? new List<Exercise>();
    var recentSubmissions = ViewBag.RecentSubmissions as List<ExerciseSubmission> ?? new List<ExerciseSubmission>();
    var latestTestAttempt = ViewBag.LatestTestAttempt as TestAttempt;
    var notifications = ViewBag.Notifications as List<Notification> ?? new List<Notification>();
}

<div class="py-4 bg-light border-bottom">
    <div class="container">
        <div class="row align-items-center g-3">
            <div class="col-md-8 d-flex align-items-center gap-3">
                <img src="@(string.IsNullOrEmpty(user?.AvatarUrl) ? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80" : user.AvatarUrl)" 
                     alt="Avatar" class="rounded-circle shadow-sm" style="width: 64px; height: 64px; object-fit: cover; border: 3px solid var(--brand-secondary);" />
                <div>
                    <h3 class="fw-bold text-dark mb-0">Xin chào, @(user?.FullName ?? "Học viên Lumora")!</h3>
                    <p class="text-muted small mb-0">Tiếp tục lộ trình học tập và hoàn thành các mục tiêu hôm nay nhé.</p>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <a asp-action="MyCourses" class="btn btn-outline-primary rounded-pill px-4 fw-semibold me-2">
                    <i class="bi bi-journal-check me-1"></i> Khóa Học Của Tôi
                </a>
                <a asp-controller="Test" asp-action="PlacementTest" class="btn btn-lumora-secondary text-white rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-award me-1"></i> Thi Placement Test
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <!-- Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary"><i class="bi bi-journal-bookmark-fill fs-3"></i></div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@enrollments.Count</div>
                    <small class="text-muted">Khóa học đã mua</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-success bg-opacity-10 rounded-3 text-success"><i class="bi bi-check2-circle fs-3"></i></div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@completedLessonIds.Count</div>
                    <small class="text-muted">Bài học đã hoàn thành</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning"><i class="bi bi-clock-history fs-3"></i></div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@pendingExercises.Count</div>
                    <small class="text-muted">Bài tập cần nộp</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-info bg-opacity-10 rounded-3 text-info"><i class="bi bi-award-fill fs-3"></i></div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@(latestTestAttempt != null ? latestTestAttempt.OverallScore.ToString("F1") : "--")</div>
                    <small class="text-muted">Band điểm kiểm tra</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột trái: Khóa học của tôi & Tiến độ -->
        <div class="col-lg-8">
            <!-- Section My Courses -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-mortarboard me-2 text-primary"></i>Khóa Học Đang Theo Học</h5>
                    <a asp-action="MyCourses" class="text-primary text-decoration-none small fw-semibold">Xem tất cả</a>
                </div>

                @if (enrollments.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var item in enrollments)
                        {
                            var totalCourseLessons = item.Course?.TotalLessons ?? 1;
                            var completedInCourse = item.Course?.Chapters
                                .SelectMany(ch => ch.Lessons)
                                .Count(l => completedLessonIds.Contains(l.LessonId)) ?? 0;
                            var percent = totalCourseLessons > 0 ? (int)((double)completedInCourse / totalCourseLessons * 100) : 0;
                            var firstLesson = item.Course?.Chapters.OrderBy(c => c.OrderIndex).FirstOrDefault()?.Lessons.OrderBy(l => l.OrderIndex).FirstOrDefault();

                            <div class="p-3 border rounded-3 bg-light d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@item.Course?.Thumbnail" alt="@item.Course?.Title" class="rounded-3 shadow-sm d-none d-sm-block" style="width: 80px; height: 80px; object-fit: cover;" />
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">@item.Course?.Title</h6>
                                        <div class="small text-muted mb-2">@completedInCourse / @totalCourseLessons bài học hoàn thành</div>
                                        <div class="progress" style="height: 8px; width: 180px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-3">
                                    <span class="fw-bold text-success small">@percent%</span>
                                    @if (firstLesson != null)
                                    {
                                        <a asp-action="Lesson" asp-route-id="@firstLesson.LessonId" class="btn btn-lumora-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm">
                                            <i class="bi bi-play-circle me-1"></i> Tiếp Tục Học
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
                        <p class="small mb-3">Bạn chưa đăng ký khóa học nào.</p>
                        <a asp-controller="Course" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-4">Khám phá khóa học ngay</a>
                    </div>
                }
            </div>

            <!-- Upcoming Classes Box -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-camera-video me-2 text-danger"></i>Lớp Học Trực Tuyến Sắp Tới</h5>
                    <a asp-controller="Class" asp-action="Index" class="text-primary text-decoration-none small fw-semibold">Xem lịch học</a>
                </div>

                @if (upcomingClasses.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var cls in upcomingClasses)
                        {
                            <div class="p-3 border rounded-3 bg-light d-flex flex-wrap align-items-center justify-content-between gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        @if (cls.IsPublic) { <span class="badge bg-success rounded-pill small">PUBLIC</span> }
                                        else { <span class="badge bg-danger rounded-pill small">PRIVATE</span> }
                                        <span class="text-secondary small fw-semibold">
                                            <i class="bi bi-calendar-event me-1"></i> @cls.ScheduledDate.ToString("dd/MM/yyyy") | @cls.StartTime.ToString(@"hh\:mm") - @cls.EndTime.ToString(@"hh\:mm")
                                        </span>
                                    </div>
                                    <h6 class="fw-bold text-dark mb-1">@cls.ClassName</h6>
                                    <div class="text-muted small"><i class="bi bi-person me-1"></i>Giảng viên: @(cls.Teacher?.FullName ?? "Lumora Teacher")</div>
                                </div>
                                <a asp-controller="Class" asp-action="Join" asp-route-id="@cls.LiveClassId" class="btn btn-danger btn-sm px-4 rounded-pill fw-semibold shadow-sm">
                                    <i class="bi bi-broadcast me-1"></i> Tham Gia Lớp
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small m-0">Không có lớp học trực tuyến nào diễn ra hôm nay.</p>
                }
            </div>

            <!-- Pending Exercises -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold text-dark mb-4"><i class="bi bi-pencil-square me-2 text-warning"></i>Bài Tập Cần Hoàn Thành</h5>

                @if (pendingExercises.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var ex in pendingExercises)
                        {
                            <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between gap-3">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@ex.Title</h6>
                                    <div class="text-muted small">Thời gian: @ex.TimeLimitMinutes phút • Điểm đạt: @ex.PassingScore/100</div>
                                </div>
                                <a asp-action="Exercise" asp-route-id="@ex.ExerciseId" class="btn btn-warning btn-sm px-4 rounded-pill fw-semibold text-dark">
                                    <i class="bi bi-pencil me-1"></i> Làm Bài Tập
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-success small"><i class="bi bi-check-circle-fill me-1"></i> Tuyệt vời! Bạn không còn bài tập nào bị quá hạn.</div>
                }
            </div>
        </div>

        <!-- Cột phải: Placement Test Result & Notifications -->
        <div class="col-lg-4">
            <!-- Latest Test Result Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-award me-2 text-primary"></i>Kết Quả Placement Test</h5>
                @if (latestTestAttempt != null)
                {
                    <div class="text-center p-3 bg-light rounded-4 mb-3 border">
                        <small class="text-muted text-uppercase fw-bold">Overall Band Score</small>
                        <div class="display-5 fw-bold text-primary mb-1" style="color: var(--brand-secondary) !important;">
                            @latestTestAttempt.OverallScore.ToString("F1")
                        </div>
                        <span class="badge bg-success px-3 py-1 rounded-pill small">@latestTestAttempt.EstimatedLevel</span>
                    </div>

                    <div class="row g-2 text-center small text-secondary mb-3">
                        <div class="col-3 p-1 bg-light rounded">L: <strong>@latestTestAttempt.ListeningScore.ToString("F1")</strong></div>
                        <div class="col-3 p-1 bg-light rounded">R: <strong>@latestTestAttempt.ReadingScore.ToString("F1")</strong></div>
                        <div class="col-3 p-1 bg-light rounded">W: <strong>@latestTestAttempt.WritingScore.ToString("F1")</strong></div>
                        <div class="col-3 p-1 bg-light rounded">S: <strong>@latestTestAttempt.SpeakingScore.ToString("F1")</strong></div>
                    </div>

                    <a asp-controller="Test" asp-action="Result" asp-route-id="@latestTestAttempt.AttemptId" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                        Xem Báo Cáo Phân Tích Chi Tiết
                    </a>
                }
                else
                {
                    <p class="text-muted small mb-3">Bạn chưa thực hiện bài kiểm tra xếp lớp nào. Hãy làm test để nhận lộ trình cá nhân hóa.</p>
                    <a asp-controller="Test" asp-action="PlacementTest" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                        Làm Placement Test Ngay
                    </a>
                }
            </div>

            <!-- Notifications Center Box -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-bell me-2 text-secondary"></i>Thông Báo & Nhắc Nhở</h5>
                    <a asp-controller="Notification" asp-action="Index" class="text-primary small text-decoration-none">Tất cả</a>
                </div>

                @if (notifications.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var n in notifications)
                        {
                            <div class="p-2 border rounded-3 bg-light small">
                                <div class="fw-bold text-dark">@n.Title</div>
                                <div class="text-muted" style="font-size: 11px;">@n.Content</div>
                                <div class="text-secondary mt-1" style="font-size: 10px;"><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("dd/MM HH:mm")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small m-0">Không có thông báo mới.</p>
                }
            </div>
        </div>
    </div>
</div>

