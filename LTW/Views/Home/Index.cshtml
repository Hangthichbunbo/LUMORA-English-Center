@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ---------------------------------------------------------------
            // 1. Teacher Slider logic
            // ---------------------------------------------------------------
            const track = document.getElementById('teacherSliderTrack');
            const prevBtn = document.getElementById('teacherSliderPrev');
            const nextBtn = document.getElementById('teacherSliderNext');
            const scrollBar = document.getElementById('teacherSliderScrollbar');

            if (track) {
                const scrollStep = 344; // card width (320px) + gap (24px)

                function updateScrollBar() {
                    if (!scrollBar) return;
                    const maxScrollLeft = track.scrollWidth - track.clientWidth;
                    if (maxScrollLeft <= 0) {
                        scrollBar.style.width = '100%';
                        scrollBar.style.transform = 'translateX(0)';
                        return;
                    }
                    const scrollRatio = track.scrollLeft / maxScrollLeft;
                    const barWidthPercent = Math.max(20, Math.round((track.clientWidth / track.scrollWidth) * 100));
                    scrollBar.style.width = barWidthPercent + '%';
                    const maxTranslate = 100 - barWidthPercent;
                    scrollBar.style.transform = `translateX(${scrollRatio * maxTranslate * (100 / barWidthPercent)}%)`;
                }

                if (prevBtn) {
                    prevBtn.addEventListener('click', function () {
                        track.scrollBy({ left: -scrollStep, behavior: 'smooth' });
                    });
                }

                if (nextBtn) {
                    nextBtn.addEventListener('click', function () {
                        track.scrollBy({ left: scrollStep, behavior: 'smooth' });
                    });
                }

                track.addEventListener('scroll', updateScrollBar, { passive: true });
                window.addEventListener('resize', updateScrollBar, { passive: true });
                updateScrollBar();

                // Mouse drag-and-swipe support
                let isDown = false;
                let startX;
                let scrollLeft;

                track.addEventListener('mousedown', (e) => {
                    if (e.target.closest('a') || e.target.closest('button')) return;
                    isDown = true;
                    track.classList.add('active-dragging');
                    startX = e.pageX - track.offsetLeft;
                    scrollLeft = track.scrollLeft;
                });

                track.addEventListener('mouseleave', () => {
                    isDown = false;
                    track.classList.remove('active-dragging');
                });

                track.addEventListener('mouseup', () => {
                    isDown = false;
                    track.classList.remove('active-dragging');
                });

                track.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - track.offsetLeft;
                    const walk = (x - startX) * 1.5;
                    track.scrollLeft = scrollLeft - walk;
                });
            }

            // ---------------------------------------------------------------
            // 2. Form Tư Vấn Lộ Trình: Kiểm tra bắt buộc & không nhảy về đầu trang
            // ---------------------------------------------------------------
            const consultForm = document.getElementById('consultationForm');
            const consultAlertBox = document.getElementById('consultationAlertPlaceholder');
            const contactSection = document.getElementById('contact-section');

            // Nếu trang được load lại mà có thông báo ở form tư vấn hoặc có hash #contact-section, giữ vị trí tại form
            if (window.location.hash === '#contact-section' || (consultAlertBox && consultAlertBox.querySelector('.alert'))) {
                setTimeout(() => {
                    if (contactSection) {
                        contactSection.scrollIntoView({ behavior: 'smooth' });
                    }
                }, 100);
            }

            if (consultForm) {
                consultForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const nameInput = consultForm.querySelector('[name="ConsultationForm.FullName"]');
                    const emailInput = consultForm.querySelector('[name="ConsultationForm.Email"]');
                    const phoneInput = consultForm.querySelector('[name="ConsultationForm.PhoneNumber"]');

                    // Kiểm tra các trường bắt buộc
                    const nameVal = nameInput ? nameInput.value.trim() : '';
                    const emailVal = emailInput ? emailInput.value.trim() : '';
                    const phoneVal = phoneInput ? phoneInput.value.trim() : '';

                    if (!nameVal || !emailVal || !phoneVal) {
                        if (consultAlertBox) {
                            consultAlertBox.innerHTML = `
                                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Vui lòng kiểm tra lại các trường thông tin bắt buộc.
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            `;
                        }
                        if (contactSection) {
                            contactSection.scrollIntoView({ behavior: 'smooth' });
                        }
                        if (!nameVal && nameInput) nameInput.focus();
                        else if (!emailVal && emailInput) emailInput.focus();
                        else if (!phoneVal && phoneInput) phoneInput.focus();
                        return;
                    }

                    // Kiểm tra định dạng email
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    if (!emailRegex.test(emailVal)) {
                        if (consultAlertBox) {
                            consultAlertBox.innerHTML = `
                                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Vui lòng kiểm tra lại các trường thông tin bắt buộc (Địa chỉ Email không đúng định dạng).
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            `;
                        }
                        if (contactSection) {
                            contactSection.scrollIntoView({ behavior: 'smooth' });
                        }
                        if (emailInput) emailInput.focus();
                        return;
                    }

                    // Gửi form qua AJAX để không bao giờ bị load lại trang hay nhảy lên đầu trang
                    const formData = new FormData(consultForm);
                    
                    // Mục "Nhu cầu cụ thể hoặc kỹ năng cần cải thiện" là không bắt buộc
                    const msgVal = formData.get('ConsultationForm.Message');
                    if (!msgVal || !msgVal.trim()) {
                        formData.set('ConsultationForm.Message', 'Tư vấn lộ trình chung');
                    }
                    fetch(consultForm.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            if (consultAlertBox) {
                                consultAlertBox.innerHTML = `
                                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                                        <i class="bi bi-check-circle-fill me-2"></i> ${data.message}
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                `;
                            }
                            consultForm.reset();
                        } else {
                            if (consultAlertBox) {
                                consultAlertBox.innerHTML = `
                                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i> ${data.message || 'Vui lòng kiểm tra lại các trường thông tin bắt buộc.'}
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                `;
                            }
                        }
                        if (contactSection) {
                            contactSection.scrollIntoView({ behavior: 'smooth' });
                        }
                    })
                    .catch(err => {
                        // Fallback submit bình thường nếu lỗi mạng hoặc không trả về JSON
                        consultForm.submit();
                    });
                });
            }

            // ---------------------------------------------------------------
            // 3. Modal Đăng Ký Giữ Chỗ Miễn Phí
            // ---------------------------------------------------------------
            const resForm = document.getElementById('reservationForm');
            const resSuccessBox = document.getElementById('reservationSuccessBox');
            const resErrorAlert = document.getElementById('reservationErrorAlert');
            const resErrorText = document.getElementById('reservationErrorText');
            const modalTopicText = document.getElementById('modalTopicText');

            let selectedTopic = '';
            let selectedSpeaker = '';
            let selectedDateTime = '';

            document.querySelectorAll('.btn-open-reservation').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    selectedTopic = this.getAttribute('data-topic') || '';
                    selectedSpeaker = this.getAttribute('data-speaker') || '';
                    selectedDateTime = this.getAttribute('data-datetime') || '';

                    if (modalTopicText) {
                        modalTopicText.textContent = `${selectedTopic} — Diễn giả: ${selectedSpeaker} (${selectedDateTime})`;
                    }

                    // Reset trạng thái form khi mở modal
                    if (resForm) {
                        resForm.reset();
                        resForm.classList.remove('d-none');
                    }
                    if (resSuccessBox) resSuccessBox.classList.add('d-none');
                    if (resErrorAlert) resErrorAlert.classList.add('d-none');
                });
            });

            if (resForm) {
                resForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const name = document.getElementById('resStudentName').value.trim();
                    const dob = document.getElementById('resBirthDate').value;
                    const level = document.getElementById('resCurrentLevel').value;
                    const phone = document.getElementById('resPhone').value.trim();
                    const email = document.getElementById('resEmail').value.trim();

                    // Kiểm tra tất cả các trường bắt buộc
                    if (!name || !dob || !level || !phone || !email) {
                        if (resErrorAlert && resErrorText) {
                            resErrorText.textContent = 'Vui lòng kiểm tra lại và điền đầy đủ các trường thông tin bắt buộc (*).';
                            resErrorAlert.classList.remove('d-none');
                        }
                        return;
                    }

                    // Kiểm tra email
                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    if (!emailRegex.test(email)) {
                        if (resErrorAlert && resErrorText) {
                            resErrorText.textContent = 'Địa chỉ Gmail / Email không đúng định dạng.';
                            resErrorAlert.classList.remove('d-none');
                        }
                        return;
                    }

                    if (resErrorAlert) resErrorAlert.classList.add('d-none');

                    // Hiển thị thông báo chúc mừng đăng ký thành công
                    document.getElementById('successTopic').textContent = selectedTopic || 'IELTS Masterclass';
                    document.getElementById('successName').textContent = name;
                    document.getElementById('successDob').textContent = dob;
                    document.getElementById('successLevel').textContent = level;
                    document.getElementById('successPhone').textContent = phone;
                    document.getElementById('successEmail').textContent = email;

                    resForm.classList.add('d-none');
                    resSuccessBox.classList.remove('d-none');
                });
            }
        });
    </script>
}

