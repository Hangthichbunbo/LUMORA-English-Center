@using Microsoft.AspNetCore.Identity
@using LTW.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="d-flex align-items-center gap-2 ms-lg-3 mt-3 mt-lg-0">
    @if (SignInManager.IsSignedIn(User))
    {
        <a class="btn btn-outline-subtle btn-sm px-3" asp-area="Identity" asp-page="/Account/Manage/Index" title="Quản lý tài khoản">
            <i class="bi bi-person-circle text-primary me-1"></i>
            <span>@UserManager.GetUserName(User)</span>
        </a>
        <form class="d-inline m-0 p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="btn btn-outline-danger btn-sm px-3">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
            </button>
        </form>
    }
    else
    {
        <a class="btn btn-brand btn-sm px-3" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Log In
        </a>
        <a class="btn btn-cta-accent btn-sm px-3" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus-fill me-1"></i> Sign Up
        </a>
    }
</div>
</ul>