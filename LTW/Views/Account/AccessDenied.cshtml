@{
    ViewData["Title"] = "Không Có Quyền Truy Cập - LUMORA English Center";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-5">
        <div class="mb-4 text-danger">
            <i class="bi bi-shield-x fs-1" style="font-size: 4rem !important;"></i>
        </div>
        <h2 class="fw-bold text-dark mb-2">Truy Cập Bị Từ Chối</h2>
        <p class="text-muted mb-4">
            Bạn không có đặc quyền để truy cập trang này. Vui lòng kiểm tra lại quyền hạn tài khoản của bạn (Student, Teacher, Admin).
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                <i class="bi bi-house me-1"></i> Trang Chủ
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 py-2 rounded-3" style="background-color: #00A896; border-color: #00A896;">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Tài Khoản Khác
            </a>
        </div>
    </div>
</div>

