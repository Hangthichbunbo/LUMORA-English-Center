@model LTW.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu - LUMORA English Center";
}

<div class="auth-page-wrapper py-5">
    <div class="container" style="max-width: 540px;">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            <div class="mb-4">
                <span class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-success shadow-sm" style="width: 72px; height: 72px;">
                    <i class="bi bi-shield-check fs-1 text-success"></i>
                </span>
                <h3 class="fw-bold text-dark">Đặt Lại Mật Khẩu Mới</h3>
                <p class="text-muted small">
                    Mã xác thực OTP hợp lệ. Vui lòng nhập mật khẩu mới cho tài khoản của bạn.
                </p>
            </div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="OtpCode" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                <div class="mb-3 text-start">
                    <label asp-for="NewPassword" class="form-label fw-semibold small text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" class="form-control border-start-0 py-2" placeholder="Tối thiểu 6 ký tự" autofocus />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4 text-start">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-check2-circle"></i></span>
                        <input asp-for="ConfirmNewPassword" class="form-control border-start-0 py-2" placeholder="Nhập lại mật khẩu mới" />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                        <i class="bi bi-save me-1"></i> Lưu Mật Khẩu & Đăng Nhập
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

