@model LTW.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên Mật Khẩu - LUMORA English Center";
}

<div class="auth-page-wrapper py-5">
    <div class="container" style="max-width: 540px;">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            <div class="mb-4">
                <span class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-warning shadow-sm" style="width: 72px; height: 72px;">
                    <i class="bi bi-key-fill fs-1 text-warning"></i>
                </span>
                <h3 class="fw-bold text-dark">Quên Mật Khẩu?</h3>
                <p class="text-muted small">
                    Nhập địa chỉ email đăng ký của bạn. Hệ thống sẽ gửi mã OTP để bạn xác thực và thiết lập mật khẩu mới.
                </p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                <div class="mb-4 text-start">
                    <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 py-2" placeholder="name@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                        <i class="bi bi-send me-1"></i> Gửi Mã OTP Xác Thực
                    </button>
                </div>

                <div class="small text-secondary mt-3">
                    Nhớ mật khẩu rồi? 
                    <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Quay lại Đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

