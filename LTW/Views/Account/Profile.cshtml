@model LTW.Models.ProfileViewModel

@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân - LUMORA English Center";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Sidebar Info -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=250&q=80" : Model.AvatarUrl)" 
                         alt="@Model.FullName" class="rounded-circle shadow" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #fff;" />
                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success p-2">
                        <i class="bi bi-check"></i>
                    </span>
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2">&#64;@Model.Username</p>
                <div class="mb-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-person-badge me-1"></i> Vai trò: @Model.RoleName
                    </span>
                </div>
                <p class="text-secondary small">
                    @(string.IsNullOrEmpty(Model.Bio) ? "Chưa có lời giới thiệu bản thân." : Model.Bio)
                </p>

                <hr class="my-3" />
                <div class="d-grid gap-2">
                    @if (Model.RoleName == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary btn-sm rounded-3">
                            <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                        </a>
                    }
                    else if (Model.RoleName == "Teacher")
                    {
                        <a asp-controller="Teacher" asp-action="Dashboard" class="btn btn-outline-primary btn-sm rounded-3">
                            <i class="bi bi-mortarboard me-1"></i> Teacher Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Student" asp-action="Dashboard" class="btn btn-outline-primary btn-sm rounded-3">
                            <i class="bi bi-grid me-1"></i> Bàn học cá nhân (Dashboard)
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Main Profile Form -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h4 class="fw-bold text-dark mb-4"><i class="bi bi-gear-wide-connected me-2 text-primary"></i>Cài Đặt & Chỉnh Sửa Hồ Sơ</h4>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show small" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <h6 class="fw-bold text-secondary text-uppercase small mb-3">Thông Tin Chung</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0987654321" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Email (Không đổi)</label>
                            <input value="@Model.Email" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Tên đăng nhập</label>
                            <input value="@Model.Username" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-12">
                            <label asp-for="AvatarUrl" class="form-label small fw-semibold text-secondary">Đường dẫn ảnh đại diện (URL)</label>
                            <input asp-for="AvatarUrl" class="form-control" placeholder="https://example.com/avatar.jpg" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Chia sẻ mục tiêu học tiếng Anh của bạn..."></textarea>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h6 class="fw-bold text-secondary text-uppercase small mb-3">Đổi Mật Khẩu (Để trống nếu không muốn đổi)</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="CurrentPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="CurrentPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ConfirmNewPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold rounded-3 shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                            <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

