@model LTW.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký Tài Khoản - LUMORA English Center";
}

<div class="lumora-auth-bg">
    <div class="lumora-auth-card">
        <div class="row g-0">
            <!-- Cột trái: Brand Banner (Đồng bộ chuẩn thiết kế LUMORA) -->
            <div class="col-lg-5 d-none d-lg-flex lumora-auth-side-brand">
                <div>
                    <!-- Logo LUMORA English Center -->
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <i class="bi bi-mortarboard-fill fs-2 text-white"></i>
                        <span class="fs-4 fw-bolder tracking-tight">
                            LUMORA <span style="color: #38bdf8;">English Center</span>
                        </span>
                    </div>

                    <!-- Platinum Partner Badge Card -->
                    <div class="lumora-partner-capsule mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-patch-check-fill text-warning"></i>
                            <span style="font-size: 11px; letter-spacing: 0.5px; font-weight: 700; color: #fbbf24;">PLATINUM PARTNER</span>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="badge-bc-navy">BRITISH COUNCIL</span>
                            <span class="badge-idp-red">IDP</span>
                        </div>
                    </div>

                    <!-- Tiêu đề nổi bật -->
                    <h3 class="fw-bolder mb-2 text-white" style="font-size: 26px; line-height: 1.3;">
                        Luyện Thi IELTS Chuẩn <span style="color: #38bdf8;">Đề Thi Thật</span>
                    </h3>

                    <!-- Đoạn mô tả -->
                    <p class="small mb-3" style="color: rgba(255, 255, 255, 0.72); line-height: 1.6; font-size: 13.5px;">
                        Hệ thống kiểm tra & chấm điểm IELTS trực tuyến hàng đầu, mô phỏng bài thi trên máy tính với phân tích AI tức thì.
                    </p>

                    <!-- 4 Kỹ năng IELTS Pills -->
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <span class="auth-skill-pill skill-listening">
                            <i class="bi bi-headphones"></i> Listening
                        </span>
                        <span class="auth-skill-pill skill-reading">
                            <i class="bi bi-book"></i> Reading
                        </span>
                        <span class="auth-skill-pill skill-writing">
                            <i class="bi bi-pencil-square"></i> Writing
                        </span>
                        <span class="auth-skill-pill skill-speaking">
                            <i class="bi bi-mic"></i> Speaking
                        </span>
                    </div>

                    <!-- Điểm nổi bật / Checklist -->
                    <div class="d-flex flex-column gap-3 mb-4 small" style="color: rgba(255, 255, 255, 0.88); font-size: 13px;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-shield-check text-success fs-6 mt-1"></i>
                            <span>500+ bộ đề bản quyền Cambridge & chuẩn format thi thật</span>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-robot text-info fs-6 mt-1"></i>
                            <span>Chấm điểm AI phân tích chi tiết tiêu chí Lexical & Grammar</span>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-graph-up-arrow text-warning fs-6 mt-1"></i>
                            <span>Lộ trình cá nhân hóa hướng tới mục tiêu Band 7.5+</span>
                        </div>
                    </div>
                </div>

                <!-- Thống kê học viên tin cậy chân trang -->
                <div class="pt-3 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center small text-white-50">
                    <div>
                        <i class="bi bi-people-fill text-warning me-1"></i>
                        <strong class="text-white">2.5M+</strong> Học viên tin cậy
                    </div>
                    <div>
                        <i class="bi bi-star-fill text-warning me-1"></i>
                        <strong class="text-white">4.9/5</strong> Đánh giá
                    </div>
                </div>
            </div>

            <!-- Cột phải: Form Đăng ký -->
            <div class="col-lg-7 lumora-auth-side-form">
                <div class="mb-4">
                    <span class="auth-portal-badge mb-3">
                        <i class="bi bi-patch-check-fill text-primary"></i> CỔNG ĐĂNG KÝ HỌC VIÊN
                    </span>
                    <h2 class="fw-bolder mb-1" style="color: #0f172a; font-size: 28px;">Tạo tài khoản mới!</h2>
                    <p class="text-secondary small mb-0">Điền thông tin bên dưới để bắt đầu kiểm tra trình độ và tham gia các khóa học.</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                    <!-- Trường Họ và tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold small text-secondary mb-1">
                            <i class="bi bi-person me-1 text-primary"></i> Họ và tên
                        </label>
                        <div class="input-group auth-input-group shadow-xs">
                            <span class="input-group-text"><i class="bi bi-person fs-5"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" autofocus />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Hàng 2 cột: Email và Tên đăng nhập -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold small text-secondary mb-1">
                                <i class="bi bi-envelope me-1 text-primary"></i> Địa chỉ Email
                            </label>
                            <div class="input-group auth-input-group shadow-xs">
                                <span class="input-group-text"><i class="bi bi-at fs-5"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="vidu@lumora.edu.vn" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-bold small text-secondary mb-1">
                                <i class="bi bi-person-badge me-1 text-primary"></i> Tên đăng nhập
                            </label>
                            <div class="input-group auth-input-group shadow-xs">
                                <span class="input-group-text"><i class="bi bi-hash fs-5"></i></span>
                                <input asp-for="Username" class="form-control" placeholder="annguyen123" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Hàng 2 cột: Mật khẩu và Xác nhận mật khẩu -->
                    <div class="row g-2 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold small text-secondary mb-1">
                                <i class="bi bi-lock me-1 text-primary"></i> Mật khẩu
                            </label>
                            <div class="input-group auth-input-group shadow-xs">
                                <span class="input-group-text"><i class="bi bi-key fs-5"></i></span>
                                <input asp-for="Password" type="password" id="regPasswordInput" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                                <button type="button" class="btn btn-password-toggle border" onclick="togglePasswordVisibility('regPasswordInput', 'regEyeIcon1')" aria-label="Hiện/ẩn mật khẩu">
                                    <i id="regEyeIcon1" class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold small text-secondary mb-1">
                                <i class="bi bi-check2-circle me-1 text-primary"></i> Xác nhận mật khẩu
                            </label>
                            <div class="input-group auth-input-group shadow-xs">
                                <span class="input-group-text"><i class="bi bi-shield-check fs-5"></i></span>
                                <input asp-for="ConfirmPassword" type="password" id="regConfirmPasswordInput" class="form-control" placeholder="Nhập lại mật khẩu" />
                                <button type="button" class="btn btn-password-toggle border" onclick="togglePasswordVisibility('regConfirmPasswordInput', 'regEyeIcon2')" aria-label="Hiện/ẩn mật khẩu">
                                    <i id="regEyeIcon2" class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Nút Đăng ký -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-auth-submit">
                            <i class="bi bi-person-plus-fill me-2"></i> ĐĂNG KÝ TÀI KHOẢN NGAY
                        </button>
                    </div>
                </form>

                <!-- Phân cách hoặc tiếp tục với -->
                <div class="position-relative text-center my-3">
                    <hr class="text-muted opacity-25" />
                    <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small" style="font-size: 12px;">hoặc đăng ký nhanh với</span>
                </div>

                <!-- Đăng nhập Google -->
                <div class="d-grid gap-2 mb-4">
                    <form asp-action="ExternalLogin" method="post" class="d-grid m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="provider" value="Google" />
                        <button type="submit" class="btn btn-auth-google">
                            <svg class="me-2" width="18" height="18" viewBox="0 0 24 24">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                            </svg>
                            Đăng ký nhanh qua Google
                        </button>
                    </form>
                </div>

                <!-- Chuyển sang Đăng nhập -->
                <div class="text-center mb-3">
                    <div class="small text-muted mb-2">Đã có tài khoản luyện thi IELTS?</div>
                    <a asp-action="Login" class="btn btn-auth-switch">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập ngay
                    </a>
                </div>

                <!-- Điều khoản và chính sách -->
                <div class="text-center text-muted small" style="font-size: 12px;">
                    Bằng việc đăng ký, bạn đồng ý với <a href="#" class="text-decoration-none text-primary">Điều khoản dịch vụ</a> và <a href="#" class="text-decoration-none text-primary">Chính sách bảo mật</a> của LUMORA.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
