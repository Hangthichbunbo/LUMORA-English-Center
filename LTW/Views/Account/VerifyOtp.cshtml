@model LTW.Models.VerifyOtpViewModel

@{
    ViewData["Title"] = "Xác Thực Mã OTP - LUMORA English Center";
}

<div class="auth-page-wrapper py-5">
    <div class="container" style="max-width: 580px;">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            <div class="mb-4">
                <span class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-primary shadow-sm" style="width: 72px; height: 72px; color: #00A896 !important;">
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                </span>
                <h3 class="fw-bold text-dark">Xác Thực Mã OTP</h3>
                <p class="text-muted small">
                    Hệ thống đã gửi mã xác thực gồm 6 chữ số đến email: <br />
                    <strong class="text-dark">@Model.Email</strong>
                </p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-info small py-2 mb-4 text-start">
                    <i class="bi bi-info-circle-fill me-2"></i> @TempData["SuccessMessage"]
                </div>
            }

            <form asp-action="VerifyOtp" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Purpose" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

                <div class="mb-4 text-start">
                    <label asp-for="OtpCode" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="OtpCode" class="form-control form-control-lg text-center fw-bold fs-3 tracking-widest py-2 rounded-3" 
                           placeholder="••••••" maxlength="6" autofocus style="letter-spacing: 8px;" />
                    <span asp-validation-for="OtpCode" class="text-danger small d-block mt-1"></span>
                    <small class="text-muted d-block mt-1">Vui lòng kiểm tra hộp thư đến hoặc thư rác (Spam).</small>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary py-2 fw-semibold rounded-3 shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                        <i class="bi bi-check2-circle me-1"></i> Xác Nhận & Hoàn Tất
                    </button>
                </div>

                <div class="small text-secondary mt-3">
                    Không nhận được mã? 
                    <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Gửi lại mã OTP</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

