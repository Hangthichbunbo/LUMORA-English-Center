@model IEnumerable<LTW.Data.ApplicationUser>

@{
    ViewData["Title"] = "Quản Lý Người Dùng - Admin LUMORA";
    var roles = new[] { "All", "Student", "Teacher", "Admin" };
    var currentRole = ViewBag.CurrentRole as string ?? "All";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-people-fill me-2 text-primary"></i>Quản Lý Tài Khoản Người Dùng</h3>
            <p class="text-muted small m-0">Danh sách toàn bộ Học viên, Giảng viên và Quản trị viên trong hệ thống</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createTeacherModal" style="background-color: #00A896; border-color: #00A896;">
                <i class="bi bi-person-plus-fill me-1"></i> Cấp Tài Khoản Giảng Viên
            </button>
            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Admin Navigation Toolbar -->
    <div class="d-flex flex-wrap gap-2 mb-4 bg-light p-2 rounded-4 border">
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
        </a>
        <a asp-action="Users" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" style="background-color: #00A896; border-color: #00A896;">
            <i class="bi bi-people-fill me-1"></i> Users
        </a>
        <a asp-action="Courses" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-collection-play-fill me-1"></i> Courses
        </a>
        <a asp-action="Classes" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-camera-video-fill me-1"></i> Classes
        </a>
        <a asp-action="Schedule" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-calendar-week-fill me-1"></i> Schedule
        </a>
        <a asp-controller="Teacher" asp-action="Lessons" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-book-fill me-1"></i> Lessons
        </a>
        <a asp-controller="Teacher" asp-action="Exercises" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-pencil-square me-1"></i> Exercises
        </a>
        <a asp-action="Tests" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-patch-question-fill me-1"></i> Tests
        </a>
        <a asp-action="Tips" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-lightbulb-fill me-1"></i> IELTS Tips
        </a>
        <a asp-action="Notifications" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-bell-fill me-1"></i> Notifications
        </a>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form method="get" asp-action="Users" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0" placeholder="Tìm kiếm theo Tên, Email, Username..." />
                </div>
            </div>
            <div class="col-md-5 d-flex gap-2">
                @foreach (var r in roles)
                {
                    var isAct = currentRole.ToLower() == r.ToLower();
                    <a asp-action="Users" asp-route-role="@r" asp-route-search="@ViewBag.CurrentSearch" 
                       class="btn @(isAct ? "btn-primary text-white" : "btn-outline-secondary") btn-sm rounded-pill px-3 fw-semibold"
                       style="@(isAct ? "background-color: #00A896; border-color: #00A896;" : "")">
                        @r
                    </a>
                }
            </div>
            <div class="col-md-3 text-md-end">
                <button type="submit" class="btn btn-secondary btn-sm rounded-pill px-4">Lọc Danh Sách</button>
            </div>
        </form>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">Họ và Tên</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Email / Điện Thoại</th>
                        <th>Vai Trò</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tạo</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            var roleBadge = u.RoleName switch
                            {
                                "Admin" => "bg-danger",
                                "Teacher" => "bg-primary",
                                _ => "bg-success"
                            };

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(u.AvatarUrl) ? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80" : u.AvatarUrl)" 
                                             class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" alt="Avatar" />
                                        <div class="fw-bold text-dark">@u.FullName</div>
                                    </div>
                                </td>
                                <td>&#64;@u.UserName</td>
                                <td>
                                    <div>@u.Email</div>
                                    <div class="text-muted" style="font-size: 11px;">@(u.PhoneNumber ?? "--")</div>
                                </td>
                                <td><span class="badge @roleBadge px-3 py-1 rounded-pill">@u.RoleName</span></td>
                                <td>
                                    <span class="badge @(u.IsActive ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger") px-3 py-1 rounded-pill fw-semibold">
                                        @(u.IsActive ? "Hoạt Động" : "Đã Khóa")
                                    </span>
                                </td>
                                <td>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Toggle Active -->
                                        <form asp-action="ToggleUserActive" asp-route-id="@u.Id" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") btn-sm rounded-pill px-3" 
                                                    title="@(u.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                <i class="bi @(u.IsActive ? "bi-lock-fill" : "bi-unlock-fill") me-1"></i>
                                                @(u.IsActive ? "Khóa" : "Mở")
                                            </button>
                                        </form>

                                        <!-- Delete Account (if not admin) -->
                                        @if (u.UserName != "admin")
                                        {
                                            <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này? Hành động này không thể hoàn tác.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Xóa tài khoản">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy tài khoản phù hợp với bộ lọc.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Create Teacher -->
<div class="modal fade" id="createTeacherModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Cấp Tài Khoản Giảng Viên Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateTeacher" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Họ và Tên Giảng Viên</label>
                        <input type="text" name="fullName" class="form-control" placeholder="Ví dụ: Mr. Robert King (IELTS 8.5)" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Địa Chỉ Email</label>
                        <input type="email" name="email" class="form-control" placeholder="teacher.robert@lumora.edu.vn" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Tên Đăng Nhập</label>
                        <input type="text" name="username" class="form-control" placeholder="robert.king" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mật Khẩu Ban Đầu</label>
                        <input type="password" name="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Giới Thiệu & Học Vị (Bio)</label>
                        <textarea name="bio" class="form-control" rows="3" placeholder="Bằng Thạc sĩ TESOL, 5 năm kinh nghiệm giảng dạy..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                        <i class="bi bi-check2-circle me-1"></i> Cấp Tài Khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

