@model LTW.Models.IeltsTip

@{
    ViewData["Title"] = "Chỉnh Sửa Bài Viết IELTS Tip - Admin LUMORA";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
            <div>
                <h3 class="fw-bold text-dark m-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Chỉnh Sửa Bài Viết Mẹo Thi</h3>
                <p class="text-muted small m-0">Cập nhật nội dung chia sẻ phương pháp học tập và chiến lược làm bài</p>
            </div>
            <a asp-action="Tips" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Quay Lại
            </a>
        </div>

        <form asp-action="EditTip" asp-route-id="@Model.TipId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TipId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label small fw-semibold text-secondary"></label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="Listening">Listening</option>
                        <option value="Reading">Reading</option>
                        <option value="Writing">Writing</option>
                        <option value="Speaking">Speaking</option>
                        <option value="Vocabulary">Vocabulary</option>
                        <option value="Grammar">Grammar</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="AuthorName" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="AuthorName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Thumbnail" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Thumbnail" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Summary" class="form-label small fw-semibold text-secondary"></label>
                    <textarea asp-for="Summary" class="form-control" rows="2" required></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Content" class="form-label small fw-semibold text-secondary"></label>
                    <textarea asp-for="Content" class="form-control font-monospace" rows="8" required></textarea>
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsPublished" class="form-check-input" />
                <label asp-for="IsPublished" class="form-check-label small fw-semibold text-dark">
                    Xuất bản bài viết công khai trên trang IELTS Tips
                </label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                    <i class="bi bi-check-circle me-1"></i> Lưu Cập Nhật
                </button>
            </div>
        </form>
    </div>
</div>

