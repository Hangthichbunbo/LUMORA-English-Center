@model IEnumerable<LTW.Models.Lesson>
@using LTW.Models

@{
    ViewData["Title"] = "Quản Lý Bài Học - Admin LUMORA";
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    int? selectedCourseId = ViewBag.SelectedCourseId as int?;
    string search = ViewBag.Search as string ?? "";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-book-fill me-2 text-primary"></i>Quản Lý Bài Học Toàn Hệ Thống</h3>
            <p class="text-muted small m-0">Quản trị toàn bộ bài giảng, video, tài liệu và phân cấp chương mục của các khóa học</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Teacher" asp-action="CreateLesson" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                <i class="bi bi-plus-circle me-1"></i> Soạn Bài Học Mới
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Admin Navigation Toolbar -->
    <div class="d-flex flex-wrap gap-2 mb-4 bg-light p-2 rounded-4 border">
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
        </a>
        <a asp-action="Users" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-people-fill me-1"></i> Users
        </a>
        <a asp-action="Courses" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-collection-play-fill me-1"></i> Courses
        </a>
        <a asp-action="Classes" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-camera-video-fill me-1"></i> Classes
        </a>
        <a asp-action="Schedule" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-calendar-week-fill me-1"></i> Schedule
        </a>
        <a asp-action="Lessons" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" style="background-color: #00A896; border-color: #00A896;">
            <i class="bi bi-book-fill me-1"></i> Lessons
        </a>
        <a asp-action="Exercises" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-pencil-square me-1"></i> Exercises
        </a>
        <a asp-action="Tests" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-patch-question-fill me-1"></i> Tests
        </a>
        <a asp-action="Tips" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-lightbulb-fill me-1"></i> IELTS Tips
        </a>
        <a asp-action="Notifications" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-bell-fill me-1"></i> Notifications
        </a>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form method="get" asp-action="Lessons" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Tìm theo tên bài học hoặc chương..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="courseId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả khóa học --</option>
                    @foreach (var c in courses)
                    {
                        if (selectedCourseId.HasValue && selectedCourseId.Value == c.CourseId)
                        {
                            <option value="@c.CourseId" selected>@c.Title</option>
                        }
                        else
                        {
                            <option value="@c.CourseId">@c.Title</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-lumora-secondary text-white rounded-pill px-4 flex-grow-1">Lọc Dữ Liệu</button>
                <a asp-action="Lessons" class="btn btn-outline-secondary rounded-pill px-3">Đặt Lại</a>
            </div>
        </form>
    </div>

    <!-- Lessons Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Bài Học</th>
                        <th>Khóa Học & Chương</th>
                        <th>Tài Nguyên</th>
                        <th>Học Thử</th>
                        <th>Bài Tập Kèm</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        int index = 0;
                        foreach (var l in Model)
                        {
                            index++;
                            <tr>
                                <td class="ps-4 text-muted">@index</td>
                                <td>
                                    <div class="fw-bold text-dark">@l.Title</div>
                                    <div class="text-muted" style="font-size: 11px;">Thứ tự #@l.OrderIndex</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">@(l.Chapter?.Course?.Title ?? "Chưa rõ khóa")</div>
                                    <div class="text-muted" style="font-size: 11px;">@(l.Chapter?.Title ?? "Chưa rõ chương")</div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (!string.IsNullOrEmpty(l.VideoUrl))
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" title="Có Video"><i class="bi bi-play-btn-fill"></i> Video</span>
                                        }
                                        @if (!string.IsNullOrEmpty(l.AudioUrl))
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" title="Có Audio"><i class="bi bi-headphones"></i> Audio</span>
                                        }
                                        @if (!string.IsNullOrEmpty(l.DocumentUrl))
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25" title="Có Tài liệu"><i class="bi bi-file-earmark-pdf-fill"></i> Doc</span>
                                        }
                                        @if (string.IsNullOrEmpty(l.VideoUrl) && string.IsNullOrEmpty(l.AudioUrl) && string.IsNullOrEmpty(l.DocumentUrl))
                                        {
                                            <span class="text-muted" style="font-size: 11px;">Văn bản</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(l.IsFreePreview ? "bg-success" : "bg-secondary") rounded-pill">
                                        @(l.IsFreePreview ? "Free Preview" : "Đóng")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(l.Exercises?.Count ?? 0) bài tập</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-controller="Student" asp-action="Lesson" asp-route-id="@l.LessonId" class="btn btn-outline-info btn-sm rounded-pill px-3" title="Xem trước giao diện học viên">
                                            <i class="bi bi-eye me-1"></i> Xem
                                        </a>
                                        <a asp-controller="Teacher" asp-action="EditLesson" asp-route-id="@l.LessonId" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Chỉnh sửa nội dung">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>
                                        <form asp-controller="Teacher" asp-action="DeleteLesson" asp-route-id="@l.LessonId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài học này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                <i class="bi bi-trash me-1"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-muted"></i>
                                Không tìm thấy bài học nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
