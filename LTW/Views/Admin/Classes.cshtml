@model IEnumerable<LTW.Models.LiveClass>

@{
    ViewData["Title"] = "Quản Lý Lớp Học Trực Tuyến - Admin LUMORA";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-camera-video-fill me-2 text-primary"></i>Quản Lý Các Lớp Live Class</h3>
            <p class="text-muted small m-0">Tạo mới, mở/đóng lớp, phân công giảng viên và quản lý link phòng học</p>
        </div>
        <div>
            <a asp-action="CreateClass" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                <i class="bi bi-plus-circle me-1"></i> Tạo Lớp Học Mới
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3 ms-2">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Admin Navigation Toolbar -->
    <div class="d-flex flex-wrap gap-2 mb-4 bg-light p-2 rounded-4 border">
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
        </a>
        <a asp-action="Users" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-people-fill me-1"></i> Users
        </a>
        <a asp-action="Courses" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-collection-play-fill me-1"></i> Courses
        </a>
        <a asp-action="Classes" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" style="background-color: #00A896; border-color: #00A896;">
            <i class="bi bi-camera-video-fill me-1"></i> Classes
        </a>
        <a asp-action="Schedule" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-calendar-week-fill me-1"></i> Schedule
        </a>
        <a asp-controller="Teacher" asp-action="Lessons" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-book-fill me-1"></i> Lessons
        </a>
        <a asp-controller="Teacher" asp-action="Exercises" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-pencil-square me-1"></i> Exercises
        </a>
        <a asp-action="Tests" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-patch-question-fill me-1"></i> Tests
        </a>
        <a asp-action="Tips" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-lightbulb-fill me-1"></i> IELTS Tips
        </a>
        <a asp-action="Notifications" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-bell-fill me-1"></i> Notifications
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">Tên Lớp Học</th>
                        <th>Khóa Học</th>
                        <th>Giảng Viên</th>
                        <th>Lịch Học</th>
                        <th>Phân Loại</th>
                        <th>Trạng Thái</th>
                        <th>Sĩ Số</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@c.ClassName</div>
                                    <div class="text-muted" style="font-size: 11px;">Phòng: @c.LiveRoomUrl</div>
                                </td>
                                <td>@(c.Course?.Title ?? "Lớp Mở Toàn Hệ Thống")</td>
                                <td>@(c.Teacher?.FullName ?? "Chưa gán")</td>
                                <td>
                                    <div>@c.ScheduledDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted" style="font-size: 11px;">@c.StartTime.ToString(@"hh\:mm") - @c.EndTime.ToString(@"hh\:mm")</div>
                                </td>
                                <td>
                                    <span class="badge @(c.IsPublic ? "bg-success" : "bg-danger") rounded-pill">
                                        @(c.IsPublic ? "Public" : "Private")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(c.Status == LTW.Models.ClassStatus.Closed ? "bg-secondary" : "bg-primary") rounded-pill">
                                        @c.Status
                                    </span>
                                </td>
                                <td>@(c.ClassStudents?.Count ?? 0) / @c.Capacity</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Edit Class -->
                                        <a asp-action="EditClass" asp-route-id="@c.LiveClassId" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>

                                        <!-- Open/Close class -->
                                        <form asp-action="CloseClass" asp-route-id="@c.LiveClassId" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(c.Status == LTW.Models.ClassStatus.Closed ? "btn-outline-success" : "btn-outline-warning") btn-sm rounded-pill px-3">
                                                @(c.Status == LTW.Models.ClassStatus.Closed ? "Mở Lại" : "Đóng Lớp")
                                            </button>
                                        </form>

                                        <a asp-controller="Class" asp-action="Join" asp-route-id="@c.LiveClassId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="bi bi-broadcast me-1"></i> Vào Phòng
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có lớp học trực tuyến nào được tạo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

