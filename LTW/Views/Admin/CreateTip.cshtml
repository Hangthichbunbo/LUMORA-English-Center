@model LTW.Models.IeltsTip

@{
    ViewData["Title"] = "Soạn Bài Viết IELTS Tip Mới - Admin LUMORA";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
            <div>
                <h3 class="fw-bold text-dark m-0"><i class="bi bi-lightbulb me-2 text-primary"></i>Soạn Thảo Bài Viết Mẹo Thi</h3>
                <p class="text-muted small m-0">Chia sẻ phương pháp học tập và kỹ thuật làm bài cho cộng đồng học viên</p>
            </div>
            <a asp-action="Tips" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Quay Lại
            </a>
        </div>

        <form asp-action="CreateTip" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Title" class="form-control" placeholder="Ví dụ: Chiến lược đạt 8.0 Listening với kỹ thuật Dictation" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label small fw-semibold text-secondary"></label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="Listening">Listening</option>
                        <option value="Reading">Reading</option>
                        <option value="Writing">Writing</option>
                        <option value="Speaking">Speaking</option>
                        <option value="Vocabulary">Vocabulary</option>
                        <option value="Grammar">Grammar</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="AuthorName" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="AuthorName" class="form-control" placeholder="Tên tác giả" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Thumbnail" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Thumbnail" class="form-control" placeholder="https://images.unsplash.com/..." />
                </div>
                <div class="col-12">
                    <label asp-for="Summary" class="form-label small fw-semibold text-secondary"></label>
                    <textarea asp-for="Summary" class="form-control" rows="2" placeholder="Tóm tắt ngắn 1-2 câu về bài viết..." required></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Content" class="form-label small fw-semibold text-secondary"></label>
                    <textarea asp-for="Content" class="form-control font-monospace" rows="8" placeholder="<p>Nội dung chi tiết của bài viết...</p>" required></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                    <i class="bi bi-send me-1"></i> Xuất Bản Bài Viết
                </button>
            </div>
        </form>
    </div>
</div>

