@model IEnumerable<LTW.Models.Course>

@{
    ViewData["Title"] = "Quản Lý Khóa Học - Admin LUMORA";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-collection-play-fill me-2 text-primary"></i>Quản Lý Khóa Học Toàn Hệ Thống</h3>
            <p class="text-muted small m-0">Thiết lập học phí, phân công giảng viên và kiểm duyệt xuất bản khóa học</p>
        </div>
        <div>
            <a asp-action="CreateCourse" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                <i class="bi bi-plus-circle me-1"></i> Tạo Khóa Học Mới
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3 ms-2">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Admin Navigation Toolbar -->
    <div class="d-flex flex-wrap gap-2 mb-4 bg-light p-2 rounded-4 border">
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
        </a>
        <a asp-action="Users" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-people-fill me-1"></i> Users
        </a>
        <a asp-action="Courses" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold" style="background-color: #00A896; border-color: #00A896;">
            <i class="bi bi-collection-play-fill me-1"></i> Courses
        </a>
        <a asp-action="Classes" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-camera-video-fill me-1"></i> Classes
        </a>
        <a asp-action="Schedule" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-calendar-week-fill me-1"></i> Schedule
        </a>
        <a asp-controller="Teacher" asp-action="Lessons" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-book-fill me-1"></i> Lessons
        </a>
        <a asp-controller="Teacher" asp-action="Exercises" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-pencil-square me-1"></i> Exercises
        </a>
        <a asp-action="Tests" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-patch-question-fill me-1"></i> Tests
        </a>
        <a asp-action="Tips" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-lightbulb-fill me-1"></i> IELTS Tips
        </a>
        <a asp-action="Notifications" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-bell-fill me-1"></i> Notifications
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">Tên Khóa Học</th>
                        <th>Danh Mục</th>
                        <th>Trình Độ</th>
                        <th>Giảng Viên</th>
                        <th>Học Phí</th>
                        <th>Học Viên Mua</th>
                        <th>Xuất Bản</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@c.Thumbnail" alt="@c.Title" class="rounded-3 shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                                        <div>
                                            <div class="fw-bold text-dark">@c.Title</div>
                                            <div class="text-muted" style="font-size: 11px;">@c.TotalLessons bài học • @c.Chapters.Count chương</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-secondary border">@c.Category</span></td>
                                <td>@c.Level</td>
                                <td>@(c.Teacher?.FullName ?? "Chưa gán GV")</td>
                                <td><strong class="text-danger">@c.Price.ToString("N0") đ</strong></td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary">@c.Enrollments.Count học viên</span></td>
                                <td>
                                    <span class="badge @(c.IsPublished ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary") rounded-pill">
                                        @(c.IsPublished ? "Đã Xuất Bản" : "Đang Ẩn")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Edit Course -->
                                        <a asp-action="EditCourse" asp-route-id="@c.CourseId" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </a>

                                        <!-- Toggle Publish -->
                                        <form asp-action="TogglePublishCourse" asp-route-id="@c.CourseId" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="Ẩn/Hiện khóa học">
                                                <i class="bi @(c.IsPublished ? "bi-eye-slash" : "bi-eye") me-1"></i>
                                                @(c.IsPublished ? "Ẩn" : "Hiện")
                                            </button>
                                        </form>

                                        <!-- Delete Course -->
                                        <form asp-action="DeleteCourse" asp-route-id="@c.CourseId" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khóa học này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Xóa khóa học">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có khóa học nào trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

