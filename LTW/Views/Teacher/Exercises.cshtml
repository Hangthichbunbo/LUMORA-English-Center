@model IEnumerable<LTW.Models.Exercise>

@{
    ViewData["Title"] = "Quản Lý Bài Tập - Giảng Viên LUMORA";
    var totalExercises = Model?.Count() ?? 0;
    var totalSubmissions = Model?.Sum(e => e.Submissions?.Count ?? 0) ?? 0;
}

<!-- Unified Teacher Header -->
<partial name="_TeacherHeader" />

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="fw-bold text-dark m-0"><i class="bi bi-clipboard-check me-2 text-primary"></i>Quản Lý Bài Tập (Exercises)</h4>
            <p class="text-muted small m-0">Tạo câu hỏi, thiết lập đáp án và kiểm tra lượt nộp bài của học viên</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-white text-secondary border rounded-pill px-3 py-2 shadow-sm">
                Tổng: <strong class="text-dark">@totalExercises</strong> bài tập • <strong class="text-primary">@totalSubmissions</strong> lượt nộp
            </span>
            <a asp-action="CreateExercise" class="btn btn-lumora-secondary btn-sm rounded-pill px-3 fw-semibold shadow-sm text-white">
                <i class="bi bi-plus-circle me-1"></i> Tạo Bài Tập Mới
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">Tên Bài Tập</th>
                        <th>Bài Học Trực Thuộc</th>
                        <th>Thời Gian</th>
                        <th>Điểm Đạt</th>
                        <th>Bộ Câu Hỏi</th>
                        <th>Lượt Nộp Bài</th>
                        <th class="text-end pe-4 text-nowrap">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var ex in Model)
                        {
                            var subsCount = ex.Submissions?.Count ?? 0;
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@ex.Title</div>
                                    <div class="text-muted text-truncate" style="max-width: 250px; font-size: 11px;">
                                        @(string.IsNullOrEmpty(ex.Description) ? "Luyện tập củng cố kiến thức theo bài học" : ex.Description)
                                    </div>
                                </td>
                                <td>
                                    @if (ex.Lesson != null)
                                    {
                                        <div class="fw-semibold text-dark">@ex.Lesson.Title</div>
                                        <div class="text-muted" style="font-size: 11px;">Khóa: @(ex.Lesson.Chapter?.Course?.Title ?? "-")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-nowrap"><i class="bi bi-stopwatch me-1 text-secondary"></i>@ex.TimeLimitMinutes phút</td>
                                <td class="text-nowrap"><span class="badge bg-light text-dark border">@ex.PassingScore / 100</span></td>
                                <td class="text-nowrap">
                                    <span class="badge bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-question-circle me-1"></i>@(ex.Questions?.Count ?? 0) câu hỏi
                                    </span>
                                </td>
                                <td class="text-nowrap">
                                    @if (subsCount > 0)
                                    {
                                        <a asp-action="Assessments" class="badge bg-success bg-opacity-10 text-success text-decoration-none py-1 px-2">
                                            <i class="bi bi-people me-1"></i>@subsCount lượt nộp (Chấm ngay)
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px;">Chưa có lượt nộp</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-controller="Student" asp-action="Exercise" asp-route-id="@ex.ExerciseId" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Xem giao diện làm bài">
                                        <i class="bi bi-play-circle me-1"></i> Làm Thử
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-clipboard-x display-6 d-block mb-2 text-secondary"></i>
                                <h6 class="fw-bold text-dark">Chưa có bài tập nào</h6>
                                <p class="small text-muted mb-3">Tạo bài tập đầu tiên để học viên rèn luyện và nộp bài chấm điểm.</p>
                                <a asp-action="CreateExercise" class="btn btn-lumora-secondary btn-sm rounded-pill px-4 text-white">
                                    <i class="bi bi-plus-circle me-1"></i> Tạo Bài Tập Mới
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
