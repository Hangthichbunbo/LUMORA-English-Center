@model LTW.Models.Exercise

@{
    ViewData["Title"] = $"Chỉnh Sửa Bài Tập: {Model.Title} - Giảng Viên LUMORA";
}

<style>
    .exercise-q-card {
        border-color: #e2e8f0 !important;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .exercise-q-card:hover {
        border-color: #cbd5e1 !important;
        box-shadow: 0 4px 14px rgba(20, 35, 60, 0.05);
    }
    .exercise-add-box {
        transition: all 0.2s ease;
    }
    .exercise-add-box:hover {
        border-color: #00A896 !important;
        background-color: #f0fdfa !important;
    }
</style>

<div class="container py-4" style="max-width: 960px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
            <div>
                <h3 class="fw-bold text-dark m-0"><i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh Sửa Bài Tập & Bộ Câu Hỏi</h3>
                <p class="text-muted small m-0">Cập nhật nội dung câu hỏi trắc nghiệm / tự luận, đáp án chuẩn và thang điểm</p>
            </div>
            <a asp-action="Exercises" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Quay Lại
            </a>
        </div>

        <form asp-action="EditExercise" asp-route-id="@Model.ExerciseId" method="post" id="editExerciseForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ExerciseId" />
            <input type="hidden" id="initialLessonId" value="@Model.LessonId" />

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-3 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                    <div><strong>Lỗi:</strong> @TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div asp-validation-summary="All" class="alert alert-danger small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

            <!-- Thông tin tổng quan bài tập -->
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="Title" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Title" class="form-control" placeholder="Ví dụ: Luyện tập Reading / Writing Chuyên Sâu #1" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <!-- Phân cấp: Khóa học -> Chương học -> Bài học trực thuộc -->
                <div class="col-12">
                    <div class="p-3 bg-light rounded-4 border">
                        <div class="fw-bold text-dark small mb-2 d-flex align-items-center">
                            <i class="bi bi-diagram-3-fill text-primary me-2"></i>Chọn Bài Học Trực Thuộc (Theo Khóa Học & Chương)
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="courseSelect" class="form-label small fw-semibold text-secondary">
                                    <i class="bi bi-mortarboard me-1 text-primary"></i>1. Chọn Khóa Học <span class="text-danger">*</span>
                                </label>
                                <select id="courseSelect" class="form-select" required>
                                    <option value="">-- Chọn khóa học --</option>
                                    @if (ViewBag.CoursesHierarchy != null)
                                    {
                                        foreach (var c in ViewBag.CoursesHierarchy)
                                        {
                                            <option value="@c.CourseId">@c.Title</option>
                                        }
                                    }
                                </select>
                                <div class="form-text small text-muted">Bước 1: Chọn khóa học</div>
                            </div>
                            <div class="col-md-4">
                                <label for="chapterSelect" class="form-label small fw-semibold text-secondary">
                                    <i class="bi bi-folder2-open me-1 text-primary"></i>2. Chọn Chương Trong Khóa <span class="text-danger">*</span>
                                </label>
                                <select id="chapterSelect" class="form-select" required>
                                    <option value="">-- Chọn chương học --</option>
                                </select>
                                <div class="form-text small text-muted">Bước 2: Chọn chương học</div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="LessonId" class="form-label small fw-semibold text-secondary">
                                    <i class="bi bi-journal-check me-1 text-primary"></i>3. Chọn Bài Học Trực Thuộc <span class="text-danger">*</span>
                                </label>
                                <select asp-for="LessonId" id="lessonSelect" class="form-select" required>
                                    <option value="">-- Chọn bài học trực thuộc --</option>
                                </select>
                                <span asp-validation-for="LessonId" class="text-danger small"></span>
                                <div class="form-text small text-muted">Bước 3: Chọn bài học để gán bài tập</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="TimeLimitMinutes" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="TimeLimitMinutes" class="form-control" type="number" min="5" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PassingScore" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="PassingScore" class="form-control" type="number" min="0" max="100" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Hướng dẫn thí sinh các bước làm bài và các lưu ý quan trọng..."></textarea>
                </div>
            </div>

            <!-- Header danh sách câu hỏi -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pt-3 border-top">
                <div>
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-list-check me-2 text-primary"></i>Soạn Thảo Bộ Câu Hỏi (Questions)</h5>
                    <p class="text-muted small m-0">Tự do chỉnh sửa, xóa hoặc thêm câu hỏi mới cho bài tập</p>
                </div>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" onclick="addQuestion()" style="background-color: #00A896; border-color: #00A896;">
                    <i class="bi bi-plus-circle-fill"></i> Thêm câu hỏi (+)
                </button>
            </div>

            <!-- Container danh sách câu hỏi -->
            <div id="questionsContainer" class="d-flex flex-column gap-3 mb-4">
                @{
                    var questionsList = Model.Questions?.OrderBy(q => q.QuestionId).ToList() ?? new List<LTW.Models.ExerciseQuestion>();
                    if (!questionsList.Any())
                    {
                        questionsList.Add(new LTW.Models.ExerciseQuestion { Points = 10, Format = LTW.Models.QuestionFormat.MultipleChoice });
                    }
                    int qIdx = 0;
                }

                @foreach (var q in questionsList)
                {
                    string optA = "", optB = "", optC = "", optD = "";
                    if (!string.IsNullOrEmpty(q.OptionsJson))
                    {
                        try
                        {
                            var opts = System.Text.Json.JsonSerializer.Deserialize<List<string>>(q.OptionsJson);
                            if (opts != null)
                            {
                                for (int optIdx = 0; optIdx < opts.Count; optIdx++)
                                {
                                    var raw = opts[optIdx]?.Trim() ?? "";
                                    string val = raw;
                                    char prefix = (char)('A' + optIdx);
                                    if (raw.Length >= 2 && (raw[1] == '.' || raw[1] == ':') && char.ToUpperInvariant(raw[0]) >= 'A' && char.ToUpperInvariant(raw[0]) <= 'D')
                                    {
                                        prefix = char.ToUpperInvariant(raw[0]);
                                        val = raw.Substring(2).Trim();
                                    }
                                    if (prefix == 'A') optA = val;
                                    else if (prefix == 'B') optB = val;
                                    else if (prefix == 'C') optC = val;
                                    else if (prefix == 'D') optD = val;
                                }
                            }
                        }
                        catch { }
                    }

                    string correctKey = "A";
                    if (!string.IsNullOrEmpty(q.CorrectAnswer))
                    {
                        var ca = q.CorrectAnswer.Trim().ToUpperInvariant();
                        if (ca.StartsWith("B") || (!string.IsNullOrEmpty(optB) && ca == optB.ToUpperInvariant())) correctKey = "B";
                        else if (ca.StartsWith("C") || (!string.IsNullOrEmpty(optC) && ca == optC.ToUpperInvariant())) correctKey = "C";
                        else if (ca.StartsWith("D") || (!string.IsNullOrEmpty(optD) && ca == optD.ToUpperInvariant())) correctKey = "D";
                        else correctKey = "A";
                    }

                    bool isWriting = q.Format == LTW.Models.QuestionFormat.Writing || q.Format == LTW.Models.QuestionFormat.Speaking;

                    <div class="card border rounded-4 p-4 exercise-q-card bg-light shadow-none" data-q-index="@qIdx">
                        <input type="hidden" name="questions[@qIdx].QuestionId" value="@q.QuestionId" />
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold q-badge" style="background-color: #294563 !important;">
                                    Câu hỏi #@(qIdx + 1)
                                </span>
                                <div class="d-flex align-items-center gap-1">
                                    <label class="small fw-semibold text-secondary me-1">Dạng:</label>
                                    <select name="questions[@qIdx].Format" class="form-select form-select-sm fw-semibold q-format-select" style="width: auto; min-width: 170px;" onchange="toggleFormat(this)">
                                        <option value="MultipleChoice" selected="@(!isWriting ? "selected" : null)">Trắc nghiệm (A, B, C, D)</option>
                                        <option value="Writing" selected="@(isWriting ? "selected" : null)">Tự luận (Đoạn văn / Bài viết)</option>
                                    </select>
                                </div>
                                <div class="d-flex align-items-center gap-1 ms-1">
                                    <label class="small fw-semibold text-secondary me-1">Kỹ năng:</label>
                                    <select name="questions[@qIdx].Skill" class="form-select form-select-sm q-skill-select" style="width: auto;">
                                        <option value="Reading" selected="@(q.Skill == LTW.Models.SkillType.Reading ? "selected" : null)">Reading</option>
                                        <option value="Listening" selected="@(q.Skill == LTW.Models.SkillType.Listening ? "selected" : null)">Listening</option>
                                        <option value="Writing" selected="@(q.Skill == LTW.Models.SkillType.Writing ? "selected" : null)">Writing</option>
                                        <option value="Speaking" selected="@(q.Skill == LTW.Models.SkillType.Speaking ? "selected" : null)">Speaking</option>
                                        <option value="Grammar" selected="@(q.Skill == LTW.Models.SkillType.Grammar ? "selected" : null)">Grammar</option>
                                        <option value="Vocabulary" selected="@(q.Skill == LTW.Models.SkillType.Vocabulary ? "selected" : null)">Vocabulary</option>
                                    </select>
                                </div>
                                <div class="d-flex align-items-center gap-1 ms-1">
                                    <label class="small fw-semibold text-secondary me-1">Điểm:</label>
                                    <input type="number" step="0.5" min="0.5" max="100" class="form-control form-control-sm text-center q-points-input" style="width: 65px;" name="questions[@qIdx].Points" value="@q.Points" />
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 btn-remove-q" onclick="removeQuestion(this)" title="Xóa câu hỏi">
                                <i class="bi bi-trash3 me-1"></i> Xóa câu này
                            </button>
                        </div>

                        <!-- Nội dung câu hỏi -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Nội dung câu hỏi <span class="text-danger">*</span></label>
                            <textarea name="questions[@qIdx].Content" class="form-control q-content-input" rows="2" placeholder="Ví dụ: Theo đoạn trích hoặc audio, thông tin nào sau đây là chính xác?" required>@q.Content</textarea>
                        </div>

                        <!-- Khung trắc nghiệm Multiple Choice -->
                        <div class="q-mc-box" style="@(isWriting ? "display: none;" : "")">
                            <label class="form-label small fw-semibold text-secondary mb-2">Các phương án lựa chọn:</label>
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <div class="input-group">
                                        <span class="input-group-text fw-bold text-primary bg-white">A</span>
                                        <input type="text" name="questions[@qIdx].OptA" class="form-control q-opt-a" placeholder="Nội dung lựa chọn A" value="@optA" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="input-group">
                                        <span class="input-group-text fw-bold text-primary bg-white">B</span>
                                        <input type="text" name="questions[@qIdx].OptB" class="form-control q-opt-b" placeholder="Nội dung lựa chọn B" value="@optB" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="input-group">
                                        <span class="input-group-text fw-bold text-primary bg-white">C</span>
                                        <input type="text" name="questions[@qIdx].OptC" class="form-control q-opt-c" placeholder="Nội dung lựa chọn C" value="@optC" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="input-group">
                                        <span class="input-group-text fw-bold text-primary bg-white">D</span>
                                        <input type="text" name="questions[@qIdx].OptD" class="form-control q-opt-d" placeholder="Nội dung lựa chọn D" value="@optD" />
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-success">
                                    <i class="bi bi-check-circle-fill me-1"></i> Đáp án đúng chuẩn:
                                </label>
                                <select name="questions[@qIdx].CorrectAnswer" class="form-select border-success q-correct-mc">
                                    <option value="A" selected="@(correctKey == "A" ? "selected" : null)">Lựa chọn A</option>
                                    <option value="B" selected="@(correctKey == "B" ? "selected" : null)">Lựa chọn B</option>
                                    <option value="C" selected="@(correctKey == "C" ? "selected" : null)">Lựa chọn C</option>
                                    <option value="D" selected="@(correctKey == "D" ? "selected" : null)">Lựa chọn D</option>
                                </select>
                            </div>
                        </div>

                        <!-- Khung tự luận Essay / Writing -->
                        <div class="q-writing-box" style="@(!isWriting ? "display: none;" : "")">
                            <div class="alert alert-info py-2 small mb-3">
                                <i class="bi bi-info-circle-fill me-1"></i>
                                <strong>Dạng tự luận:</strong> Học viên sẽ nhập bài viết / câu trả lời vào khung văn bản. Giảng viên có thể xem nội dung bài làm và chấm điểm kèm lời nhận xét trong mục Chấm điểm bài nộp.
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-success">
                                    <i class="bi bi-card-checklist me-1"></i> Gợi ý đáp án / Tiêu chí chấm điểm (Rubric):
                                </label>
                                <textarea name="questions[@qIdx].WritingAnswer" class="form-control border-info q-writing-rubric" rows="2" placeholder="Ví dụ: Nêu đủ 3 ý chính, cấu trúc câu rõ ràng, sử dụng từ vựng chủ đề...">@(isWriting ? q.CorrectAnswer : "")</textarea>
                            </div>
                        </div>

                        <!-- Giải thích chi tiết cho học viên -->
                        <div>
                            <label class="form-label small text-secondary">Giải thích / Feedback chi tiết cho học viên</label>
                            <input type="text" name="questions[@qIdx].Explanation" class="form-control q-explanation-input" placeholder="Feedback giải thích vì sao đáp án đúng, hoặc lưu ý từ vựng, ngữ pháp..." value="@q.Explanation" />
                        </div>
                    </div>
                    qIdx++;
                }
            </div>

            <!-- Nút thêm câu hỏi dưới dạng dashed box -->
            <div class="p-3 text-center border rounded-4 mb-4 bg-light exercise-add-box" style="border-style: dashed !important; border-width: 2px !important; border-color: #cbd5e1 !important;">
                <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" onclick="addQuestion()">
                    <i class="bi bi-plus-lg fs-5"></i> Thêm Một Câu Hỏi Nữa
                </button>
            </div>

            <!-- Actions footer -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Exercises" class="btn btn-light rounded-pill px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-warning text-dark px-4 py-2 rounded-pill fw-semibold shadow-sm">
                    <i class="bi bi-check-circle-fill me-1"></i> Lưu Thay Đổi Bài Tập
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function toggleFormat(select) {
            var card = select.closest('.exercise-q-card');
            var mcBox = card.querySelector('.q-mc-box');
            var writingBox = card.querySelector('.q-writing-box');
            var skillSelect = card.querySelector('.q-skill-select');

            if (select.value === 'Writing') {
                mcBox.style.display = 'none';
                writingBox.style.display = 'block';
                if (skillSelect && (skillSelect.value === 'Reading' || skillSelect.value === 'Listening')) {
                    skillSelect.value = 'Writing';
                }
            } else {
                mcBox.style.display = 'block';
                writingBox.style.display = 'none';
            }
        }

        function reindexQuestions() {
            var cards = document.querySelectorAll('#questionsContainer .exercise-q-card');
            cards.forEach(function (card, index) {
                card.setAttribute('data-q-index', index);
                
                var badge = card.querySelector('.q-badge');
                if (badge) badge.textContent = 'Câu hỏi #' + (index + 1);

                var qIdInput = card.querySelector('input[name*="QuestionId"]');
                if (qIdInput) qIdInput.name = 'questions[' + index + '].QuestionId';

                var formatSelect = card.querySelector('.q-format-select');
                if (formatSelect) formatSelect.name = 'questions[' + index + '].Format';

                var skillSelect = card.querySelector('.q-skill-select');
                if (skillSelect) skillSelect.name = 'questions[' + index + '].Skill';

                var pointsInput = card.querySelector('.q-points-input');
                if (pointsInput) pointsInput.name = 'questions[' + index + '].Points';

                var contentInput = card.querySelector('.q-content-input');
                if (contentInput) contentInput.name = 'questions[' + index + '].Content';

                var optA = card.querySelector('.q-opt-a');
                if (optA) optA.name = 'questions[' + index + '].OptA';

                var optB = card.querySelector('.q-opt-b');
                if (optB) optB.name = 'questions[' + index + '].OptB';

                var optC = card.querySelector('.q-opt-c');
                if (optC) optC.name = 'questions[' + index + '].OptC';

                var optD = card.querySelector('.q-opt-d');
                if (optD) optD.name = 'questions[' + index + '].OptD';

                var correctMc = card.querySelector('.q-correct-mc');
                if (correctMc) correctMc.name = 'questions[' + index + '].CorrectAnswer';

                var writingRubric = card.querySelector('.q-writing-rubric');
                if (writingRubric) writingRubric.name = 'questions[' + index + '].WritingAnswer';

                var explanation = card.querySelector('.q-explanation-input');
                if (explanation) explanation.name = 'questions[' + index + '].Explanation';

                var removeBtn = card.querySelector('.btn-remove-q');
                if (removeBtn) {
                    removeBtn.style.display = cards.length > 1 ? 'inline-block' : 'none';
                }
            });
        }

        function addQuestion() {
            var container = document.getElementById('questionsContainer');
            var cards = container.querySelectorAll('.exercise-q-card');
            var newIndex = cards.length;

            var cardDiv = document.createElement('div');
            cardDiv.className = 'card border rounded-4 p-4 exercise-q-card bg-light shadow-none';
            cardDiv.setAttribute('data-q-index', newIndex);

            cardDiv.innerHTML = `
                <input type="hidden" name="questions[${newIndex}].QuestionId" value="0" />
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold q-badge" style="background-color: #294563 !important;">
                            Câu hỏi #${newIndex + 1}
                        </span>
                        <div class="d-flex align-items-center gap-1">
                            <label class="small fw-semibold text-secondary me-1">Dạng:</label>
                            <select name="questions[${newIndex}].Format" class="form-select form-select-sm fw-semibold q-format-select" style="width: auto; min-width: 170px;" onchange="toggleFormat(this)">
                                <option value="MultipleChoice">Trắc nghiệm (A, B, C, D)</option>
                                <option value="Writing">Tự luận (Đoạn văn / Bài viết)</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-1 ms-1">
                            <label class="small fw-semibold text-secondary me-1">Kỹ năng:</label>
                            <select name="questions[${newIndex}].Skill" class="form-select form-select-sm q-skill-select" style="width: auto;">
                                <option value="Reading">Reading</option>
                                <option value="Listening">Listening</option>
                                <option value="Writing">Writing</option>
                                <option value="Speaking">Speaking</option>
                                <option value="Grammar">Grammar</option>
                                <option value="Vocabulary">Vocabulary</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-1 ms-1">
                            <label class="small fw-semibold text-secondary me-1">Điểm:</label>
                            <input type="number" step="0.5" min="0.5" max="100" class="form-control form-control-sm text-center q-points-input" style="width: 65px;" name="questions[${newIndex}].Points" value="10" />
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 btn-remove-q" onclick="removeQuestion(this)" title="Xóa câu hỏi">
                        <i class="bi bi-trash3 me-1"></i> Xóa câu này
                    </button>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Nội dung câu hỏi <span class="text-danger">*</span></label>
                    <textarea name="questions[${newIndex}].Content" class="form-control q-content-input" rows="2" placeholder="Ví dụ: Theo đoạn trích hoặc audio, thông tin nào sau đây là chính xác?" required></textarea>
                </div>

                <div class="q-mc-box">
                    <label class="form-label small fw-semibold text-secondary mb-2">Các phương án lựa chọn:</label>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text fw-bold text-primary bg-white">A</span>
                                <input type="text" name="questions[${newIndex}].OptA" class="form-control q-opt-a" placeholder="Nội dung lựa chọn A" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text fw-bold text-primary bg-white">B</span>
                                <input type="text" name="questions[${newIndex}].OptB" class="form-control q-opt-b" placeholder="Nội dung lựa chọn B" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text fw-bold text-primary bg-white">C</span>
                                <input type="text" name="questions[${newIndex}].OptC" class="form-control q-opt-c" placeholder="Nội dung lựa chọn C" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text fw-bold text-primary bg-white">D</span>
                                <input type="text" name="questions[${newIndex}].OptD" class="form-control q-opt-d" placeholder="Nội dung lựa chọn D" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-success">
                            <i class="bi bi-check-circle-fill me-1"></i> Đáp án đúng chuẩn:
                        </label>
                        <select name="questions[${newIndex}].CorrectAnswer" class="form-select border-success q-correct-mc">
                            <option value="A">Lựa chọn A</option>
                            <option value="B">Lựa chọn B</option>
                            <option value="C">Lựa chọn C</option>
                            <option value="D">Lựa chọn D</option>
                        </select>
                    </div>
                </div>

                <div class="q-writing-box" style="display: none;">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Dạng tự luận:</strong> Học viên sẽ nhập bài viết / câu trả lời vào khung văn bản. Giảng viên có thể xem nội dung bài làm và chấm điểm kèm lời nhận xét trong mục Chấm điểm bài nộp.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-success">
                            <i class="bi bi-card-checklist me-1"></i> Gợi ý đáp án / Tiêu chí chấm điểm (Rubric):
                        </label>
                        <textarea name="questions[${newIndex}].WritingAnswer" class="form-control border-info q-writing-rubric" rows="2" placeholder="Ví dụ: Nêu đủ 3 ý chính, cấu trúc câu rõ ràng, sử dụng từ vựng chủ đề..."></textarea>
                    </div>
                </div>

                <div>
                    <label class="form-label small text-secondary">Giải thích / Feedback chi tiết cho học viên</label>
                    <input type="text" name="questions[${newIndex}].Explanation" class="form-control q-explanation-input" placeholder="Feedback giải thích vì sao đáp án đúng, hoặc lưu ý từ vựng, ngữ pháp..." />
                </div>
            `;

            container.appendChild(cardDiv);
            reindexQuestions();

            cardDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
            var newTextarea = cardDiv.querySelector('.q-content-input');
            if (newTextarea) newTextarea.focus();
        }

        function removeQuestion(btn) {
            var card = btn.closest('.exercise-q-card');
            if (card) {
                card.remove();
                reindexQuestions();
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            reindexQuestions();

            var hierarchyData = @Html.Raw(ViewBag.CoursesHierarchyJson ?? "[]");
            var selectedCourseId = '@(ViewBag.SelectedCourseId ?? "")';
            var selectedChapterId = '@(ViewBag.SelectedChapterId ?? "")';
            var selectedLessonId = '@(ViewBag.SelectedLessonId ?? Model.LessonId.ToString())';

            var courseSelect = document.getElementById('courseSelect');
            var chapterSelect = document.getElementById('chapterSelect');
            var lessonSelect = document.getElementById('lessonSelect');

            function populateChapters(courseId, targetChapterId, targetLessonId) {
                chapterSelect.innerHTML = '';
                lessonSelect.innerHTML = '';
                lessonSelect.disabled = true;

                var defaultLessonOpt = document.createElement('option');
                defaultLessonOpt.value = '';
                defaultLessonOpt.textContent = '-- Vui lòng chọn chương học trước --';
                lessonSelect.appendChild(defaultLessonOpt);

                if (!courseId) {
                    chapterSelect.disabled = true;
                    var opt = document.createElement('option');
                    opt.value = '';
                    opt.textContent = '-- Vui lòng chọn khóa học trước --';
                    chapterSelect.appendChild(opt);
                    return;
                }

                var course = hierarchyData.find(function(c) {
                    var cid = c.CourseId || c.courseId;
                    return String(cid) === String(courseId);
                });
                var chapters = course ? (course.Chapters || course.chapters || []) : [];

                if (!chapters || chapters.length === 0) {
                    chapterSelect.disabled = true;
                    var opt = document.createElement('option');
                    opt.value = '';
                    opt.textContent = '-- Khóa học này chưa có chương học nào --';
                    chapterSelect.appendChild(opt);
                    return;
                }

                chapterSelect.disabled = false;
                var defaultOpt = document.createElement('option');
                defaultOpt.value = '';
                defaultOpt.textContent = '-- Chọn chương học --';
                chapterSelect.appendChild(defaultOpt);

                chapters.forEach(function(ch) {
                    var opt = document.createElement('option');
                    var chId = ch.ChapterId || ch.chapterId;
                    var chTitle = ch.Title || ch.title;
                    var chOrder = ch.OrderIndex || ch.orderIndex;
                    var chDisplay = ch.DisplayText || ch.displayText || ('Chương ' + chOrder + ': ' + chTitle);

                    opt.value = chId;
                    opt.textContent = chDisplay;
                    if (targetChapterId && String(chId) === String(targetChapterId)) {
                        opt.selected = true;
                    }
                    chapterSelect.appendChild(opt);
                });

                if (targetChapterId) {
                    populateLessons(courseId, targetChapterId, targetLessonId);
                }
            }

            function populateLessons(courseId, chapterId, targetLessonId) {
                lessonSelect.innerHTML = '';

                if (!chapterId) {
                    lessonSelect.disabled = true;
                    var opt = document.createElement('option');
                    opt.value = '';
                    opt.textContent = '-- Vui lòng chọn chương học trước --';
                    lessonSelect.appendChild(opt);
                    return;
                }

                var course = hierarchyData.find(function(c) {
                    var cid = c.CourseId || c.courseId;
                    return String(cid) === String(courseId);
                });
                var chapter = course && (course.Chapters || course.chapters) ? (course.Chapters || course.chapters).find(function(ch) {
                    var chId = ch.ChapterId || ch.chapterId;
                    return String(chId) === String(chapterId);
                }) : null;
                var lessons = chapter ? (chapter.Lessons || chapter.lessons || []) : [];

                if (!lessons || lessons.length === 0) {
                    lessonSelect.disabled = true;
                    var opt = document.createElement('option');
                    opt.value = '';
                    opt.textContent = '-- Chương này chưa có bài học nào --';
                    lessonSelect.appendChild(opt);
                    return;
                }

                lessonSelect.disabled = false;
                var defaultOpt = document.createElement('option');
                defaultOpt.value = '';
                defaultOpt.textContent = '-- Chọn bài học trực thuộc --';
                lessonSelect.appendChild(defaultOpt);

                lessons.forEach(function(l) {
                    var opt = document.createElement('option');
                    var lId = l.LessonId || l.lessonId;
                    var lTitle = l.Title || l.title;
                    var lOrder = l.OrderIndex || l.orderIndex;
                    var lDisplay = l.DisplayText || l.displayText || ('Bài ' + lOrder + ': ' + lTitle);

                    opt.value = lId;
                    opt.textContent = lDisplay;
                    if (targetLessonId && String(lId) === String(targetLessonId)) {
                        opt.selected = true;
                    }
                    lessonSelect.appendChild(opt);
                });
            }

            if (courseSelect) {
                courseSelect.addEventListener('change', function () {
                    populateChapters(this.value, null, null);
                });
            }

            if (chapterSelect) {
                chapterSelect.addEventListener('change', function () {
                    populateLessons(courseSelect.value, this.value, null);
                });
            }

            // Auto-detect preselected lesson
            if (selectedLessonId && !selectedCourseId) {
                for (var i = 0; i < hierarchyData.length; i++) {
                    var c = hierarchyData[i];
                    var chList = c.Chapters || c.chapters || [];
                    for (var j = 0; j < chList.length; j++) {
                        var ch = chList[j];
                        var lList = ch.Lessons || ch.lessons || [];
                        var found = lList.some(function (l) {
                            var lId = l.LessonId || l.lessonId;
                            return String(lId) === String(selectedLessonId);
                        });
                        if (found) {
                            selectedCourseId = c.CourseId || c.courseId;
                            selectedChapterId = ch.ChapterId || ch.chapterId;
                            break;
                        }
                    }
                    if (selectedCourseId) break;
                }
            }

            if (selectedCourseId && courseSelect) {
                courseSelect.value = selectedCourseId;
                populateChapters(selectedCourseId, selectedChapterId, selectedLessonId);
            }

            // Form submit validation
            var form = document.getElementById('editExerciseForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (!lessonSelect || !lessonSelect.value) {
                        var initLesson = document.getElementById('initialLessonId');
                        if (initLesson && initLesson.value && lessonSelect) {
                            var fallbackOpt = document.createElement('option');
                            fallbackOpt.value = initLesson.value;
                            fallbackOpt.selected = true;
                            lessonSelect.appendChild(fallbackOpt);
                            lessonSelect.value = initLesson.value;
                        }
                    }

                    if (!lessonSelect || !lessonSelect.value) {
                        e.preventDefault();
                        alert('Vui lòng chọn đầy đủ Khóa học, Chương học và Bài học trực thuộc!');
                        if (courseSelect && !courseSelect.value) courseSelect.focus();
                        else if (chapterSelect && !chapterSelect.value) chapterSelect.focus();
                        else if (lessonSelect) lessonSelect.focus();
                        return false;
                    }

                    lessonSelect.disabled = false;

                    var cards = document.querySelectorAll('#questionsContainer .exercise-q-card');
                    if (cards.length > 1) {
                        cards.forEach(function (card) {
                            var contentInput = card.querySelector('.q-content-input');
                            if (contentInput && !contentInput.value.trim()) {
                                card.remove();
                            }
                        });
                        reindexQuestions();
                    }

                    cards = document.querySelectorAll('#questionsContainer .exercise-q-card');
                    cards.forEach(function (card) {
                        var formatSelect = card.querySelector('.q-format-select');
                        var isWriting = formatSelect && formatSelect.value === 'Writing';
                        if (isWriting) {
                            var correctMc = card.querySelector('.q-correct-mc');
                            if (correctMc) {
                                correctMc.disabled = true;
                            }
                        }
                    });
                });
            }
        });
    </script>
}
