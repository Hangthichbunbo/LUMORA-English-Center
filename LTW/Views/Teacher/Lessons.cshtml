@model IEnumerable<LTW.Models.Lesson>

@{
    ViewData["Title"] = "Quản Lý Bài Học - Giảng Viên LUMORA";
    var totalLessons = Model?.Count() ?? 0;
}

<!-- Unified Teacher Header -->
<partial name="_TeacherHeader" />

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="fw-bold text-dark m-0"><i class="bi bi-journal-text me-2 text-primary"></i>Quản Lý Nội Dung Bài Học</h4>
            <p class="text-muted small m-0">Danh sách bài giảng, video clip, audio nghe và tài liệu đã biên soạn</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-white text-secondary border rounded-pill px-3 py-2 shadow-sm">
                Tổng số: <strong class="text-dark">@totalLessons</strong> bài học
            </span>
            <a asp-action="CreateLesson" class="btn btn-lumora-secondary btn-sm rounded-pill px-3 fw-semibold shadow-sm text-white">
                <i class="bi bi-plus-circle me-1"></i> Thêm Bài Học Mới
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">Tiêu Đề Bài Học</th>
                        <th>Khóa Học</th>
                        <th>Chương Trực Thuộc</th>
                        <th>Tài Nguyên Media</th>
                        <th>Bài Tập Kèm</th>
                        <th>Học Thử</th>
                        <th class="text-end pe-4 text-nowrap">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var l in Model)
                        {
                            var hasMedia = !string.IsNullOrEmpty(l.VideoUrl) || !string.IsNullOrEmpty(l.AudioUrl) || !string.IsNullOrEmpty(l.DocumentUrl);
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@l.Title</div>
                                    <div class="text-muted" style="font-size: 11px;">Thứ tự bài: #@l.OrderIndex</div>
                                </td>
                                <td>
                                    @if (l.Chapter?.Course != null)
                                    {
                                        <span class="badge bg-light text-dark border">@l.Chapter.Course.Title</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (l.Chapter != null)
                                    {
                                        <div class="fw-semibold text-secondary">Chương @l.Chapter.OrderIndex: @l.Chapter.Title</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (hasMedia)
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (!string.IsNullOrEmpty(l.VideoUrl)) { <span class="badge bg-primary bg-opacity-10 text-primary"><i class="bi bi-camera-video me-1"></i>Video</span> }
                                            @if (!string.IsNullOrEmpty(l.AudioUrl)) { <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-headphones me-1"></i>Audio</span> }
                                            @if (!string.IsNullOrEmpty(l.DocumentUrl)) { <span class="badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-file-pdf me-1"></i>Doc</span> }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px;"><i class="bi bi-file-text me-1"></i>Chỉ lý thuyết</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clipboard-check me-1 text-primary"></i>@(l.Exercises?.Count ?? 0) bài tập
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(l.IsFreePreview ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary") rounded-pill px-2 py-1">
                                        @(l.IsFreePreview ? "Free Preview" : "Khóa học")
                                    </span>
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-controller="Student" asp-action="Lesson" asp-route-id="@l.LessonId" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Xem giao diện học sinh">
                                        <i class="bi bi-eye me-1"></i> Xem Bài Học
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-plus display-6 d-block mb-2 text-secondary"></i>
                                <h6 class="fw-bold text-dark">Chưa có bài học nào</h6>
                                <p class="small text-muted mb-3">Bạn chưa tạo bài học nào trong hệ thống. Hãy bắt đầu biên soạn bài giảng đầu tiên.</p>
                                <a asp-action="CreateLesson" class="btn btn-lumora-secondary btn-sm rounded-pill px-4 text-white">
                                    <i class="bi bi-plus-circle me-1"></i> Thêm Bài Học Mới
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
