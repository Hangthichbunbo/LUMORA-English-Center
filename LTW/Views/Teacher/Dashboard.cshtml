@using LTW.Models
@{
    ViewData["Title"] = "Bàn Làm Việc Giảng Viên (Teacher Dashboard) - LUMORA";
    var taughtCourses = ViewBag.TaughtCourses as List<Course> ?? new List<Course>();
    var myClasses = ViewBag.MyClasses as List<LiveClass> ?? new List<LiveClass>();
    var totalStudents = ViewBag.TotalStudents != null ? (int)ViewBag.TotalStudents : 0;
    var pendingAssessments = ViewBag.PendingAssessments as List<ExerciseSubmission> ?? new List<ExerciseSubmission>();
}

<!-- Unified Teacher Header -->
<partial name="_TeacherHeader" />

<div class="container-fluid px-lg-5 py-4">
    <!-- Metrics Overview -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary"><i class="bi bi-journal-album fs-3"></i></div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@taughtCourses.Count</div>
                    <small class="text-muted">Khóa học phụ trách</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-danger bg-opacity-10 rounded-3 text-danger"><i class="bi bi-camera-video fs-3"></i></div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@myClasses.Count</div>
                    <small class="text-muted">Buổi Live Class</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-info bg-opacity-10 rounded-3 text-info"><i class="bi bi-people fs-3"></i></div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@totalStudents</div>
                    <small class="text-muted">Học viên đang học</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-warning"><i class="bi bi-hourglass-split fs-3"></i></div>
                <div>
                    <div class="fs-4 fw-bold text-dark">@pendingAssessments.Count</div>
                    <small class="text-muted">Bài nộp chờ chấm</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Courses Grid -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h5 class="fw-bold text-dark m-0"><i class="bi bi-book-half me-2 text-primary"></i>Khóa Học Đang Phụ Trách</h5>
                <p class="text-muted small m-0">Danh sách các chương trình đào tạo trực tuyến do bạn giảng dạy</p>
            </div>
            <a asp-action="Lessons" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-journal-text me-1"></i> Xem Tất Cả Bài Học
            </a>
        </div>

        @if (taughtCourses.Any())
        {
            <div class="row g-3">
                @foreach (var c in taughtCourses)
                {
                    var lessonCount = c.Chapters?.Sum(ch => ch.Lessons?.Count ?? 0) ?? 0;
                    var studentCount = c.Enrollments?.Count(e => e.PaymentStatus == "Completed") ?? 0;
                    <div class="col-md-6 col-xl-4">
                        <div class="border rounded-4 p-3 bg-light h-100 d-flex flex-column justify-content-between hover-elevate">
                            <div>
                                <div class="d-flex gap-3 align-items-start mb-2">
                                    <img src="@(string.IsNullOrEmpty(c.Thumbnail) ? "https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=120&q=80" : c.Thumbnail)" 
                                         alt="@c.Title" class="rounded-3 shadow-sm flex-shrink-0" style="width: 72px; height: 56px; object-fit: cover;" />
                                    <div class="overflow-hidden">
                                        <div class="badge bg-primary bg-opacity-10 text-primary mb-1" style="font-size: 10px;">@c.Category</div>
                                        <h6 class="fw-bold text-dark text-truncate mb-0" title="@c.Title">@c.Title</h6>
                                        <small class="text-muted">Mục tiêu: @c.Level</small>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-2 py-2 border-top border-bottom small text-muted my-2">
                                    <div><i class="bi bi-people me-1 text-info"></i><strong>@studentCount</strong> học viên</div>
                                    <div><i class="bi bi-folder me-1 text-secondary"></i><strong>@(c.Chapters?.Count ?? 0)</strong> chương</div>
                                    <div><i class="bi bi-journal-check me-1 text-success"></i><strong>@lessonCount</strong> bài học</div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <span class="badge @(c.IsPublished ? "bg-success" : "bg-secondary") rounded-pill">
                                    @(c.IsPublished ? "Đang mở" : "Bản nháp")
                                </span>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Course" asp-action="Detail" asp-route-id="@c.CourseId" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Xem trang khóa học">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                    <a asp-action="CreateLesson" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Thêm bài học vào khóa">
                                        <i class="bi bi-plus-lg"></i> Bài học
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                <p class="m-0">Chưa có khóa học nào được chỉ định cho tài khoản của bạn.</p>
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Live Classes List -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-broadcast me-2 text-danger"></i>Lớp Trực Tuyến Đang Phụ Trách</h5>
                    <a asp-action="MyClasses" class="small text-primary text-decoration-none">Xem tất cả</a>
                </div>

                @if (myClasses.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var cls in myClasses.Take(4))
                        {
                            <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between gap-3">
                                <div>
                                    <div class="fw-bold text-dark">@cls.ClassName</div>
                                    <div class="small text-secondary">
                                        <i class="bi bi-calendar3 me-1"></i>@cls.ScheduledDate.ToString("dd/MM/yyyy") | @cls.StartTime.ToString(@"hh\:mm") - @cls.EndTime.ToString(@"hh\:mm")
                                    </div>
                                    <span class="badge @(cls.IsPublic ? "bg-success" : "bg-danger") rounded-pill mt-1" style="font-size: 10px;">
                                        @(cls.IsPublic ? "Public" : "Private")
                                    </span>
                                </div>
                                <a asp-controller="Class" asp-action="Join" asp-route-id="@cls.LiveClassId" class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold">
                                    <i class="bi bi-camera-video me-1"></i> Vào Giảng Lớp
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-camera-video-off fs-2 d-block mb-2 text-secondary"></i>
                        <p class="small m-0">Chưa có lớp học trực tuyến nào được phân công.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Pending Assessments -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold text-dark m-0"><i class="bi bi-clipboard2-check me-2 text-warning"></i>Bài Nộp Cần Chấm Điểm & Feedback</h5>
                    <a asp-action="Assessments" class="small text-primary text-decoration-none">Xem tất cả</a>
                </div>

                @if (pendingAssessments.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var sub in pendingAssessments)
                        {
                            <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between gap-3">
                                <div>
                                    <div class="fw-bold text-dark">@sub.Student?.FullName</div>
                                    <div class="small text-muted">Bài: @sub.Exercise?.Title</div>
                                    <div class="small text-secondary">Nộp lúc: @sub.SubmittedAt.ToString("HH:mm - dd/MM")</div>
                                </div>
                                <a asp-action="Assessments" class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold text-dark">
                                    <i class="bi bi-pencil-fill me-1"></i> Chấm Điểm
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-success small p-4 bg-success bg-opacity-10 rounded-3 text-center">
                        <i class="bi bi-check-circle-fill fs-3 d-block mb-2 text-success"></i>
                        Tất cả các bài nộp của học viên đã được chấm hoàn tất!
                    </div>
                }
            </div>
        </div>
    </div>
</div>
