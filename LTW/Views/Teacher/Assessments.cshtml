@model IEnumerable<LTW.Models.ExerciseSubmission>

@{
    ViewData["Title"] = "Chấm Điểm & Đánh Giá Bài Nộp - Giảng Viên LUMORA";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-check2-square me-2 text-warning"></i>Đánh Giá & Chấm Điểm Bài Tập</h3>
            <p class="text-muted small m-0">Nhập điểm số và phản hồi chi tiết cho bài làm Writing, Speaking và các bài tập học viên nộp</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="ps-4">Học Viên</th>
                        <th>Bài Tập</th>
                        <th>Ngày Nộp</th>
                        <th>Điểm Tự Chấm</th>
                        <th>Điểm GV Chấm</th>
                        <th>Tổng Điểm</th>
                        <th>Nhận Xét</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var sub in Model)
                        {
                            var modalId = "gradeModal_" + sub.SubmissionId;
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@(sub.Student?.FullName ?? "Học viên")</div>
                                    <div class="text-muted" style="font-size: 11px;">@sub.Student?.Email</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@sub.Exercise?.Title</div>
                                    <div class="text-muted" style="font-size: 11px;">Bài học: @sub.Exercise?.Lesson?.Title</div>
                                </td>
                                <td>@sub.SubmittedAt.ToString("HH:mm - dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@sub.AutoScore.ToString("F1")</span></td>
                                <td>
                                    @if (sub.TeacherScore.HasValue)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold">@sub.TeacherScore.Value.ToString("F1")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning fw-bold">Chưa chấm</span>
                                    }
                                </td>
                                <td><strong class="text-primary fs-6">@sub.TotalScore.ToString("F1")</strong></td>
                                <td style="max-width: 200px;">
                                    <span class="text-truncate d-inline-block text-secondary" style="max-width: 200px;">
                                        @(string.IsNullOrEmpty(sub.TeacherComment) ? "(Chưa có nhận xét)" : sub.TeacherComment)
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-sm" 
                                            data-bs-toggle="modal" data-bs-target="#@modalId" style="background-color: #00A896; border-color: #00A896;">
                                        <i class="bi bi-pencil-fill me-1"></i> Chấm Điểm
                                    </button>
                                </td>
                            </tr>

                            <!-- Grading Modal for this submission -->
                            <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg rounded-4 p-3">
                                        <div class="modal-header border-0 pb-0">
                                            <h5 class="modal-title fw-bold text-dark">Chấm Điểm & Nhận Xét Bài Nộp</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="GradeSubmission" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="submissionId" value="@sub.SubmissionId" />

                                            <div class="modal-body">
                                                <div class="p-3 bg-light rounded-3 mb-3 small">
                                                    <div>Học viên: <strong>@sub.Student?.FullName</strong></div>
                                                    <div>Bài tập: <strong>@sub.Exercise?.Title</strong></div>
                                                    <div>Điểm tự động: <strong>@sub.AutoScore.ToString("F1") / 10</strong></div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold text-secondary">Điểm Giảng Viên Chấm (Thang điểm 10)</label>
                                                    <input type="number" step="0.5" min="0" max="10" name="teacherScore" 
                                                           value="@(sub.TeacherScore ?? sub.AutoScore)" class="form-control" required />
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold text-secondary">Lời Nhận Xét & Góp Ý Chi Tiết</label>
                                                    <textarea name="teacherComment" class="form-control" rows="4" 
                                                              placeholder="Nhận xét ưu điểm, chỉ ra các lỗi ngữ pháp/từ vựng cần cải thiện...">@(sub.TeacherComment ?? "")</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                                                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" style="background-color: #00A896; border-color: #00A896;">
                                                    <i class="bi bi-check2 me-1"></i> Lưu Đánh Giá
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Chưa có bài nộp nào cần chấm điểm.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

