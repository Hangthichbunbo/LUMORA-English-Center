@model PaginatedList<AuditLog>
@{
    ViewData["Title"] = "Nhật ký hệ thống (Audit Log)";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-journal-text text-danger me-2"></i>Nhật ký hệ thống (Audit Log)</h3>
        <p class="text-muted small mb-0">Theo dõi toàn bộ thao tác thêm, sửa, xóa và tác động dữ liệu của quản trị viên</p>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="entityName" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Tất cả thực thể --</option>
                <option value="Story" selected="@(ViewData["EntityName"]?.ToString() == "Story")">Truyện (Story)</option>
                <option value="Chapter" selected="@(ViewData["EntityName"]?.ToString() == "Chapter")">Chương (Chapter)</option>
                <option value="Advertisement" selected="@(ViewData["EntityName"]?.ToString() == "Advertisement")">Quảng cáo (Ad)</option>
                <option value="Comment" selected="@(ViewData["EntityName"]?.ToString() == "Comment")">Bình luận (Comment)</option>
                <option value="Category" selected="@(ViewData["EntityName"]?.ToString() == "Category")">Thể loại (Category)</option>
                <option value="Author" selected="@(ViewData["EntityName"]?.ToString() == "Author")">Tác giả (Author)</option>
                <option value="ApplicationUser" selected="@(ViewData["EntityName"]?.ToString() == "ApplicationUser")">Người dùng (User)</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="actionName" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Tất cả hành động --</option>
                <option value="Added" selected="@(ViewData["ActionName"]?.ToString() == "Added")">Thêm mới (Added)</option>
                <option value="Modified" selected="@(ViewData["ActionName"]?.ToString() == "Modified")">Chỉnh sửa (Modified)</option>
                <option value="Deleted" selected="@(ViewData["ActionName"]?.ToString() == "Deleted")">Xóa (Deleted)</option>
            </select>
        </div>
        <div class="col-md-4">
            <input type="text" name="userId" class="form-control form-control-sm" placeholder="Tìm theo ID người thực hiện..." value="@ViewData["UserId"]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Tra cứu</button>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 font-monospace small">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Thời gian</th>
                    <th>Hành động</th>
                    <th>Thực thể</th>
                    <th>Khóa (EntityId)</th>
                    <th>Người thực hiện</th>
                    <th>Địa chỉ IP</th>
                    <th class="text-end pe-3 font-sans-serif">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted font-sans-serif">Không có nhật ký nào được ghi nhận.</td></tr>
                }
                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td>#@log.Id</td>
                        <td class="text-muted">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            @if (log.Action == "Added")
                            {
                                <span class="badge bg-success-subtle text-success">Added</span>
                            }
                            else if (log.Action == "Modified")
                            {
                                <span class="badge bg-warning-subtle text-warning">Modified</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Deleted</span>
                            }
                        </td>
                        <td class="fw-bold">@log.EntityName</td>
                        <td>@log.EntityId</td>
                        <td class="text-truncate" style="max-width: 140px;">@(string.IsNullOrEmpty(log.UserId) ? "Hệ thống" : log.UserId)</td>
                        <td class="text-muted">@(string.IsNullOrEmpty(log.IpAddress) ? "Local" : log.IpAddress)</td>
                        <td class="text-end pe-3">
                            <a asp-action="Detail" asp-route-id="@log.Id" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 0.75rem;">
                                Xem JSON
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-body border-top py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Trang @Model.PageIndex / @Model.TotalPages (Tổng cộng @Model.TotalCount bản ghi)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-entityName="@ViewData["EntityName"]" asp-route-actionName="@ViewData["ActionName"]" asp-route-userId="@ViewData["UserId"]">Trước</a>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-entityName="@ViewData["EntityName"]" asp-route-actionName="@ViewData["ActionName"]" asp-route-userId="@ViewData["UserId"]">Sau</a>
                </li>
            </ul>
        </div>
    }
</div>
