@model AuditLog
@{
    ViewData["Title"] = "Chi tiết Nhật ký #" + Model.Id;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Chi tiết Nhật ký #@Model.Id</h3>
        <p class="text-muted small mb-0">Thời gian ghi nhận: @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <h6 class="fw-bold mb-3 border-bottom pb-2">Thông tin bối cảnh (Metadata)</h6>
            <div class="mb-2 small">
                <span class="text-muted d-block">Hành động (Action):</span>
                <span class="badge bg-primary">@Model.Action</span>
            </div>
            <div class="mb-2 small">
                <span class="text-muted d-block">Tên thực thể (Entity):</span>
                <span class="fw-bold">@Model.EntityName</span>
            </div>
            <div class="mb-2 small">
                <span class="text-muted d-block">Khóa chính (EntityId):</span>
                <code>@Model.EntityId</code>
            </div>
            <div class="mb-2 small">
                <span class="text-muted d-block">Người thực hiện (UserId):</span>
                <code>@(string.IsNullOrEmpty(Model.UserId) ? "Hệ thống" : Model.UserId)</code>
            </div>
            <div class="mb-2 small">
                <span class="text-muted d-block">Địa chỉ IP:</span>
                <code>@(string.IsNullOrEmpty(Model.IpAddress) ? "N/A" : Model.IpAddress)</code>
            </div>
            <div class="mb-2 small">
                <span class="text-muted d-block">Mã tương quan (CorrelationId):</span>
                <code>@Model.CorrelationId</code>
            </div>
            <div class="mb-0 small">
                <span class="text-muted d-block">Trình duyệt (User Agent):</span>
                <div class="text-truncate text-muted" title="@Model.UserAgent">@Model.UserAgent</div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm p-3 mb-3">
            <h6 class="fw-bold mb-2 text-danger">Giá trị ban đầu (Old Values JSON)</h6>
            <pre class="bg-dark text-white p-3 rounded small overflow-auto mb-0" style="max-height: 250px;"><code>@(string.IsNullOrEmpty(Model.OldValues) ? "(Không có)" : Model.OldValues)</code></pre>
        </div>

        <div class="card border-0 shadow-sm p-3">
            <h6 class="fw-bold mb-2 text-success">Giá trị cập nhật mới (New Values JSON)</h6>
            <pre class="bg-dark text-white p-3 rounded small overflow-auto mb-0" style="max-height: 250px;"><code>@(string.IsNullOrEmpty(Model.NewValues) ? "(Không có)" : Model.NewValues)</code></pre>
        </div>
    </div>
</div>
