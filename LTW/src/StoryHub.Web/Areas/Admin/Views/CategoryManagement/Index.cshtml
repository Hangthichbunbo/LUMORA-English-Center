@model List<CategoryDto>
@{
    ViewData["Title"] = "Quản lý Thể loại";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản lý Thể loại</h3>
        <p class="text-muted small mb-0">Danh sách các thể loại truyện trên TruyenVietSub</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-plus-lg me-1"></i>Thêm thể loại
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 60px;">Id</th>
                    <th>Tên thể loại</th>
                    <th>Slug</th>
                    <th>Mô tả</th>
                    <th>Số truyện</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="small text-muted">@c.Id</td>
                        <td class="fw-bold text-primary">@c.Name</td>
                        <td class="small text-muted">@c.Slug</td>
                        <td class="small text-muted" style="max-width: 350px;">@c.Description</td>
                        <td class="small fw-semibold">@c.StoryCount bộ</td>
                        <td>
                            <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">
                                @(c.IsActive ? "Hoạt động" : "Khóa")
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" onclick="openEditModal(@c.Id, '@c.Name', '@c.Slug', '@c.Description', @(c.IsActive ? "true" : "false"))">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa thể loại này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Thể Loại -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Thêm thể loại mới</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên thể loại (*)</label>
                        <input type="text" name="Name" id="create-cat-name" class="form-control" required maxlength="100" placeholder="Ví dụ: Đô Thị, Huyền Huyễn..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Đường dẫn tĩnh (Slug) (*)</label>
                        <div class="input-group">
                            <input type="text" name="Slug" id="create-cat-slug" class="form-control" required maxlength="110" placeholder="do-thi, huyen-huan..." />
                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('create-cat-slug').value = convertToSlug(document.getElementById('create-cat-name').value);" title="Tự động tạo slug">
                                <i class="bi bi-magic"></i>
                            </button>
                        </div>
                        <small class="text-muted" style="font-size: 0.8rem;">Tự động sinh từ tên thể loại, có thể chỉnh sửa thủ công.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mô tả</label>
                        <textarea name="Description" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked id="createIsActive" />
                        <label class="form-check-label small fw-bold" for="createIsActive">Kích hoạt thể loại</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm">Thêm thể loại</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Thể Loại -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Chỉnh sửa thể loại</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="edit-cat-id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên thể loại (*)</label>
                        <input type="text" name="Name" id="edit-cat-name" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Slug (*)</label>
                        <div class="input-group">
                            <input type="text" name="Slug" id="edit-cat-slug" class="form-control" required maxlength="110" />
                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('edit-cat-slug').value = convertToSlug(document.getElementById('edit-cat-name').value);" title="Tự động tạo lại slug theo tên mới">
                                <i class="bi bi-magic"></i>
                            </button>
                        </div>
                        <small class="text-muted" style="font-size: 0.8rem;">Tự động cập nhật khi đổi tên thể loại, hoặc bấm nút đũa thần để làm mới.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mô tả</label>
                        <textarea name="Description" id="edit-cat-desc" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="edit-cat-active" />
                        <label class="form-check-label small fw-bold" for="edit-cat-active">Kích hoạt thể loại</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function convertToSlug(str) {
            if (!str) return '';
            return str.toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[đĐ]/g, 'd')
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
        }

        // Tự động tạo slug khi thêm mới thể loại
        const createCatName = document.getElementById('create-cat-name');
        const createCatSlug = document.getElementById('create-cat-slug');
        if (createCatName && createCatSlug) {
            createCatName.addEventListener('input', function () {
                createCatSlug.value = convertToSlug(this.value);
            });
        }

        // Tự động cập nhật slug khi sửa tên thể loại
        const editCatName = document.getElementById('edit-cat-name');
        const editCatSlug = document.getElementById('edit-cat-slug');
        if (editCatName && editCatSlug) {
            editCatName.addEventListener('input', function () {
                editCatSlug.value = convertToSlug(this.value);
            });
        }

        function openEditModal(id, name, slug, desc, isActive) {
            document.getElementById('edit-cat-id').value = id;
            document.getElementById('edit-cat-name').value = name;
            document.getElementById('edit-cat-slug').value = slug;
            document.getElementById('edit-cat-desc').value = desc;
            document.getElementById('edit-cat-active').checked = isActive;
            new bootstrap.Modal(document.getElementById('editCategoryModal')).show();
        }
    </script>
}
