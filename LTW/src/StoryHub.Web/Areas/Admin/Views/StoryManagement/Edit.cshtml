@model UpdateStoryDto
@{
    ViewData["Title"] = "Chỉnh sửa truyện: " + Model.Title;
    var authors = ViewBag.Authors as List<AuthorDto> ?? [];
    var categories = ViewBag.Categories as List<CategoryDto> ?? [];
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Chỉnh sửa truyện: @Model.Title</h3>
        <p class="text-muted small mb-0">Cập nhật thông tin chi tiết và thể loại truyện</p>
    </div>
    <div>
        <a asp-controller="ChapterManagement" asp-action="Index" asp-route-storyId="@Model.Id" class="btn btn-outline-primary btn-sm me-2">
            <i class="bi bi-list-ol me-1"></i>Quản lý chương
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm p-4">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="RowVersion" />
        <input type="hidden" asp-for="CoverImageUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label small fw-bold">Tiêu đề truyện (*)</label>
                    <input asp-for="Title" class="form-control" id="story-title" required maxlength="250" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Slug" class="form-label small fw-bold">Đường dẫn tĩnh (Slug) (*)</label>
                    <div class="input-group">
                        <span class="input-group-text">/truyen/</span>
                        <input asp-for="Slug" class="form-control" id="story-slug" required maxlength="260" />
                    </div>
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AlternativeTitle" class="form-label small fw-bold">Tên khác (Tùy chọn)</label>
                    <input asp-for="AlternativeTitle" class="form-control" maxlength="250" />
                    <span asp-validation-for="AlternativeTitle" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-bold">Giới thiệu tóm tắt</label>
                    <textarea asp-for="Description" class="form-control" rows="6" maxlength="4000"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-body-tertiary border-0 p-3 mb-3">
                    <h6 class="fw-bold mb-3"><i class="bi bi-gear-fill me-1"></i>Thiết lập</h6>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tác giả (*)</label>
                        @{
                            var currentAuthorName = !string.IsNullOrWhiteSpace(Model.AuthorName)
                                ? Model.AuthorName
                                : authors.FirstOrDefault(a => a.Id == Model.AuthorId)?.Name;
                        }
                        <input type="text" asp-for="AuthorName" value="@currentAuthorName" class="form-control" id="author-name-input"
                               list="authorSuggestions" placeholder="Nhập tên hoặc chọn tác giả đề xuất..." autocomplete="off" required />
                        <datalist id="authorSuggestions">
                            @foreach (var a in authors)
                            {
                                <option value="@a.Name" data-id="@a.Id">@a.Name</option>
                            }
                        </datalist>
                        <input type="hidden" asp-for="AuthorId" id="author-id-input" value="@Model.AuthorId" />
                        <span asp-validation-for="AuthorName" class="text-danger small"></span>
                        <span asp-validation-for="AuthorId" class="text-danger small"></span>
                        <div class="form-text text-muted" style="font-size: 0.75rem;">
                            <i class="bi bi-lightbulb me-1"></i>Có thể gõ tên tác giả mới hoặc chọn tác giả có sẵn từ danh sách gợi ý.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Trạng thái phát hành</label>
                        <select asp-for="PublishStatus" class="form-select">
                            <option value="@PublishStatus.Published">Xuất bản công khai</option>
                            <option value="@PublishStatus.Draft">Bản nháp</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tiến độ truyện</label>
                        <select asp-for="Status" class="form-select">
                            <option value="@StoryStatus.Published">Đang ra</option>
                            <option value="@StoryStatus.Completed">Đã hoàn thành</option>
                            <option value="@StoryStatus.Paused">Tạm dừng</option>
                            <option value="@StoryStatus.Hidden">Ẩn truyện</option>
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label small fw-bold">Đánh dấu Truyện Nổi Bật</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Ảnh bìa hiện tại</label>
                        @{
                            var displayCover = Model.CoverImageUrl;
                            if (!string.IsNullOrEmpty(displayCover) && displayCover.StartsWith("//app/"))
                            {
                                displayCover = displayCover.Substring(5);
                            }
                        }
                        <div class="mb-2 @(string.IsNullOrEmpty(displayCover) ? "d-none" : "")" id="cover-preview-container">
                            <img src="@(string.IsNullOrEmpty(displayCover) ? "" : displayCover)" id="cover-preview" class="rounded shadow-sm" width="100" height="140" style="object-fit: cover;" onerror="this.onerror=null; this.src='/images/default-cover.webp';" />
                        </div>
                        <label class="form-label small text-muted">Thay đổi ảnh bìa (Tùy chọn):</label>
                        <input type="file" name="coverImage" id="cover-image-input" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                    </div>
                </div>

                <!-- Categories Checkboxes -->
                <div class="card bg-body-tertiary border-0 p-3">
                    <h6 class="fw-bold mb-2"><i class="bi bi-tags-fill me-1"></i>Thể loại (*)</h6>
                    <div class="overflow-auto p-1" style="max-height: 200px;">
                        @foreach (var cat in categories)
                        {
                            <div class="form-check small mb-1">
                                <input class="form-check-input" type="checkbox" name="CategoryIds" value="@cat.Id" id="cat-@cat.Id" 
                                       @(Model.CategoryIds.Contains(cat.Id) ? "checked" : "") />
                                <label class="form-check-label" for="cat-@cat.Id">@cat.Name</label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-secondary px-4">Hủy</a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save me-1"></i>Lưu thay đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const authorInput = document.getElementById('author-name-input');
        const authorIdInput = document.getElementById('author-id-input');
        const datalistOptions = document.querySelectorAll('#authorSuggestions option');

        if (authorInput) {
            authorInput.addEventListener('input', function() {
                const val = this.value.trim().toLowerCase();
                let foundId = 0;
                for (const opt of datalistOptions) {
                    if (opt.value.trim().toLowerCase() === val) {
                        foundId = opt.getAttribute('data-id') || 0;
                        break;
                    }
                }
                authorIdInput.value = foundId;
            });
        }

        const coverFileInput = document.getElementById('cover-image-input');
        if (coverFileInput) {
            const initialCoverSrc = document.getElementById('cover-preview')?.src || '';
            const initialHadCover = !document.getElementById('cover-preview-container')?.classList.contains('d-none');

            coverFileInput.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                    if (file.size > 1024 * 1024) {
                        alert('Dung lượng ảnh bìa (' + (file.size / (1024 * 1024)).toFixed(2) + ' MB) vượt quá giới hạn tối đa 1 MB! Vui lòng chọn ảnh nhỏ hơn.');
                        this.value = '';
                        const preview = document.getElementById('cover-preview');
                        const container = document.getElementById('cover-preview-container');
                        if (preview) preview.src = initialCoverSrc;
                        if (container && !initialHadCover) container.classList.add('d-none');
                        return;
                    }
                    const preview = document.getElementById('cover-preview');
                    const container = document.getElementById('cover-preview-container');
                    if (preview && container) {
                        preview.src = URL.createObjectURL(file);
                        container.classList.remove('d-none');
                    }
                }
            });
        }
    </script>
}
