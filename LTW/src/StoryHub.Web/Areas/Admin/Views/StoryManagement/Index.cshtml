@model PaginatedList<StoryDto>
@{
    ViewData["Title"] = "Quản lý Truyện";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản lý Truyện</h3>
        <p class="text-muted small mb-0">Chỉ Quản trị viên (Admin) mới có quyền đăng và quản trị truyện</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>Đăng truyện mới
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Tìm tên truyện hoặc tác giả..." value="@ViewData["Search"]" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="@StoryStatus.Published" selected="@((StoryStatus?)ViewData["Status"] == StoryStatus.Published)">Xuất bản</option>
                <option value="@StoryStatus.Draft" selected="@((StoryStatus?)ViewData["Status"] == StoryStatus.Draft)">Bản nháp</option>
                <option value="@StoryStatus.Removed" selected="@((StoryStatus?)ViewData["Status"] == StoryStatus.Removed)">Đã gỡ (Vi phạm)</option>
                <option value="@StoryStatus.Hidden" selected="@((StoryStatus?)ViewData["Status"] == StoryStatus.Hidden)">Đang ẩn</option>
                <option value="@StoryStatus.Completed" selected="@((StoryStatus?)ViewData["Status"] == StoryStatus.Completed)">Hoàn thành</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Lọc dữ liệu</button>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 50px;">Bìa</th>
                    <th>Tiêu đề truyện</th>
                    <th>Tác giả</th>
                    <th>Chương</th>
                    <th>Lượt xem</th>
                    <th>Điểm</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy truyện nào.</td>
                    </tr>
                }
                @foreach (var story in Model.Items)
                {
                    <tr class="@(story.Status == StoryStatus.Removed ? "table-danger bg-opacity-10" : "")">
                        <td>
                            <img src="@(string.IsNullOrEmpty(story.CoverImageUrl) ? "/images/default-cover.webp" : story.CoverImageUrl)" 
                                 class="rounded" width="40" height="55" style="object-fit: cover;" 
                                 onerror="this.onerror=null; this.src='/images/default-cover.webp';" />
                        </td>
                        <td>
                            <div class="fw-bold">@story.Title</div>
                            <small class="text-muted">Slug: @story.Slug</small>
                        </td>
                        <td class="small">@story.AuthorName</td>
                        <td>
                            <a asp-controller="ChapterManagement" asp-action="Index" asp-route-storyId="@story.Id" class="badge bg-primary-subtle text-primary text-decoration-none p-2">
                                <i class="bi bi-file-earmark-text me-1"></i>@story.ChapterCount chương
                            </a>
                        </td>
                        <td class="small">@story.ViewCount.ToString("N0")</td>
                        <td class="small text-warning fw-bold">
                            <i class="bi bi-star-fill me-1"></i>@story.AverageRating.ToString("F1")
                        </td>
                        <td>
                            @if (story.Status == StoryStatus.Published)
                            {
                                <span class="badge bg-success">Xuất bản</span>
                            }
                            else if (story.Status == StoryStatus.Removed)
                            {
                                <span class="badge bg-danger">Đã gỡ bỏ</span>
                            }
                            else if (story.Status == StoryStatus.Draft)
                            {
                                <span class="badge bg-secondary">Bản nháp</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@story.Status</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@story.Id" class="btn btn-outline-secondary" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-controller="ChapterManagement" asp-action="Index" asp-route-storyId="@story.Id" class="btn btn-outline-primary" title="Quản lý chương">
                                    <i class="bi bi-list-ol"></i>
                                </a>
                                @if (story.Status == StoryStatus.Removed)
                                {
                                    <form asp-action="Restore" asp-route-id="@story.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn khôi phục truyện này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-success" title="Khôi phục truyện">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-warning" title="Gỡ truyện (Nhập lý do)" onclick="openRemoveModal(@story.Id, '@story.Title')">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                }
                                <form asp-action="Delete" asp-route-id="@story.Id" method="post" class="d-inline" onsubmit="return confirm('Chuyển truyện vào thùng rác?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Xóa mềm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-body border-top py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Trang @Model.PageIndex / @Model.TotalPages (Tổng cộng @Model.TotalCount truyện)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-search="@ViewData["Search"]" asp-route-status="@ViewData["Status"]">Trước</a>
                </li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-search="@ViewData["Search"]" asp-route-status="@ViewData["Status"]">Sau</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Modal Gỡ Truyện (Bắt buộc nhập lý do) -->
<div class="modal fade" id="removeStoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold text-danger"><i class="bi bi-slash-circle me-2"></i>Gỡ bỏ truyện vi phạm</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Remove" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="storyId" id="remove-story-id" value="" />
                    <p class="small text-muted mb-3">
                        Truyện: <strong id="remove-story-title"></strong> sẽ không còn xuất hiện công khai trên website. Quản trị viên vẫn có thể xem và khôi phục khi cần.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Lý do gỡ bỏ truyện (Bắt buộc):</label>
                        <textarea class="form-control" name="removalReason" rows="3" placeholder="Nhập chi tiết lý do gỡ bỏ (Tối thiểu 5 ký tự)..." required minlength="5" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger btn-sm">Xác nhận Gỡ truyện</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRemoveModal(storyId, storyTitle) {
            document.getElementById('remove-story-id').value = storyId;
            document.getElementById('remove-story-title').textContent = storyTitle;
            new bootstrap.Modal(document.getElementById('removeStoryModal')).show();
        }
    </script>
}
