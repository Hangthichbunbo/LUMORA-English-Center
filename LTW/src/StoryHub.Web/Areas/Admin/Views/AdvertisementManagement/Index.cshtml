@model PaginatedList<CreateOrUpdateAdDto>
@{
    ViewData["Title"] = "Quản lý Quảng cáo";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản lý Quảng cáo</h3>
        <p class="text-muted small mb-0">Cấu hình banner, text link và nội dung HTML an toàn tại các vị trí</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>Thêm chiến dịch quảng cáo
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Tên quảng cáo</th>
                    <th>Vị trí</th>
                    <th>Định dạng</th>
                    <th>Thời hạn</th>
                    <th>Ưu tiên</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có quảng cáo nào.</td></tr>
                }
                @foreach (var ad in Model.Items)
                {
                    var isExpired = ad.EndAt < DateTimeOffset.UtcNow;
                    <tr class="@(isExpired ? "opacity-50" : "")">
                        <td>
                            <div class="fw-bold">@ad.Name</div>
                            <small class="text-muted text-truncate d-block" style="max-width: 250px;">URL: @(string.IsNullOrEmpty(ad.DestinationUrl) ? "Nội bộ" : ad.DestinationUrl)</small>
                        </td>
                        <td><span class="badge bg-primary-subtle text-primary">@ad.Placement</span></td>
                        <td><span class="badge bg-secondary-subtle text-secondary">@ad.AdType</span></td>
                        <td class="small">
                            <div>@ad.StartAt.ToString("dd/MM/yyyy") - @ad.EndAt.ToString("dd/MM/yyyy")</div>
                            @if (isExpired)
                            {
                                <span class="badge bg-danger-subtle text-danger">Đã hết hạn</span>
                            }
                        </td>
                        <td class="fw-bold text-center">@ad.Priority</td>
                        <td>
                            <form asp-action="Toggle" asp-route-id="@ad.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(ad.IsEnabled ? "btn-success" : "btn-secondary") py-0 px-2" style="font-size: 0.75rem;">
                                    @(ad.IsEnabled ? "Đang bật" : "Đã tắt")
                                </button>
                            </form>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@ad.Id" class="btn btn-outline-secondary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@ad.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa quảng cáo này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
