@model StoryHub.Web.Areas.Admin.ViewModels.UserManagementIndexViewModel
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Người dùng & Tài khoản</h3>
        <p class="text-muted small mb-0">Quản lý kích hoạt tài khoản, vai trò phân quyền và hạn chế quyền bình luận của người dùng</p>
    </div>
    @if (Model.IsCurrentSeedAdmin)
    {
        <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createAdminModal">
            <i class="bi bi-person-plus-fill me-1"></i>Cấp tài khoản Admin mới
        </button>
    }
</div>

@if (Model.IsCurrentSeedAdmin)
{
    <div class="alert alert-primary d-flex align-items-center justify-content-between p-3 rounded-3 shadow-sm mb-4 border-0">
        <div class="d-flex align-items-center">
            <div class="fs-4 me-3 text-primary">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <strong>Đặc quyền Quản trị viên tối cao (Seed Setting):</strong>
                <div class="small text-secondary">
                    Tài khoản hiện tại khớp với cấu hình <code>@Model.SeedAdminEmail</code>. Bạn có toàn quyền cấp quyền Admin, tạo tài khoản Admin hoặc xóa tài khoản Admin.
                </div>
            </div>
        </div>
        <span class="badge bg-primary px-3 py-2">SuperAdmin Mode</span>
    </div>
}

<!-- Search -->
<div class="card border-0 shadow-sm p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Tìm theo email hoặc tên hiển thị..." value="@Model.Search" />
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa bộ lọc</a>
            </div>
        }
    </form>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Tên hiển thị</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Quyền bình luận</th>
                    <th>Ngày đăng ký</th>
                    <th>Lần đăng nhập cuối</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted">Không tìm thấy người dùng nào.</td></tr>
                }
                @foreach (var item in Model.Users.Items)
                {
                    var user = item.User;
                    var isCommentBlocked = user.CommentBlockedUntil.HasValue && user.CommentBlockedUntil.Value > DateTimeOffset.UtcNow;
                    var isAdmin = item.Roles.Contains("Admin");
                    var isMod = item.Roles.Contains("Moderator");

                    <tr>
                        <td>
                            <div class="fw-bold">@user.DisplayName</div>
                            <small class="text-muted" style="font-size: 0.75rem;">Id: @user.Id</small>
                        </td>
                        <td class="small">@user.Email</td>
                        <td>
                            @if (item.IsSeedAdmin)
                            {
                                <span class="badge bg-danger shadow-sm" title="Tài khoản Quản trị tối cao (SeedSetting)">
                                    <i class="bi bi-award-fill me-1"></i>Seed Admin
                                </span>
                            }
                            else if (isAdmin)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                    <i class="bi bi-shield-fill me-1"></i>Admin
                                </span>
                            }
                            else if (isMod)
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                    <i class="bi bi-person-badge-fill me-1"></i>Moderator
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">
                                    Thành viên
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                @(user.IsActive ? "Hoạt động" : "Bị khóa")
                            </span>
                        </td>
                        <td>
                            @if (isCommentBlocked)
                            {
                                <span class="badge bg-warning text-dark" title="Đến: @user.CommentBlockedUntil!.Value.ToString("dd/MM/yyyy HH:mm")">
                                    <i class="bi bi-slash-circle me-1"></i>Bị khóa đến @user.CommentBlockedUntil.Value.ToString("dd/MM")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">Bình thường</span>
                            }
                        </td>
                        <td class="small text-muted">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="small text-muted">@(user.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                @if (Model.IsCurrentSeedAdmin && !item.IsSeedAdmin)
                                {
                                    @if (!isAdmin)
                                    {
                                        <form asp-action="GrantAdmin" asp-route-userId="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn CẤP QUYỀN ADMIN cho tài khoản @user.DisplayName (@user.Email)?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-primary" title="Cấp quyền Admin">
                                                <i class="bi bi-shield-plus"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="RevokeAdmin" asp-route-userId="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn THU HỒI QUYỀN ADMIN của @user.DisplayName (@user.Email)?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Thu hồi quyền Admin">
                                                <i class="bi bi-shield-minus"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteAdmin" asp-route-userId="@user.Id" method="post" class="d-inline" onsubmit="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn XÓA VĨNH VIỄN tài khoản Admin @user.DisplayName (@user.Email)? Thao tác này không thể hoàn tác!');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa tài khoản Admin">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                }

                                @if (!item.IsSeedAdmin)
                                {
                                    <form asp-action="ToggleActive" asp-route-userId="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn thay đổi trạng thái hoạt động của tài khoản này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(user.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                            <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-secondary" title="Khóa quyền bình luận" onclick="openBlockModal('@user.Id', '@user.DisplayName')">
                                        <i class="bi bi-chat-square-dots"></i>
                                    </button>
                                    @if (!isAdmin)
                                    {
                                        <form asp-action="DeleteUser" asp-route-userId="@user.Id" method="post" class="d-inline" onsubmit="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn XÓA VĨNH VIỄN tài khoản người dùng @user.DisplayName (@user.Email)? Thao tác này sẽ dọn sạch toàn bộ dữ liệu bình luận, đánh giá liên quan và KHÔNG THỂ HOÀN TÁC!');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa vĩnh viễn người dùng">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-muted d-inline-flex align-items-center" title="Tài khoản bảo vệ không thể khóa hoặc xóa">
                                        <i class="bi bi-shield-lock-fill me-1"></i>Bảo vệ
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Users.TotalPages > 1)
    {
        <div class="card-footer bg-body border-top py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">Trang @Model.Users.PageIndex / @Model.Users.TotalPages (Tổng @Model.Users.TotalCount người dùng)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.Users.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.Users.PageIndex - 1)" asp-route-search="@Model.Search">Trước</a>
                </li>
                <li class="page-item @(Model.Users.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageIndex="@(Model.Users.PageIndex + 1)" asp-route-search="@Model.Search">Sau</a>
                </li>
            </ul>
        </div>
    }
</div>

@if (Model.IsCurrentSeedAdmin)
{
    <!-- Modal Tạo / Cấp tài khoản Admin mới -->
    <div class="modal fade" id="createAdminModal" tabindex="-1" aria-labelledby="createAdminModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h6 class="modal-title fw-bold" id="createAdminModalLabel">
                        <i class="bi bi-shield-plus me-2"></i>Cấp tài khoản Quản trị viên (Admin)
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateAdmin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="alert alert-info small mb-3">
                            <i class="bi bi-info-circle-fill me-1"></i>Nếu email đã tồn tại trong hệ thống, hệ thống sẽ tự động nâng cấp tài khoản đó lên <strong>Admin</strong>. Nếu chưa tồn tại, tài khoản mới sẽ được tạo với quyền Admin.
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Địa chỉ Email (*)</label>
                            <input type="email" name="Email" class="form-control" placeholder="admin2@truyenvietsub.vn" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Tên hiển thị (*)</label>
                            <input type="text" name="DisplayName" class="form-control" placeholder="Quản trị viên phụ trách" required maxlength="50" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Mật khẩu (*)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" name="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" required minlength="6" />
                                <button type="button" class="btn btn-outline-secondary toggle-password-btn" title="Hiện mật khẩu" aria-label="Hiện mật khẩu" tabindex="-1">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-check-lg me-1"></i>Xác nhận Cấp quyền Admin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Khóa quyền bình luận -->
<div class="modal fade" id="blockCommentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold text-danger"><i class="bi bi-slash-circle me-2"></i>Khóa quyền bình luận</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="BlockComment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="userId" id="block-user-id" />
                    <p class="small text-muted mb-3">Người dùng: <strong id="block-user-name"></strong></p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Thời hạn khóa tính năng bình luận:</label>
                        <select name="days" class="form-select">
                            <option value="1">1 ngày</option>
                            <option value="3">3 ngày</option>
                            <option value="7" selected>7 ngày</option>
                            <option value="30">30 ngày</option>
                            <option value="0">Vĩnh viễn</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger btn-sm">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openBlockModal(id, name) {
            document.getElementById('block-user-id').value = id;
            document.getElementById('block-user-name').textContent = name;
            new bootstrap.Modal(document.getElementById('blockCommentModal')).show();
        }
    </script>
}
