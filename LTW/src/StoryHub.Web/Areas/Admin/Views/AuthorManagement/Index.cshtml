@model List<AuthorDto>
@{
    ViewData["Title"] = "Quản lý Tác giả";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản lý Tác giả</h3>
        <p class="text-muted small mb-0">Danh sách tác giả các bộ truyện trên hệ thống</p>
    </div>
    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createAuthorModal">
        <i class="bi bi-plus-lg me-1"></i>Thêm tác giả
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 60px;">Id</th>
                    <th>Tên tác giả</th>
                    <th>Slug</th>
                    <th>Tiểu sử</th>
                    <th>Số truyện</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="small text-muted">@a.Id</td>
                        <td class="fw-bold text-primary">@a.Name</td>
                        <td class="small text-muted">@a.Slug</td>
                        <td class="small text-muted" style="max-width: 380px;">@a.Biography</td>
                        <td class="small fw-semibold">@a.StoryCount bộ</td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" onclick="openEditAuthorModal(@a.Id, '@a.Name', '@a.Slug', '@a.Biography')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa tác giả này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Tác Giả -->
<div class="modal fade" id="createAuthorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Thêm tác giả mới</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên tác giả (*)</label>
                        <input type="text" name="Name" id="create-author-name" class="form-control" required maxlength="150" placeholder="Ví dụ: Nam Cao, Tiêu Đỉnh..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Slug tác giả (*)</label>
                        <div class="input-group">
                            <input type="text" name="Slug" id="create-author-slug" class="form-control" required maxlength="160" placeholder="nam-cao, tieu-dinh..." />
                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('create-author-slug').value = convertToSlug(document.getElementById('create-author-name').value);" title="Tự động tạo slug">
                                <i class="bi bi-magic"></i>
                            </button>
                        </div>
                        <small class="text-muted" style="font-size: 0.8rem;">Tự động sinh từ tên tác giả, có thể chỉnh sửa tùy ý.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tiểu sử</label>
                        <textarea name="Biography" class="form-control" rows="3" maxlength="3000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm">Thêm tác giả</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Tác Giả -->
<div class="modal fade" id="editAuthorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">Chỉnh sửa tác giả</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="edit-author-id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên tác giả (*)</label>
                        <input type="text" name="Name" id="edit-author-name" class="form-control" required maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Slug (*)</label>
                        <div class="input-group">
                            <input type="text" name="Slug" id="edit-author-slug" class="form-control" required maxlength="160" />
                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('edit-author-slug').value = convertToSlug(document.getElementById('edit-author-name').value);" title="Tự động tạo lại slug theo tên mới">
                                <i class="bi bi-magic"></i>
                            </button>
                        </div>
                        <small class="text-muted" style="font-size: 0.8rem;">Tự động cập nhật khi đổi tên tác giả, hoặc bấm nút đũa thần để làm mới.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tiểu sử</label>
                        <textarea name="Biography" id="edit-author-bio" class="form-control" rows="3" maxlength="3000"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function convertToSlug(str) {
            if (!str) return '';
            return str.toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[đĐ]/g, 'd')
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
        }

        // Tự động tạo slug khi thêm mới tác giả
        const createAuthorName = document.getElementById('create-author-name');
        const createAuthorSlug = document.getElementById('create-author-slug');
        if (createAuthorName && createAuthorSlug) {
            createAuthorName.addEventListener('input', function () {
                createAuthorSlug.value = convertToSlug(this.value);
            });
        }

        // Tự động cập nhật slug khi sửa tên tác giả
        const editAuthorName = document.getElementById('edit-author-name');
        const editAuthorSlug = document.getElementById('edit-author-slug');
        if (editAuthorName && editAuthorSlug) {
            editAuthorName.addEventListener('input', function () {
                editAuthorSlug.value = convertToSlug(this.value);
            });
        }

        function openEditAuthorModal(id, name, slug, bio) {
            document.getElementById('edit-author-id').value = id;
            document.getElementById('edit-author-name').value = name;
            document.getElementById('edit-author-slug').value = slug;
            document.getElementById('edit-author-bio').value = bio;
            new bootstrap.Modal(document.getElementById('editAuthorModal')).show();
        }
    </script>
}
