@model List<ChapterDto>
@{
    ViewData["Title"] = "Quản lý chương: " + ViewBag.StoryTitle;
    int storyId = ViewBag.StoryId;
    string storyTitle = ViewBag.StoryTitle;
    string storySlug = ViewBag.StorySlug;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1">Quản lý chương: @storyTitle</h3>
        <p class="text-muted small mb-0">Tổng cộng @Model.Count chương đã được thêm vào bộ truyện này</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-storyId="@storyId" class="btn btn-primary btn-sm px-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Thêm chương mới
        </a>
        <a asp-controller="StoryManagement" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Về danh sách truyện
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 100px;">Số chương</th>
                    <th>Tiêu đề chương</th>
                    <th>Slug</th>
                    <th>Lượt xem</th>
                    <th>Trạng thái</th>
                    <th>Ngày phát hành</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Chưa có chương nào. Hãy thêm chương đầu tiên!</td>
                    </tr>
                }
                @foreach (var ch in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">Chương @ch.FormattedChapterNumber</td>
                        <td class="fw-semibold">@ch.Title</td>
                        <td class="small text-muted">@ch.Slug</td>
                        <td class="small">@ch.ViewCount.ToString("N0")</td>
                        <td>
                            @if (ch.PublishStatus == PublishStatus.Published)
                            {
                                <span class="badge bg-success">Xuất bản</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@ch.PublishStatus</span>
                            }
                        </td>
                        <td class="small text-muted">@(ch.PublishedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa")</td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <a asp-area="" asp-controller="Chapter" asp-action="Read" 
                                   asp-route-storySlug="@storySlug" 
                                   asp-route-chapterNumber="@ch.FormattedChapterNumber" 
                                   asp-route-chapterSlug="@ch.Slug" 
                                   target="_blank" class="btn btn-outline-info" title="Xem trước trên web">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@ch.Id" class="btn btn-outline-secondary" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@ch.Id" asp-route-storyId="@storyId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa chương này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger" title="Xóa mềm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
