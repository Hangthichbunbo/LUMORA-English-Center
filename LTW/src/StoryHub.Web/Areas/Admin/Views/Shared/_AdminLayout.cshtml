@inject Microsoft.AspNetCore.Identity.UserManager<StoryHub.Domain.Entities.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TruyenVietSub Quản Trị</title>
    <!-- Browser Tab Icon (Favicon Cache Busted) -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --admin-sidebar-width: 260px;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bs-body-tertiary);
        }
        .admin-sidebar {
            width: var(--admin-sidebar-width);
            height: 100vh;
            max-height: 100vh;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1000;
            background-color: #1e1e2d;
            color: #a2a3b7;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .admin-sidebar-header {
            flex-shrink: 0;
            padding: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .admin-sidebar-body {
            flex: 1 1 auto;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 1rem 0;
        }
        .admin-sidebar-body::-webkit-scrollbar {
            width: 5px;
        }
        .admin-sidebar-body::-webkit-scrollbar-track {
            background: #1e1e2d;
        }
        .admin-sidebar-body::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }
        .admin-sidebar-body::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.35);
        }
        .admin-sidebar-footer {
            flex-shrink: 0;
            padding: 0.85rem 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            background-color: #1a1a27;
        }
        .admin-sidebar .nav-link {
            color: #a2a3b7;
            padding: 0.75rem 1.25rem;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            border-radius: 0.375rem;
            margin: 0.15rem 0.75rem;
            transition: background 0.2s, color 0.2s;
        }
        .admin-sidebar .nav-link:hover,
        .admin-sidebar .nav-link.active {
            color: #ffffff;
            background-color: #2b2b40;
        }
        .admin-sidebar .nav-link i {
            font-size: 1.15rem;
            margin-right: 0.75rem;
        }
        .admin-main {
            margin-left: var(--admin-sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-topbar {
            height: 60px;
            background-color: var(--bs-body-bg);
            border-bottom: 1px solid var(--bs-border-color);
            position: sticky;
            top: 0;
            z-index: 999;
        }
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                margin-left: calc(-1 * var(--admin-sidebar-width));
            }
            .admin-sidebar.show {
                margin-left: 0;
            }
            .admin-main {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="admin-sidebar-header d-flex align-items-center justify-content-between">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-white text-decoration-none fw-bold fs-5 d-flex align-items-center">
                <i class="bi bi-book-half text-white me-2 fs-5"></i>
                <span>TruyenVietSub Admin</span>
            </a>
            <button class="btn btn-sm btn-link text-white-50 d-lg-none p-0" type="button" onclick="document.getElementById('adminSidebar').classList.remove('show')" title="Đóng menu">
                <i class="bi bi-x-lg fs-5"></i>
            </button>
        </div>
        <div class="admin-sidebar-body">
            <div class="px-3 pb-2 text-uppercase small text-secondary fw-semibold" style="font-size: 0.75rem;">Hệ thống & Thống kê</div>
            <ul class="nav flex-column mb-3">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill text-primary"></i>Dashboard
                    </a>
                </li>
            </ul>

            <div class="px-3 pb-2 text-uppercase small text-secondary fw-semibold" style="font-size: 0.75rem;">Quản lý Truyện & Nội dung</div>
            <ul class="nav flex-column mb-3">
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StoryManagement" ? "active" : "")" asp-area="Admin" asp-controller="StoryManagement" asp-action="Index">
                            <i class="bi bi-book-fill text-warning"></i>Quản lý Truyện
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CategoryManagement" ? "active" : "")" asp-area="Admin" asp-controller="CategoryManagement" asp-action="Index">
                            <i class="bi bi-tags-fill text-info"></i>Quản lý Thể loại
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuthorManagement" ? "active" : "")" asp-area="Admin" asp-controller="AuthorManagement" asp-action="Index">
                            <i class="bi bi-pen-fill text-success"></i>Quản lý Tác giả
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TrashManagement" ? "active" : "")" asp-area="Admin" asp-controller="TrashManagement" asp-action="Index">
                            <i class="bi bi-trash3-fill text-danger"></i>Thùng rác
                        </a>
                    </li>
                }
            </ul>

            <div class="px-3 pb-2 text-uppercase small text-secondary fw-semibold" style="font-size: 0.75rem;">Kiểm duyệt & Tương tác</div>
            <ul class="nav flex-column mb-3">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CommentModeration" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-area="Admin" asp-controller="CommentModeration" asp-action="Index">
                        <i class="bi bi-chat-left-dots-fill text-primary"></i>Kiểm duyệt Bình luận
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CommentModeration" && ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")" asp-area="Admin" asp-controller="CommentModeration" asp-action="Reports">
                        <i class="bi bi-flag-fill text-danger"></i>Báo cáo vi phạm
                    </a>
                </li>
            </ul>

            @if (User.IsInRole("Admin"))
            {
                <div class="px-3 pb-2 text-uppercase small text-secondary fw-semibold" style="font-size: 0.75rem;">Quản trị & Giám sát</div>
                <ul class="nav flex-column mb-3">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdvertisementManagement" ? "active" : "")" asp-area="Admin" asp-controller="AdvertisementManagement" asp-action="Index">
                            <i class="bi bi-badge-ad-fill text-warning"></i>Quản lý Quảng cáo
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserManagement" ? "active" : "")" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                            <i class="bi bi-people-fill text-info"></i>Người dùng & Khóa
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLog" ? "active" : "")" asp-area="Admin" asp-controller="AuditLog" asp-action="Index">
                            <i class="bi bi-journal-text text-danger"></i>Audit Log (Nhật ký)
                        </a>
                    </li>
                </ul>
            }

        </div>
        <div class="admin-sidebar-footer">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-light w-100">
                <i class="bi bi-box-arrow-up-right me-1"></i>Xem Website Đọc Truyện
            </a>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="admin-main">
        <!-- Topbar -->
        <header class="admin-topbar px-4 d-flex align-items-center justify-content-between">
            <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                <i class="bi bi-list fs-5"></i>
            </button>
            <div class="d-none d-lg-block fw-semibold text-secondary">
                Hệ thống Quản trị TruyenVietSub
            </div>

            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary rounded-circle" id="theme-toggle-btn" title="Chuyển chế độ sáng/tối" style="width: 32px; height: 32px; padding: 0;">
                    <i class="bi bi-moon-stars-fill" id="theme-icon"></i>
                </button>

                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : "bg-warning text-dark")">
                        @(User.IsInRole("Admin") ? "Admin" : "Moderator")
                    </span>
                    @{
                        var adminDisplayName = User.FindFirst("DisplayName")?.Value;
                        if (string.IsNullOrWhiteSpace(adminDisplayName))
                        {
                            var currentAdmin = await UserManager.GetUserAsync(User);
                            adminDisplayName = currentAdmin?.DisplayName;
                        }
                        if (string.IsNullOrWhiteSpace(adminDisplayName))
                        {
                            var rawName = User.Identity?.Name ?? string.Empty;
                            adminDisplayName = rawName.Contains('@') ? rawName.Split('@')[0] : rawName;
                        }
                    }
                    <span class="fw-bold small">@adminDisplayName</span>
                </div>

                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </header>

        <!-- Body -->
        <main class="p-4 flex-grow-1">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
