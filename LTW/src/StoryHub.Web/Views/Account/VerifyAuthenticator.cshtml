@model VerifyAuthenticatorViewModel
@{
    ViewData["Title"] = "Xác minh Google Authenticator";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-10">
            <div class="card border-0 shadow rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="display-5 text-primary mb-2">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 mb-2 rounded-pill small">
                        Bước 2 / 2: Bảo mật tài khoản
                    </span>
                    <h4 class="fw-bold">Xác minh Google Authenticator</h4>
                    <p class="text-muted small mb-1">Thiết lập mã xác thực 2 bước (TOTP) cho tài khoản:</p>
                    <span class="badge bg-light text-dark border px-3 py-1 font-monospace">@Model.Email</span>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger small p-3 mb-3 rounded-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["ErrorMessage"]
                    </div>
                }

                <div class="alert alert-info small p-3 rounded-3 mb-4">
                    <div class="fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i>Hướng dẫn kích hoạt:</div>
                    <ol class="mb-0 ps-3">
                        <li class="mb-1">Cài đặt ứng dụng <strong>Google Authenticator</strong> từ App Store hoặc Google Play.</li>
                        <li class="mb-1">Mở ứng dụng, chọn biểu tượng dấu <strong>+</strong> và chọn <strong>Quét mã QR</strong>.</li>
                        <li class="mb-1"><strong>Lưu ý:</strong> Ứng dụng sẽ tạo mã xác thực có tên nhãn là <strong>TruyenVietSub</strong>. Hãy chọn đúng mã này khi nhập (nếu app lưu nhiều mã khác nhau).</li>
                        <li>Nhập mã 6 chữ số hiển thị trên ứng dụng vào ô xác nhận bên dưới để hoàn tất.</li>
                    </ol>
                </div>

                <!-- QR Code Box -->
                <div class="text-center mb-4">
                    <div class="p-3 bg-white border rounded-3 shadow-sm d-inline-block">
                        <div id="qrcode" class="d-flex justify-content-center align-items-center" style="width: 180px; height: 180px;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Đang tải mã QR...</span>
                            </div>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">Quét mã QR trên màn hình bằng ứng dụng</div>
                </div>

                <!-- Manual Setup Key Fallback -->
                <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-muted">Không thể quét mã? Nhập khóa thủ công:</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" id="btnCopyKey" title="Sao chép khóa bí mật">
                            <i class="bi bi-clipboard me-1"></i><span id="copyText">Sao chép</span>
                        </button>
                    </div>
                    <div class="font-monospace fw-bold text-break text-center p-2 bg-white rounded border border-dashed select-all" id="secretKeyText">
                        @Model.FormattedKey
                    </div>
                    <div class="form-text small text-muted text-center mt-1">Loại khóa: Theo thời gian (Time-based / TOTP)</div>
                </div>

                <!-- Verification Form -->
                <form asp-action="VerifyAuthenticator" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SetupToken" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                    <div class="mb-4 text-center">
                        <label asp-for="Code" class="form-label small fw-bold mb-2">Nhập mã xác thực 6 số</label>
                        <div class="d-flex justify-content-center">
                            <input asp-for="Code" 
                                   class="form-control form-control-lg text-center fw-bold font-monospace" 
                                   style="max-width: 240px; font-size: 1.8rem; letter-spacing: 0.35em;" 
                                   placeholder="000000" 
                                   maxlength="6" 
                                   pattern="\d{6}" 
                                   inputmode="numeric" 
                                   autocomplete="one-time-code" 
                                   autofocus />
                        </div>
                        <span asp-validation-for="Code" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i>Xác minh & Kích hoạt tài khoản
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3 small text-muted">
                    Gặp sự cố khi thiết lập? <a asp-action="Register" class="text-decoration-none">Đăng ký lại từ đầu</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Generate QR Code
            var qrContainer = document.getElementById('qrcode');
            if (qrContainer) {
                qrContainer.innerHTML = '';
                new QRCode(qrContainer, {
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AuthenticatorUri)),
                    width: 180,
                    height: 180,
                    colorDark: "#000000",
                    colorLight: "#ffffff",
                    correctLevel: QRCode.CorrectLevel.M
                });
            }

            // Copy Key Button
            var copyBtn = document.getElementById('btnCopyKey');
            var rawKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SharedKey));
            if (copyBtn && rawKey) {
                copyBtn.addEventListener('click', function () {
                    navigator.clipboard.writeText(rawKey).then(function () {
                        var copyText = document.getElementById('copyText');
                        if (copyText) {
                            copyText.textContent = 'Đã sao chép!';
                            setTimeout(function () {
                                copyText.textContent = 'Sao chép';
                            }, 2000);
                        }
                    }).catch(function () {
                        // Fallback selection
                        var el = document.getElementById('secretKeyText');
                        if (el) {
                            var range = document.createRange();
                            range.selectNodeContents(el);
                            var sel = window.getSelection();
                            sel.removeAllRanges();
                            sel.addRange(range);
                        }
                    });
                });
            }
        });
    </script>
}

