@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-sm-8">
            <div class="card border-0 shadow rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="display-5 text-primary mb-2">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h4 class="fw-bold">Tạo tài khoản mới</h4>
                    <p class="text-muted small">Khám phá và lưu trữ các bộ truyện yêu thích</p>
                </div>

                <form asp-action="Register" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label small fw-bold">Tên hiển thị (Biệt danh, tối đa 15 ký tự)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="DisplayName" class="form-control" placeholder="Ví dụ: Độc Cô Cầu Bại" maxlength="15" autofocus />
                        </div>
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Địa chỉ Email Google (@@gmail.com)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="ten-tai-khoan@gmail.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text small text-muted">Hệ thống chỉ chấp nhận tài khoản Google (@@gmail.com hoặc @@googlemail.com).</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input type="password" asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự (hỗ trợ chữ, số và ký tự đặc biệt)" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn" title="Hiện mật khẩu" aria-label="Hiện mật khẩu" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold">Xác nhận mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-check2-circle"></i></span>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn" title="Hiện mật khẩu" aria-label="Hiện mật khẩu" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CaptchaCode" class="form-label small fw-bold">
                            Mã xác nhận <span class="text-danger">*</span>
                        </label>
                        <div class="small text-muted mb-2">Vui lòng nhập văn bản vào bên dưới</div>

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="captcha-img-wrapper border rounded-3 p-1 bg-white d-inline-flex align-items-center justify-content-center shadow-sm position-relative overflow-hidden" 
                                 id="captchaContainer"
                                 style="min-width: 170px; height: 54px; cursor: pointer;" 
                                 title="Nhấn vào hình để đổi mã khác">
                                <img id="captchaImage" 
                                     src="/dang-ky/captcha" 
                                     alt="Mã xác nhận" 
                                     style="height: 48px; width: 162px; object-fit: contain; user-select: none;" />
                            </div>
                            <button type="button" 
                                    id="btnRefreshCaptcha" 
                                    class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 py-2 px-3 rounded-3" 
                                    title="Đổi mã xác nhận khác">
                                <i class="bi bi-arrow-clockwise fs-5"></i>
                                <span class="d-none d-sm-inline small">Đổi mã</span>
                            </button>
                        </div>

                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="CaptchaCode" 
                                   class="form-control" 
                                   placeholder="Nhập mã xác nhận..." 
                                   autocomplete="off" 
                                   maxlength="10" />
                        </div>
                        <span asp-validation-for="CaptchaCode" class="text-danger small"></span>
                        <div class="form-text small text-muted">Không phân biệt chữ hoa, chữ thường.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-shield-lock-fill me-1"></i>Tiếp tục thiết lập Google Authenticator
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3 small text-muted">
                    Đã có tài khoản? <a asp-action="Login" class="fw-bold text-decoration-none">Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .captcha-img-wrapper:hover {
            border-color: #0d6efd !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15) !important;
        }
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spin-once {
            animation: spin 0.5s ease;
        }
    </style>
    <script>
        function refreshCaptcha() {
            var img = document.getElementById('captchaImage');
            if (img) {
                img.src = '/dang-ky/captcha?t=' + new Date().getTime();
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var refreshBtn = document.getElementById('btnRefreshCaptcha');
            var captchaContainer = document.getElementById('captchaContainer');

            if (refreshBtn) {
                refreshBtn.addEventListener('click', function () {
                    var icon = refreshBtn.querySelector('i');
                    if (icon) {
                        icon.classList.add('spin-once');
                        setTimeout(function () { icon.classList.remove('spin-once'); }, 500);
                    }
                    refreshCaptcha();
                });
            }

            if (captchaContainer) {
                captchaContainer.addEventListener('click', function () {
                    var icon = document.querySelector('#btnRefreshCaptcha i');
                    if (icon) {
                        icon.classList.add('spin-once');
                        setTimeout(function () { icon.classList.remove('spin-once'); }, 500);
                    }
                    refreshCaptcha();
                });
            }
        });
    </script>
}
