@model PaginatedList<StoryDto>
@{
    ViewData["Title"] = "Lịch sử đọc truyện";
}

<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile">Tài khoản</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lịch sử đọc truyện</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm p-4">
        <h4 class="fw-bold mb-3 border-bottom pb-2 text-info">
            <i class="bi bi-clock-history me-2"></i>Lịch sử đọc gần đây (@Model.TotalCount bộ truyện)
        </h4>

        @if (Model.Items.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-x display-4 d-block mb-3 opacity-50"></i>
                Chưa có lịch sử đọc truyện nào được ghi nhận.
                <div class="mt-3">
                    <a asp-controller="Story" asp-action="Index" class="btn btn-primary btn-sm">Bắt đầu đọc truyện</a>
                </div>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var story in Model.Items)
                {
                    <div class="list-group-item d-flex align-items-center justify-content-between py-3 border-bottom">
                        <div class="d-flex align-items-center">
                            <img src="@(string.IsNullOrEmpty(story.CoverImageUrl) ? "/images/default-cover.webp" : story.CoverImageUrl)" 
                                 class="rounded me-3" width="50" height="70" style="object-fit: cover;" alt="@story.Title"
                                 onerror="this.onerror=null; this.src='/images/default-cover.webp';" />
                            <div>
                                <h6 class="mb-1 fw-bold">
                                    <a asp-controller="Story" asp-action="Detail" asp-route-slug="@story.Slug" class="text-decoration-none text-body">
                                        @story.Title
                                    </a>
                                </h6>
                                <small class="text-muted d-block">
                                    <i class="bi bi-person me-1"></i>Tác giả: @story.AuthorName
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>Lần đọc cuối: @story.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        </div>

                        <div>
                            <a asp-controller="Story" asp-action="Detail" asp-route-slug="@story.Slug" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-play-fill me-1"></i>Đọc tiếp
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
