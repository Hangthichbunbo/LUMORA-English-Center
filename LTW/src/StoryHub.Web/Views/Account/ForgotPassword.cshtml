@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-sm-8">
            <div class="card border-0 shadow rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="display-5 text-primary mb-2">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h4 class="fw-bold">Quên mật khẩu?</h4>
                    <p class="text-muted small">Cấp lại mật khẩu bằng mã bảo mật Google Authenticator</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger small p-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["ErrorMessage"]
                    </div>
                }

                <div class="alert alert-info small p-3 rounded-3 mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Nhập địa chỉ tài khoản Google (@("@gmail.com")) mà bạn đã dùng để đăng ký. Bạn sẽ cần mã 6 số từ Google Authenticator ở bước tiếp theo để đặt lại mật khẩu mới.
                </div>

                <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Địa chỉ Email Google</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="ten-tai-khoan@gmail.com" autofocus autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text small text-muted">Chỉ áp dụng cho tài khoản @@gmail.com hoặc @@googlemail.com.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CaptchaCode" class="form-label small fw-bold">
                            Mã xác nhận <span class="text-danger">*</span>
                        </label>
                        <div class="small text-muted mb-2">Vui lòng nhập văn bản vào bên dưới</div>

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="captcha-img-wrapper border rounded-3 p-1 bg-white d-inline-flex align-items-center justify-content-center shadow-sm position-relative overflow-hidden" 
                                 id="captchaContainer"
                                 style="min-width: 170px; height: 54px; cursor: pointer;" 
                                 title="Nhấn vào hình để đổi mã khác">
                                <img id="captchaImage" 
                                     src="/quen-mat-khau/captcha" 
                                     alt="Mã xác nhận" 
                                     style="height: 48px; width: 162px; object-fit: contain; user-select: none;" />
                            </div>
                            <button type="button" 
                                    id="btnRefreshCaptcha" 
                                    class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 py-2 px-3 rounded-3" 
                                    title="Đổi mã xác nhận khác">
                                <i class="bi bi-arrow-clockwise fs-5"></i>
                                <span class="d-none d-sm-inline small">Đổi mã</span>
                            </button>
                        </div>

                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="CaptchaCode" 
                                   class="form-control" 
                                   placeholder="Nhập mã xác nhận..." 
                                   autocomplete="off" 
                                   maxlength="10" />
                        </div>
                        <span asp-validation-for="CaptchaCode" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-arrow-right-circle me-1"></i>Tiếp tục đặt lại mật khẩu
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3 small text-muted">
                    Nhớ lại mật khẩu? <a asp-action="Login" class="fw-bold text-decoration-none">Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .captcha-img-wrapper:hover {
            border-color: #0d6efd !important;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15) !important;
        }
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spin-once {
            animation: spin 0.5s ease;
        }
    </style>
    <script>
        function refreshCaptcha() {
            var img = document.getElementById('captchaImage');
            if (img) {
                img.src = '/quen-mat-khau/captcha?t=' + new Date().getTime();
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var refreshBtn = document.getElementById('btnRefreshCaptcha');
            var captchaContainer = document.getElementById('captchaContainer');

            if (refreshBtn) {
                refreshBtn.addEventListener('click', function () {
                    var icon = refreshBtn.querySelector('i');
                    if (icon) {
                        icon.classList.add('spin-once');
                        setTimeout(function () { icon.classList.remove('spin-once'); }, 500);
                    }
                    refreshCaptcha();
                });
            }

            if (captchaContainer) {
                captchaContainer.addEventListener('click', function () {
                    var icon = document.querySelector('#btnRefreshCaptcha i');
                    if (icon) {
                        icon.classList.add('spin-once');
                        setTimeout(function () { icon.classList.remove('spin-once'); }, 500);
                    }
                    refreshCaptcha();
                });
            }
        });
    </script>
}

