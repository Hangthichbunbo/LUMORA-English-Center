@{
    ViewData["Title"] = "Xác nhận đăng ký";
    var email = ViewData["Email"] as string ?? string.Empty;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-sm-10">
            <div class="card border-0 shadow rounded-4 p-4 p-md-5 text-center">
                <div class="display-3 text-primary mb-3">
                    <i class="bi bi-envelope-check"></i>
                </div>
                <h3 class="fw-bold mb-3">Kiểm tra hộp thư của bạn</h3>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success small mb-3">
                        <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                    </div>
                }

                <p class="text-muted mb-4">
                    Chúng tôi đã gửi một liên kết xác thực đến địa chỉ:
                    <br />
                    <strong class="text-primary fs-5">@email</strong>
                </p>

                <div class="alert alert-light border text-start small mb-4 p-3 rounded-3">
                    <div class="fw-semibold mb-2"><i class="bi bi-info-circle me-1 text-primary"></i>Hướng dẫn kích hoạt:</div>
                    <ul class="mb-0 ps-3 text-muted">
                        <li class="mb-1">Mở email từ <strong>TruyenVietSub</strong> và nhấn vào nút <strong>KÍCH HOẠT TÀI KHOẢN</strong>.</li>
                        <li class="mb-1">Nếu không thấy email trong Hộp thư đến, vui lòng kiểm tra thư mục <strong>Spam / Thư rác / Quảng cáo</strong>.</li>
                        <li>Liên kết xác nhận này sẽ có hiệu lực trong vòng <strong>24 giờ</strong>.</li>
                    </ul>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mb-4">
                    <form asp-action="ResendConfirmationEmail" asp-controller="Account" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@email" />
                        <button type="submit" class="btn btn-outline-primary w-100 py-2">
                            <i class="bi bi-arrow-repeat me-1"></i>Gửi lại email xác thực
                        </button>
                    </form>
                    <a asp-action="Login" class="btn btn-primary py-2 px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đến trang Đăng nhập
                    </a>
                </div>

                <div class="border-top pt-3 small text-muted">
                    Cần trợ giúp? Liên hệ ban quản trị tại <a href="mailto:contact@truyenvietsub.vn" class="text-decoration-none">contact@truyenvietsub.vn</a>
                </div>
            </div>
        </div>
    </div>
</div>
