@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-sm-8">
            <div class="card border-0 shadow rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="display-5 text-primary mb-2">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <h4 class="fw-bold">Đăng nhập tài khoản</h4>
                    <p class="text-muted small">Chào mừng bạn quay trở lại với TruyenVietSub</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success small p-2 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger small p-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["ErrorMessage"]
                    </div>
                }

                @if (ViewData["UnconfirmedEmail"] is string unconfirmedEmail)
                {
                    <div class="alert alert-warning small p-3 rounded-3 mb-3 text-start">
                        <div class="fw-bold mb-1"><i class="bi bi-exclamation-circle-fill me-1"></i>Tài khoản chưa kích hoạt</div>
                        <p class="mb-2">Bạn cần kích hoạt email <strong>@unconfirmedEmail</strong> trước khi đăng nhập.</p>
                        <form asp-action="ResendConfirmationEmail" asp-controller="Account" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@unconfirmedEmail" />
                            <button type="submit" class="btn btn-sm btn-outline-dark fw-semibold">
                                <i class="bi bi-send me-1"></i>Gửi lại email xác thực
                            </button>
                        </form>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Địa chỉ Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input type="password" asp-for="Password" class="form-control" placeholder="Mật khẩu" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn" title="Hiện mật khẩu" aria-label="Hiện mật khẩu" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted">Ghi nhớ đăng nhập</label>
                        </div>
                        <a asp-action="ForgotPassword" class="small text-decoration-none">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3 small text-muted">
                    Chưa có tài khoản? <a asp-action="Register" class="fw-bold text-decoration-none">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
