@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Xác minh Google Authenticator - Đặt lại mật khẩu";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-sm-8">
            <div class="card border-0 shadow rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="display-5 text-primary mb-2">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 mb-2 rounded-pill small">
                        Bước 1 / 2: Xác minh bảo mật
                    </span>
                    <h4 class="fw-bold">Xác minh Google Authenticator</h4>
                    <p class="text-muted small">Nhập mã 6 chữ số từ ứng dụng để tiếp tục đặt lại mật khẩu</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger small p-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["ErrorMessage"]
                    </div>
                }

                <div class="alert alert-info small p-3 rounded-3 mb-4">
                    <div class="fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i>Hướng dẫn chọn mã chính xác:</div>
                    Mở ứng dụng <strong>Google Authenticator</strong> trên điện thoại của bạn và chọn đúng mã 6 chữ số có tên tài khoản hoặc nhãn <strong>TruyenVietSub</strong> (vì ứng dụng của bạn có thể lưu nhiều mã cho các dịch vụ khác nhau).
                </div>

                <form asp-action="ResetPassword" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Địa chỉ Email Google</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="ten-tai-khoan@gmail.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 text-center">
                        <label asp-for="AuthenticatorCode" class="form-label small fw-bold mb-2">Mã xác thực Google Authenticator (6 số)</label>
                        <div class="d-flex justify-content-center">
                            <input asp-for="AuthenticatorCode" 
                                   class="form-control form-control-lg text-center fw-bold font-monospace" 
                                   style="max-width: 240px; font-size: 1.8rem; letter-spacing: 0.35em;" 
                                   placeholder="000000" 
                                   maxlength="6" 
                                   pattern="\d{6}" 
                                   inputmode="numeric" 
                                   autocomplete="one-time-code" 
                                   autofocus />
                        </div>
                        <span asp-validation-for="AuthenticatorCode" class="text-danger small mt-1 d-block"></span>
                        <div class="form-text small text-muted mt-2">
                            <i class="bi bi-shield-check me-1"></i>Chỉ sử dụng mã có nhãn <strong>TruyenVietSub</strong> trên ứng dụng.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-arrow-right-circle me-1"></i>Xác nhận & Tiếp tục đặt mật khẩu mới
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3 small text-muted">
                    Nhớ lại mật khẩu? <a asp-action="Login" class="fw-bold text-decoration-none">Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
