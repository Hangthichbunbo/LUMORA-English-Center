@model PaginatedList<StoryDto>
@{
    ViewData["Title"] = "Truyện đang theo dõi";
}

<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile">Tài khoản</a></li>
            <li class="breadcrumb-item active" aria-current="page">Truyện đang theo dõi</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm p-4">
        <h4 class="fw-bold mb-3 border-bottom pb-2 text-danger">
            <i class="bi bi-heart-fill me-2"></i>Tủ truyện theo dõi (@Model.TotalCount bộ truyện)
        </h4>

        @if (Model.Items.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-heartbreak display-4 d-block mb-3 opacity-50"></i>
                Bạn chưa theo dõi bộ truyện nào. Hãy khám phá và bấm "Theo dõi" để nhận thông báo chương mới nhất!
                <div class="mt-3">
                    <a asp-controller="Story" asp-action="Index" class="btn btn-primary btn-sm">Tìm truyện ngay</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
                @foreach (var story in Model.Items)
                {
                    <div class="col">
                        <partial name="_StoryCardPartial" model="story" />
                    </div>
                }
            </div>
        }
    </div>
</div>
