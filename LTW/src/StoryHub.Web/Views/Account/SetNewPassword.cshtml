@model SetNewPasswordViewModel
@{
    ViewData["Title"] = "Thiết lập mật khẩu mới";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-sm-8">
            <div class="card border-0 shadow rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="display-5 text-success mb-2">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 mb-2 rounded-pill small">
                        Bước 2 / 2: Thiết lập mật khẩu mới
                    </span>
                    <h4 class="fw-bold">Đặt lại mật khẩu</h4>
                    <p class="text-muted small mb-1">Mã xác thực đã được kiểm tra thành công cho tài khoản:</p>
                    <span class="badge bg-light text-dark border px-3 py-1 font-monospace">@Model.Email</span>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger small p-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["ErrorMessage"]
                    </div>
                }

                <div class="alert alert-info small p-3 rounded-3 mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Vui lòng đặt mật khẩu mới cho tài khoản của bạn. Mật khẩu phải có độ dài tối thiểu từ 6 ký tự trở lên.
                </div>

                <form asp-action="SetNewPassword" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ResetToken" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-bold">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input type="password" asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự (hỗ trợ chữ, số và ký tự đặc biệt)" autocomplete="new-password" autofocus />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn" title="Hiện mật khẩu" aria-label="Hiện mật khẩu" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label small fw-bold">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-check2-circle"></i></span>
                            <input type="password" asp-for="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn" title="Hiện mật khẩu" aria-label="Hiện mật khẩu" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i>Lưu mật khẩu mới & Đăng nhập
                    </button>
                </form>

                <div class="text-center mt-4 border-top pt-3 small text-muted">
                    Hủy thao tác? <a asp-action="Login" class="fw-bold text-decoration-none">Quay lại Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

