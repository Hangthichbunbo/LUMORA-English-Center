@model bool
@{
    ViewData["Title"] = Model ? "Xác thực email thành công" : "Xác thực email thất bại";
    var alreadyConfirmed = ViewData["AlreadyConfirmed"] as bool? ?? false;
    var errorMessage = ViewData["ErrorMessage"] as string;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-sm-8">
            <div class="card border-0 shadow rounded-4 p-4 p-md-5 text-center">
                @if (Model)
                {
                    <div class="display-3 text-success mb-3">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-3">
                        @(alreadyConfirmed ? "Tài khoản đã kích hoạt" : "Xác thực thành công!")
                    </h3>
                    <p class="text-muted mb-4">
                        @(alreadyConfirmed 
                            ? "Địa chỉ email của bạn đã được xác thực trước đó. Bạn có thể đăng nhập để tiếp tục đọc truyện." 
                            : "Chúc mừng bạn! Tài khoản TruyenVietSub của bạn đã được kích hoạt thành công. Hãy đăng nhập để bắt đầu trải nghiệm.")
                    </p>
                    <a asp-action="Login" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập ngay
                    </a>
                }
                else
                {
                    <div class="display-3 text-danger mb-3">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-3">Xác thực thất bại</h3>
                    <p class="text-muted mb-4">
                        @(errorMessage ?? "Liên kết xác thực email không hợp lệ hoặc đã hết hạn.")
                    </p>
                    <div class="d-grid gap-2">
                        <a asp-action="Login" class="btn btn-primary py-2 fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại trang Đăng nhập
                        </a>
                        <a asp-action="Register" class="btn btn-outline-secondary py-2">
                            Đăng ký tài khoản mới
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
