@{
    ViewData["Title"] = "404 - Không tìm thấy trang";
}

<div class="container my-5 text-center py-5">
    <div class="display-1 fw-bold text-primary mb-3">404</div>
    <h3 class="fw-bold mb-3">Trang không tồn tại</h3>
    <p class="text-muted mb-4 lead">
        Truyện, chương hoặc đường dẫn bạn đang tìm kiếm không tồn tại, đã bị đổi tên hoặc đã bị gỡ bỏ khỏi hệ thống.
    </p>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
            <i class="bi bi-house-door me-1"></i>Về trang chủ
        </a>
        <a asp-controller="Story" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
            <i class="bi bi-search me-1"></i>Tìm truyện khác
        </a>
    </div>
</div>
