@model StoryDetailViewModel
@{
    ViewData["Title"] = Model.Story.Title;
    ViewData["MetaDescription"] = !string.IsNullOrEmpty(Model.Story.Description) 
        ? (Model.Story.Description.Length > 160 ? Model.Story.Description.Substring(0, 160).Trim() + "..." : Model.Story.Description) 
        : $"Đọc truyện {Model.Story.Title} của tác giả {Model.Story.AuthorName} online trọn bộ mới nhất tại TruyenVietSub.";
    ViewData["MetaKeywords"] = $"{Model.Story.Title}, {Model.Story.AuthorName}, truyen {Model.Story.Title}, doc truyen {Model.Story.Title}, truyen chu, truyenvietsub";
    ViewData["OgImage"] = Model.Story.CoverImageUrl;
    ViewData["OgType"] = "book";

    var requestScheme = Context.Request.Scheme;
    var requestHost = Context.Request.Host.Value;
    var primaryCat = Model.Story.CategoryDetails.Count > 0 ? Model.Story.CategoryDetails[0] : null;
}

<!-- JSON-LD Structured Data for Book & Breadcrumbs -->
@Html.Raw("<script type=\"application/ld+json\">")
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "Book",
      "name": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Story.Title))",
      "headline": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Story.Title))",
      "description": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewData["MetaDescription"]?.ToString() ?? Model.Story.Title))",
      "author": {
        "@@type": "Person",
        "name": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Story.AuthorName))"
      },
      @if (!string.IsNullOrEmpty(Model.Story.CoverImageUrl))
      {
        <text>"image": "@(Model.Story.CoverImageUrl.StartsWith("http") ? Model.Story.CoverImageUrl : $"{requestScheme}://{requestHost}{Model.Story.CoverImageUrl}")",</text>
      }
      "genre": "@string.Join(", ", Model.Story.Categories)",
      "inLanguage": "vi",
      @if (Model.Story.RatingCount > 0)
      {
        <text>
        "aggregateRating": {
          "@@type": "AggregateRating",
          "ratingValue": "@Model.Story.AverageRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)",
          "ratingCount": "@Model.Story.RatingCount",
          "bestRating": "5",
          "worstRating": "1"
        },
        </text>
      }
      "publisher": {
        "@@type": "Organization",
        "name": "TruyenVietSub",
        "url": "@($"{requestScheme}://{requestHost}/")"
      }
    },
    {
      "@@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "name": "Trang chủ",
          "item": "@($"{requestScheme}://{requestHost}/")"
        }
        @if (primaryCat != null)
        {
          <text>
          ,{
            "@@type": "ListItem",
            "position": 2,
            "name": "@primaryCat.Name",
            "item": "@($"{requestScheme}://{requestHost}/the-loai/{primaryCat.Slug}")"
          },
          {
            "@@type": "ListItem",
            "position": 3,
            "name": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Story.Title))",
            "item": "@($"{requestScheme}://{requestHost}/truyen/{Model.Story.Slug}")"
          }
          </text>
        }
        else
        {
          <text>
          ,{
            "@@type": "ListItem",
            "position": 2,
            "name": "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.Story.Title))",
            "item": "@($"{requestScheme}://{requestHost}/truyen/{Model.Story.Slug}")"
          }
          </text>
        }
      ]
    }
  ]
}
</script>

<div class="container my-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            @if (Model.Story.CategoryDetails.Count > 0)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Category" asp-route-slug="@Model.Story.CategoryDetails[0].Slug">
                        @Model.Story.CategoryDetails[0].Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Story.Title</li>
        </ol>
    </nav>

    <!-- Story Info Header Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-4">
                <!-- Cover Image -->
                <div class="col-md-3 col-sm-4 text-center">
                    <img src="@(string.IsNullOrEmpty(Model.Story.CoverImageUrl) ? "/images/default-cover.webp" : Model.Story.CoverImageUrl)" 
                         class="img-fluid rounded shadow story-cover-detail" 
                         alt="@Model.Story.Title"
                         style="max-height: 340px; width: 100%; object-fit: cover;"
                         onerror="this.onerror=null; this.src='/images/default-cover.webp';" />
                </div>

                <!-- Info Column -->
                <div class="col-md-9 col-sm-8">
                    <h2 class="fw-bold mb-1 text-primary">@Model.Story.Title</h2>
                    @if (!string.IsNullOrEmpty(Model.Story.AlternativeTitle))
                    {
                        <h6 class="text-muted fst-italic mb-3">Tên khác: @Model.Story.AlternativeTitle</h6>
                    }

                    <div class="row g-2 mb-3 small">
                        <div class="col-sm-6">
                            <span class="text-muted me-2"><i class="bi bi-person me-1"></i>Tác giả:</span>
                            <a asp-controller="Home" asp-action="Author" asp-route-slug="@Model.Story.AuthorSlug" class="fw-bold text-decoration-none text-body">
                                @Model.Story.AuthorName
                            </a>
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted me-2"><i class="bi bi-activity me-1"></i>Trạng thái:</span>
                            @if (Model.Story.Status == StoryStatus.Completed)
                            {
                                <span class="badge bg-success">Hoàn thành</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Đang ra</span>
                            }
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted me-2"><i class="bi bi-tags me-1"></i>Thể loại:</span>
                            @foreach (var cat in Model.Story.CategoryDetails)
                            {
                                <a asp-controller="Home" asp-action="Category" asp-route-slug="@cat.Slug" class="badge bg-secondary-subtle text-secondary text-decoration-none me-1">
                                    @cat.Name
                                </a>
                            }
                        </div>
                        <div class="col-sm-6">
                            <span class="text-muted me-2"><i class="bi bi-eye me-1"></i>Lượt xem:</span>
                            <span class="fw-bold">@Model.Story.ViewCount.ToString("N0")</span>
                        </div>
                    </div>

                    <!-- Rating Widget -->
                    <div class="p-3 bg-body-tertiary rounded mb-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center">
                            <div class="text-warning display-6 fw-bold me-3" id="story-average-rating">
                                @(Model.Story.AverageRating > 0 ? Model.Story.AverageRating.ToString("F1") : "5.0")
                            </div>
                            <div>
                                <div class="text-warning small mb-1">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                </div>
                                <small class="text-muted">Đánh giá: <strong id="story-rating-count">@Model.Story.RatingCount</strong> lượt</small>
                            </div>
                        </div>

                        <!-- User Rating Form -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="text-end">
                                <span class="small text-muted d-block mb-1">Đánh giá của bạn:</span>
                                <div class="star-rating">
                                    @for (int score = 5; score >= 1; score--)
                                    {
                                        <input type="radio" id="star-@score" name="user_score" value="@score" 
                                               checked="@(Model.Story.CurrentUserRating == score)" 
                                               onchange="submitRating(@Model.Story.Id, @score)" />
                                        <label for="star-@score" title="@score sao"><i class="bi bi-star-fill"></i></label>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <small class="text-muted fst-italic">Đăng nhập để đánh giá truyện</small>
                        }
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-wrap gap-2 pt-2">
                        @if (Model.Chapters.Count > 0)
                        {
                            var firstChapter = Model.Chapters.First();
                            var latestChapter = Model.Chapters.Last();

                            <a asp-controller="Chapter" asp-action="Read" 
                               asp-route-storySlug="@Model.Story.Slug" 
                               asp-route-chapterNumber="@firstChapter.FormattedChapterNumber" 
                               asp-route-chapterSlug="@firstChapter.Slug" 
                               class="btn btn-primary px-4">
                                <i class="bi bi-book-half me-1"></i>Đọc từ đầu
                            </a>

                            @if (Model.Story.LastReadChapterId.HasValue)
                            {
                                var lastRead = Model.Chapters.FirstOrDefault(c => c.Id == Model.Story.LastReadChapterId.Value) ?? firstChapter;
                                <a asp-controller="Chapter" asp-action="Read" 
                                   asp-route-storySlug="@Model.Story.Slug" 
                                   asp-route-chapterNumber="@lastRead.FormattedChapterNumber" 
                                   asp-route-chapterSlug="@lastRead.Slug" 
                                   class="btn btn-outline-success">
                                    <i class="bi bi-bookmark-check-fill me-1"></i>Đọc tiếp (Chương @lastRead.FormattedChapterNumber)
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Chapter" asp-action="Read" 
                                   asp-route-storySlug="@Model.Story.Slug" 
                                   asp-route-chapterNumber="@latestChapter.FormattedChapterNumber" 
                                   asp-route-chapterSlug="@latestChapter.Slug" 
                                   class="btn btn-outline-secondary">
                                    <i class="bi bi-fast-forward-fill me-1"></i>Chương mới nhất
                                </a>
                            }
                        }

                        <!-- Follow Button -->
                        <button type="button" class="btn @(Model.Story.IsFollowedByCurrentUser ? "btn-outline-danger" : "btn-danger")" id="btn-follow" onclick="toggleFollow(@Model.Story.Id)">
                            <i class="bi @(Model.Story.IsFollowedByCurrentUser ? "bi-heart-fill" : "bi-heart") me-1"></i>
                            @(Model.Story.IsFollowedByCurrentUser ? "Đã theo dõi" : "Theo dõi truyện")
                        </button>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="mt-4 pt-3 border-top">
                <h5 class="fw-bold mb-2"><i class="bi bi-file-text-fill text-primary me-2"></i>Giới thiệu truyện</h5>
                <div class="text-muted" style="white-space: pre-line; line-height: 1.8;">
                    @(string.IsNullOrEmpty(Model.Story.Description) ? "Đang cập nhật giới thiệu cho bộ truyện này..." : Model.Story.Description)
                </div>
            </div>
        </div>
    </div>

    <!-- Story Detail Ad Placement -->
    <partial name="_AdPlacementPartial" model="(Placement: AdPlacement.StoryDetail, StoryId: (int?)Model.Story.Id, CategorySlug: (string?)null)" />

    <!-- Chapter List -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-body border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ol text-primary me-2"></i>Danh sách chương (@Model.Chapters.Count chương)
            </h5>
            <small class="text-muted">Cập nhật lúc: @((Model.Story.UpdatedAt ?? Model.Story.CreatedAt).ToString("dd/MM/yyyy HH:mm"))</small>
        </div>
        <div class="card-body p-3">
            @if (Model.Chapters.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    Truyện đang được biên tập. Các chương truyện sẽ sớm được phát hành!
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                    @foreach (var ch in Model.Chapters)
                    {
                        <div class="col">
                            <a asp-controller="Chapter" asp-action="Read" 
                               asp-route-storySlug="@Model.Story.Slug" 
                               asp-route-chapterNumber="@ch.FormattedChapterNumber" 
                               asp-route-chapterSlug="@ch.Slug" 
                               class="d-block p-2 text-decoration-none rounded hover-bg-light text-truncate text-body border-bottom border-light">
                                <span class="badge bg-secondary-subtle text-secondary me-1">Chương @ch.FormattedChapterNumber</span>
                                <span>@ch.Title</span>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Comments Section -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <partial name="_CommentSectionPartial" model="(StoryId: Model.Story.Id, ChapterId: (int?)null, Comments: Model.InitialComments)" />
        </div>
    </div>
</div>
