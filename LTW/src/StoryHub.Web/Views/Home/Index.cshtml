@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - Đọc Truyện Online Hay Nhất";
    ViewData["MetaDescription"] = "TruyenVietSub - Nền tảng đọc truyện chữ trực tuyến cập nhật nhanh nhất, truyện tiên hiệp, kiếm hiệp, huyền huyễn, đô thị, ngôn tình hấp dẫn, giao diện đẹp mượt mà.";
    ViewData["MetaKeywords"] = "truyen online, doc truyen chu, doc truyen, truyen hot, truyen full, truyen moi, tien hiep, kiem hiep, ngon tinh, do thi, truyenvietsub";
}

<div class="container my-3">
    <!-- Semantic SEO H1 -->
    <h1 class="visually-hidden">TruyenVietSub - Đọc Truyện Online Trực Tuyến Đỉnh Cao</h1>

    <!-- Home Top Ad -->
    <partial name="_AdPlacementPartial" model="(Placement: AdPlacement.HomeTop, StoryId: (int?)null, CategorySlug: (string?)null)" />

    <!-- Featured Stories Carousel/Grid -->
    @if (Model.FeaturedStories.Count > 0)
    {
        <section class="mb-5">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <h4 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-fire text-danger me-2"></i>Truyện Đề Cử & Nổi Bật
                </h4>
                <a asp-controller="Story" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">
                    Xem tất cả <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
                @foreach (var story in Model.FeaturedStories)
                {
                    <div class="col">
                        <partial name="_StoryCardPartial" model="story" />
                    </div>
                }
            </div>
        </section>
    }

    <!-- Main Content: Latest Updates & Top Ranking Sidebar -->
    <div class="row g-4 mb-5">
        <!-- Left Column: Latest Updated Stories -->
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-clock-history text-success me-2"></i>Mới Cập Nhật
                </h4>
                <a asp-controller="Story" asp-action="Index" asp-route-sortBy="updated" class="btn btn-sm btn-outline-secondary rounded-pill">
                    Xem thêm <i class="bi bi-chevron-right"></i>
                </a>
            </div>
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3">
                @foreach (var story in Model.LatestStories)
                {
                    <div class="col">
                        <partial name="_StoryCardPartial" model="story" />
                    </div>
                }
            </div>

            <!-- Home Middle Ad -->
            <partial name="_AdPlacementPartial" model="(Placement: AdPlacement.HomeMiddle, StoryId: (int?)null, CategorySlug: (string?)null)" />

            <!-- Completed Stories Section -->
            @if (Model.CompletedStories.Count > 0)
            {
                <div class="mt-5">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                        <h4 class="fw-bold mb-0 text-success">
                            <i class="bi bi-check2-circle me-2"></i>Truyện Đã Hoàn Thành (Full)
                        </h4>
                        <a asp-controller="Story" asp-action="Index" asp-route-status="@StoryStatus.Completed" class="btn btn-sm btn-outline-success rounded-pill">
                            Xem tất cả <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3">
                        @foreach (var story in Model.CompletedStories)
                        {
                            <div class="col">
                                <partial name="_StoryCardPartial" model="story" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Sidebar Rankings & Categories -->
        <div class="col-lg-4">
            <!-- Sidebar Ad -->
            <partial name="_AdPlacementPartial" model="(Placement: AdPlacement.Sidebar, StoryId: (int?)null, CategorySlug: (string?)null)" />

            <!-- Top Viewed Stories Ranking -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-body border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-danger">
                        <i class="bi bi-trophy-fill text-warning me-2"></i>Bảng Xếp Hạng Lượt Xem
                    </h5>
                </div>
                <div class="list-group list-group-flush">
                    @for (int i = 0; i < Model.TopViewedStories.Count; i++)
                    {
                        var story = Model.TopViewedStories[i];
                        var rankColor = i == 0 ? "bg-danger" : (i == 1 ? "bg-warning text-dark" : (i == 2 ? "bg-info text-dark" : "bg-secondary-subtle text-secondary"));
                        <a asp-controller="Story" asp-action="Detail" asp-route-slug="@story.Slug" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-bottom">
                            <span class="badge @rankColor rounded-circle me-3 flex-shrink-0 d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.9rem;">
                                @(i + 1)
                            </span>
                            <div class="flex-grow-1 text-truncate">
                                <h6 class="mb-0 text-truncate text-body">@story.Title</h6>
                                <small class="text-muted"><i class="bi bi-person me-1"></i>@story.AuthorName</small>
                            </div>
                            <div class="text-end ms-2 small text-muted flex-shrink-0">
                                <i class="bi bi-eye me-1"></i>@(story.ViewCount >= 1000 ? $"{story.ViewCount / 1000.0:F1}k" : story.ViewCount.ToString())
                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Top Rated Stories -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-body border-bottom py-3">
                    <h5 class="fw-bold mb-0 text-primary">
                        <i class="bi bi-star-fill text-warning me-2"></i>Đánh Giá Cao Nhất
                    </h5>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var story in Model.TopRatedStories.Take(5))
                    {
                        <a asp-controller="Story" asp-action="Detail" asp-route-slug="@story.Slug" class="list-group-item list-group-item-action d-flex align-items-center p-3 border-bottom">
                            <img src="@(string.IsNullOrEmpty(story.CoverImageUrl) ? "/images/default-cover.webp" : story.CoverImageUrl)" 
                                 class="rounded me-3 flex-shrink-0" width="45" height="60" style="object-fit: cover;" alt="@story.Title"
                                 onerror="this.onerror=null; this.src='/images/default-cover.webp';" />
                            <div class="flex-grow-1 text-truncate">
                                <h6 class="mb-1 text-truncate text-body">@story.Title</h6>
                                <div class="small text-warning">
                                    <i class="bi bi-star-fill me-1"></i>@story.AverageRating.ToString("F1") <span class="text-muted">(@story.RatingCount vote)</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Category Cloud -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body border-bottom py-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-tags-fill text-secondary me-2"></i>Khám phá thể loại</h6>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var cat in Model.Categories)
                        {
                            <a asp-controller="Home" asp-action="Category" asp-route-slug="@cat.Slug" class="btn btn-sm btn-outline-secondary rounded-pill">
                                @cat.Name
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
