@using StoryHub.Application.Interfaces
@inject ICategoryService CategoryService
@inject Microsoft.AspNetCore.Identity.UserManager<StoryHub.Domain.Entities.ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var categories = await CategoryService.GetAllCategoriesAsync();
    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
    var requestScheme = Context.Request.Scheme;
    var requestHost = Context.Request.Host.Value;
    var canonicalUrl = $"{requestScheme}://{requestHost}{Context.Request.Path}{Context.Request.QueryString}";
    var rawOgImage = ViewData["OgImage"]?.ToString();
    var absoluteOgImage = !string.IsNullOrWhiteSpace(rawOgImage)
        ? (rawOgImage.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? rawOgImage : $"{requestScheme}://{requestHost}{rawOgImage}")
        : $"{requestScheme}://{requestHost}/favicon.svg";
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - TruyenVietSub" : "TruyenVietSub - Đọc Truyện Online Trực Tuyến Đỉnh Cao")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "TruyenVietSub - Nền tảng đọc truyện chữ trực tuyến cập nhật nhanh nhất, truyện tiên hiệp, kiếm hiệp, huyền huyễn, đô thị, ngôn tình hấp dẫn.")" />

    <!-- Favicon & Touch Icons for Browser Tab (Cache Busted) -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="msapplication-TileColor" content="#4f46e5" />

    <!-- Canonical & Search Engine Meta Tags -->
    <link rel="canonical" href="@canonicalUrl" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="keywords" content="@(ViewData["MetaKeywords"] ?? "truyện online, đọc truyện chữ, truyện full, truyện mới, tiên hiệp, kiếm hiệp, ngôn tình, đô thị, huyền huyễn, truyenvietsub")" />
    <meta name="author" content="TruyenVietSub" />

    <!-- CSRF Token for AJAX Requests -->
    <meta name="csrf-token" content="@antiforgeryTokens.RequestToken" />

    <!-- Open Graph SEO -->
    <meta property="og:site_name" content="TruyenVietSub" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} - TruyenVietSub" : "TruyenVietSub - Đọc Truyện Online Trực Tuyến Đỉnh Cao")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Đọc truyện online tại TruyenVietSub - Nền tảng đọc truyện chữ trực tuyến đặc sắc, cập nhật nhanh chóng.")" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@absoluteOgImage" />
    <meta property="og:image:alt" content="@(ViewData["Title"] ?? "TruyenVietSub")" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} - TruyenVietSub" : "TruyenVietSub - Đọc Truyện Online Trực Tuyến Đỉnh Cao")" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Đọc truyện online tại TruyenVietSub")" />
    <meta name="twitter:image" content="@absoluteOgImage" />

    <!-- Global JSON-LD Schema.org Structured Data -->
    @Html.Raw("<script type=\"application/ld+json\">")
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "TruyenVietSub",
      "alternateName": ["TruyenVietSub Online", "Web Truyen VietSub"],
      "url": "@($"{requestScheme}://{requestHost}/")",
      "potentialAction": {
        "@@type": "SearchAction",
        "target": {
          "@@type": "EntryPoint",
          "urlTemplate": "@($"{requestScheme}://{requestHost}/truyen?SearchTerm={{search_term_string}}")"
        },
        "query-input": "required name=search_term_string"
      }
    }
    @Html.Raw("</script>")

    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Global Anti-Forgery Token Form Field -->
    <div style="display:none;" id="global-antiforgery-container">
        @Html.AntiForgeryToken()
    </div>
    <header>
        <!-- Top Navbar -->
        <nav class="navbar navbar-expand-lg border-bottom sticky-top bg-body shadow-sm">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand fw-bold d-flex align-items-center text-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half me-2"></i>
                    <span>Truyen<span class="text-body">VietSub</span></span>
                </a>

                <!-- Mobile Toggler -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Left Nav Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        <!-- Category Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid me-1"></i>Thể loại
                            </a>
                            <ul class="dropdown-menu shadow border-0 p-2" aria-labelledby="categoryDropdown" style="min-width: 360px; max-width: calc(100vw - 20px);">
                                <div class="row g-1">
                                    @foreach (var cat in categories)
                                    {
                                        <div class="col-6">
                                            <a class="dropdown-item py-1 px-2 rounded small text-truncate" asp-controller="Home" asp-action="Category" asp-route-slug="@cat.Slug" title="@cat.Name">
                                                @cat.Name
                                            </a>
                                        </div>
                                    }
                                </div>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Story" asp-action="Index" asp-route-sortBy="updated">Truyện mới</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Story" asp-action="Index" asp-route-sortBy="views">Xem nhiều</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Story" asp-action="Index" asp-route-status="@StoryStatus.Completed">Truyện full</a>
                        </li>
                    </ul>

                    <!-- Search Form -->
                    <form class="d-flex me-lg-3 my-2 my-lg-0" asp-controller="Story" asp-action="Index" method="get">
                        <div class="input-group input-group-sm">
                            <input class="form-control" type="search" name="SearchTerm" placeholder="Tìm tên truyện, tác giả..." aria-label="Search" value="@Context.Request.Query["SearchTerm"]" required />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Right Controls (Theme & User) -->
                    <div class="d-flex align-items-center gap-2 pt-2 pt-lg-0 pb-2 pb-lg-0">
                        <!-- Dark/Light Mode Toggle -->
                        <button class="btn btn-sm btn-outline-secondary rounded-circle p-2 d-flex align-items-center justify-content-center" id="theme-toggle-btn" title="Chuyển chế độ sáng/tối" style="width: 34px; height: 34px;">
                            <i class="bi bi-moon-stars-fill" id="theme-icon"></i>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var navDisplayName = User.FindFirst("DisplayName")?.Value;
                            if (string.IsNullOrWhiteSpace(navDisplayName))
                            {
                                var currentUser = await UserManager.GetUserAsync(User);
                                navDisplayName = currentUser?.DisplayName;
                            }
                            if (string.IsNullOrWhiteSpace(navDisplayName))
                            {
                                var rawName = User.Identity.Name ?? string.Empty;
                                navDisplayName = rawName.Contains('@') ? rawName.Split('@')[0] : rawName;
                            }
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-2" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i>
                                    <span class="fw-semibold text-truncate d-inline-block align-middle" style="max-width: 140px;">@navDisplayName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-lg-end shadow border-0" aria-labelledby="userMenuBtn">
                                    @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                                    {
                                        <li>
                                            <a class="dropdown-item text-danger fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i>Trang quản trị
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Followed">
                                            <i class="bi bi-heart me-2 text-danger"></i>Truyện đang theo dõi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="History">
                                            <i class="bi bi-clock-history me-2 text-info"></i>Lịch sử đọc truyện
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2"></i>Hồ sơ cá nhân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>

        <!-- Top Header Advertisement Placement -->
        <div class="container">
            <partial name="_AdPlacementPartial" model="(Placement: AdPlacement.Header, StoryId: (int?)null, CategorySlug: (string?)null)" />
        </div>
    </header>

    <main role="main" class="pb-4">
        <!-- Toast / Alerts -->
        <div class="container mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Footer Ad Placement -->
    <div class="container">
        <partial name="_AdPlacementPartial" model="(Placement: AdPlacement.Footer, StoryId: (int?)null, CategorySlug: (string?)null)" />
    </div>

    <!-- Footer -->
    <footer class="border-top py-4 bg-body-tertiary mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5 col-md-6">
                    <h5 class="fw-bold text-primary mb-2">
                        <i class="bi bi-book-half me-1"></i>TruyenVietSub
                    </h5>
                    <p class="small text-muted mb-2">
                        Website đọc truyện online trực tuyến với hàng ngàn bộ truyện tiên hiệp, kiếm hiệp, ngôn tình, đô thị đặc sắc. Giao diện hiện đại, dễ đọc trên mọi thiết bị di động.
                    </p>
                    <p class="small text-muted mb-2">
                       Địa chỉ: Phố Chùa Láng, phường Láng, quận Đống Đa, thành phố Hà Nội
                    </p>
                    <p class="small text-muted mb-0">
                        &copy; @DateTime.UtcNow.Year TruyenVietSub. Toàn bộ nội dung được tạo ra và tổng hợp phi thương mại.
                    </p>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Thể loại nổi bật</h6>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var cat in categories.Take(6))
                        {
                            <a asp-controller="Home" asp-action="Category" asp-route-slug="@cat.Slug" class="badge bg-secondary-subtle text-secondary text-decoration-none">
                                @cat.Name
                            </a>
                        }
                    </div>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h6 class="fw-bold mb-3">Thông tin & Điều khoản</h6>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="mb-1"><a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Chính sách bảo mật</a></li>
                        <li><span class="text-muted">Liên hệ : admin@truyenvietsub.com</span> hoặc <span>service@truyenvietsub.com</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <!-- Advertisement Popup Placement -->
    <partial name="_AdPopupPartial" />

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
