@model StoryDto

<div class="card h-100 story-card border-0 shadow-sm transition-hover">
    <div class="position-relative overflow-hidden rounded-top">
        <a asp-controller="Story" asp-action="Detail" asp-route-slug="@Model.Slug" class="text-decoration-none">
            <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/default-cover.webp" : Model.CoverImageUrl)" 
                 class="card-img-top story-cover" 
                 alt="@Model.Title"
                 loading="lazy"
                 onerror="this.onerror=null; this.src='/images/default-cover.webp';" />
        </a>
        @if (Model.Status == StoryStatus.Completed)
        {
            <span class="position-absolute top-0 start-0 badge bg-success m-2 shadow-sm">Hoàn thành</span>
        }
        else if (Model.IsFeatured)
        {
            <span class="position-absolute top-0 start-0 badge bg-danger m-2 shadow-sm">Nổi bật</span>
        }
        <span class="position-absolute bottom-0 end-0 badge bg-dark bg-opacity-75 m-2">
            <i class="bi bi-book me-1"></i>@(Model.ChapterCount > 0 ? $"{Model.ChapterCount} chương" : "Đang cập nhật")
        </span>
    </div>
    <div class="card-body p-3 d-flex flex-column">
        <h6 class="card-title mb-1 text-truncate">
            <a asp-controller="Story" asp-action="Detail" asp-route-slug="@Model.Slug" class="text-decoration-none story-title text-body" title="@Model.Title">
                @Model.Title
            </a>
        </h6>
        <div class="small text-muted mb-2 text-truncate">
            <i class="bi bi-person me-1"></i>@Model.AuthorName
        </div>
        @if (Model.Categories.Count > 0)
        {
            <div class="mb-2 text-truncate">
                @foreach (var cat in Model.Categories.Take(2))
                {
                    <span class="badge bg-secondary-subtle text-secondary me-1">@cat</span>
                }
            </div>
        }
        <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
            <span>
                <i class="bi bi-star-fill text-warning me-1"></i>@(Model.AverageRating > 0 ? Model.AverageRating.ToString("F1") : "5.0")
            </span>
            <span>
                <i class="bi bi-eye me-1"></i>@(Model.ViewCount >= 1000 ? $"{Model.ViewCount / 1000.0:F1}k" : Model.ViewCount.ToString())
            </span>
        </div>
    </div>
</div>
