@model (int StoryId, int? ChapterId, PaginatedList<CommentDto> Comments)

<div class="comment-section my-4" id="comment-section" data-story-id="@Model.StoryId" data-chapter-id="@(Model.ChapterId?.ToString() ?? "")">
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-chat-dots-fill text-primary me-2"></i>Bình luận (<span id="total-comments-count">@Model.Comments.TotalCount</span>)
        </h5>
    </div>

    <!-- Comment Submission Form -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card border-0 shadow-sm mb-4 bg-body-tertiary">
            <div class="card-body p-3">
                <form id="comment-form" onsubmit="submitComment(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="StoryId" value="@Model.StoryId" />
                    @if (Model.ChapterId.HasValue)
                    {
                        <input type="hidden" name="ChapterId" value="@Model.ChapterId.Value" />
                    }
                    <div class="mb-2">
                        <textarea class="form-control" name="Content" id="comment-content" rows="3" 
                                  placeholder="Chia sẻ cảm nghĩ của bạn về truyện (Tối đa 1000 ký tự, lịch sự, văn minh)..." 
                                  maxlength="1000" required></textarea>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted"><span id="char-count">0</span>/1000 ký tự</small>
                        <button type="submit" class="btn btn-primary btn-sm px-3" id="btn-submit-comment">
                            <i class="bi bi-send-fill me-1"></i>Đăng bình luận
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light border text-center p-3 mb-4 shadow-sm">
            <i class="bi bi-lock-fill text-secondary me-2"></i>
            Vui lòng <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="fw-bold">Đăng nhập</a> hoặc <a asp-controller="Account" asp-action="Register" class="fw-bold">Đăng ký</a> để tham gia thảo luận cùng cộng đồng.
        </div>
    }

    <!-- Comments List -->
    <div id="comments-container">
        @if (Model.Comments.Items.Count == 0)
        {
            <div class="text-center py-4 text-muted" id="no-comments-placeholder">
                <i class="bi bi-chat-square-text display-6 d-block mb-2 text-secondary opacity-50"></i>
                Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nghĩ!
            </div>
        }
        else
        {
            @foreach (var comment in Model.Comments.Items)
            {
                <div class="comment-item border-bottom py-3" id="comment-@comment.Id">
                    <div class="d-flex">
                        <img src="@(string.IsNullOrEmpty(comment.UserAvatarUrl) ? "/images/default-avatar.webp" : comment.UserAvatarUrl)" 
                             class="rounded-circle me-3 flex-shrink-0" width="40" height="40" alt="@comment.UserDisplayName"
                             onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h6 class="mb-0 fw-bold">@comment.UserDisplayName</h6>
                                <small class="text-muted">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            @if (!string.IsNullOrEmpty(comment.ChapterTitle))
                            {
                                <div class="badge bg-secondary-subtle text-secondary small mb-1">
                                    <i class="bi bi-bookmark me-1"></i>@comment.ChapterTitle
                                </div>
                            }
                            <p class="mb-2 mt-1 comment-text text-body" style="white-space: pre-line;">@comment.Content</p>
                            
                            <div class="d-flex gap-3 small text-muted">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <button type="button" class="btn btn-link p-0 small text-decoration-none text-muted" onclick="showReplyForm(@comment.Id, '@comment.UserDisplayName')">
                                        <i class="bi bi-reply-fill me-1"></i>Trả lời
                                    </button>
                                }
                                @if (comment.CanEdit)
                                {
                                    <button type="button" class="btn btn-link p-0 small text-decoration-none text-muted" onclick="editComment(@comment.Id)">
                                        <i class="bi bi-pencil me-1"></i>Sửa
                                    </button>
                                }
                                @if (comment.CanDelete)
                                {
                                    <button type="button" class="btn btn-link p-0 small text-decoration-none text-danger" onclick="deleteComment(@comment.Id)">
                                        <i class="bi bi-trash me-1"></i>Xóa
                                    </button>
                                }
                                <button type="button" class="btn btn-link p-0 small text-decoration-none text-muted" onclick="openReportModal(@comment.Id)">
                                    <i class="bi bi-flag me-1"></i>Báo cáo
                                </button>
                            </div>

                            <!-- Replies Container -->
                            @if (comment.Replies.Count > 0)
                            {
                                <div class="replies-list ms-4 mt-3 border-start ps-3 bg-body-tertiary rounded p-2">
                                    @foreach (var reply in comment.Replies)
                                    {
                                        <div class="reply-item py-2 border-bottom border-light" id="comment-@reply.Id">
                                            <div class="d-flex">
                                                <img src="@(string.IsNullOrEmpty(reply.UserAvatarUrl) ? "/images/default-avatar.webp" : reply.UserAvatarUrl)" 
                                                     class="rounded-circle me-2 flex-shrink-0" width="30" height="30" alt="@reply.UserDisplayName"
                                                     onerror="this.onerror=null; this.src='/images/default-avatar.webp';" />
                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-baseline">
                                                        <span class="fw-bold small">@reply.UserDisplayName</span>
                                                        <small class="text-muted" style="font-size: 0.75rem;">@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                                    </div>
                                                    <p class="mb-1 small text-body" style="white-space: pre-line;">@reply.Content</p>
                                                    <div class="d-flex gap-3 small text-muted" style="font-size: 0.75rem;">
                                                        @if (reply.CanEdit)
                                                        {
                                                            <button type="button" class="btn btn-link p-0 text-decoration-none text-muted" onclick="editComment(@reply.Id)">Sửa</button>
                                                        }
                                                        @if (reply.CanDelete)
                                                        {
                                                            <button type="button" class="btn btn-link p-0 text-decoration-none text-danger" onclick="deleteComment(@reply.Id)">Xóa</button>
                                                        }
                                                        <button type="button" class="btn btn-link p-0 text-decoration-none text-muted" onclick="openReportModal(@reply.Id)">Báo cáo</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Dynamic Reply Form Placeholder -->
                            <div id="reply-form-container-@comment.Id" class="mt-2 d-none"></div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (Model.Comments.TotalPages > 1)
    {
        <div class="text-center mt-3 pt-2" id="load-more-comments-container">
            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4 shadow-sm" id="btn-load-more-comments" 
                    onclick="loadMoreComments()" data-current-page="1" data-total-pages="@Model.Comments.TotalPages">
                <i class="bi bi-chevron-down me-1"></i>Tải thêm bình luận
            </button>
        </div>
    }
</div>

<!-- Modal Report Comment -->
<div class="modal fade" id="reportCommentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold"><i class="bi bi-shield-exclamation text-danger me-2"></i>Báo cáo bình luận vi phạm</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="report-comment-form" onsubmit="submitReport(event)">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="CommentId" id="report-comment-id" value="" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Lý do báo cáo:</label>
                        <select class="form-select" name="Reason" required>
                            <option value="">-- Chọn lý do --</option>
                            <option value="Ngôn từ thù ghét, xúc phạm">Ngôn từ thù ghét, xúc phạm</option>
                            <option value="Spam hoặc quảng cáo trái phép">Spam hoặc quảng cáo trái phép</option>
                            <option value="Nội dung khiêu dâm, đồi trụy">Nội dung khiêu dâm, đồi trụy</option>
                            <option value="Tiết lộ trước nội dung cốt truyện quá mức (Spoiler)">Tiết lộ trước cốt truyện (Spoiler)</option>
                            <option value="Vi phạm pháp luật hoặc chống phá">Vi phạm pháp luật</option>
                            <option value="Lý do khác">Lý do khác</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Mô tả thêm (Tùy chọn):</label>
                        <textarea class="form-control" name="Description" rows="3" placeholder="Cung cấp thêm chi tiết vi phạm..." maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger btn-sm">Gửi báo cáo</button>
                </div>
            </form>
        </div>
    </div>
</div>
