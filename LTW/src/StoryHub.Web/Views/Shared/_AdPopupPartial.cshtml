@using StoryHub.Application.Interfaces
@using StoryHub.Domain.Enums
@inject IAdvertisementService AdService

@{
    var popupAd = await AdService.GetActiveAdForPlacementAsync(AdPlacement.Popup);
}

@if (popupAd != null)
{
    <div id="ad-popup-modal" class="ad-popup-wrapper" style="display: none;" data-ad-id="@popupAd.Id">
        <div class="ad-popup-backdrop" onclick="closeAdPopup()"></div>
        <div class="ad-popup-dialog shadow-lg">
            <div class="ad-popup-header d-flex align-items-center justify-content-between px-3 py-2 bg-body-secondary border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.5px;">Quảng cáo</span>
                    <span class="small fw-bold text-truncate" style="max-width: 260px;">@popupAd.Name</span>
                </div>
                <button type="button" class="btn-close btn-close-sm" aria-label="Đóng" onclick="closeAdPopup()"></button>
            </div>
            <div class="ad-popup-body p-2 text-center">
                @if (popupAd.AdType == AdType.Image && !string.IsNullOrEmpty(popupAd.ImageUrl))
                {
                    <a href="@popupAd.DestinationUrl" 
                       target="@(popupAd.OpenInNewTab ? "_blank" : "_self")" 
                       rel="noopener noreferrer sponsored" 
                       class="d-block text-decoration-none"
                       onclick="trackAdClick(@popupAd.Id)">
                        <img src="@popupAd.ImageUrl" alt="@popupAd.Name" class="img-fluid rounded" style="max-height: 380px; width: 100%; object-fit: contain;" />
                    </a>
                }
                else if (popupAd.AdType == AdType.SafeHtml && !string.IsNullOrEmpty(popupAd.HtmlContent))
                {
                    <div class="ad-popup-html text-start p-2">
                        @Html.Raw(popupAd.HtmlContent)
                    </div>
                }
                else
                {
                    <div class="p-3">
                        <p class="mb-3 text-body">@popupAd.HtmlContent</p>
                        @if (!string.IsNullOrEmpty(popupAd.DestinationUrl))
                        {
                            <a href="@popupAd.DestinationUrl" 
                               target="@(popupAd.OpenInNewTab ? "_blank" : "_self")" 
                               rel="noopener noreferrer sponsored" 
                               class="btn btn-primary btn-sm px-4"
                               onclick="trackAdClick(@popupAd.Id)">
                                Khám phá ngay
                            </a>
                        }
                    </div>
                }
            </div>
            <div class="ad-popup-footer px-3 py-1 bg-body-tertiary border-top d-flex justify-content-between align-items-center">
                <small class="text-muted" style="font-size: 0.7rem;">TruyenVietSub Partner</small>
                <button type="button" class="btn btn-link btn-sm text-decoration-none text-muted p-0" style="font-size: 0.75rem;" onclick="closeAdPopup()">
                    Đóng lại [X]
                </button>
            </div>
        </div>
    </div>
}

