@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản - LUMORA English Center";
}

<div class="auth-page-wrapper">
    <div class="container" style="max-width: 1060px;">
        <div class="auth-split-card">
            <div class="row g-0">
                <!-- Cột trái: Giới thiệu thương hiệu & Điểm nổi bật LUMORA -->
                <div class="col-lg-5 d-none d-lg-flex auth-showcase-col">
                    <div>
                        <!-- Logo & Tên trung tâm -->
                        <div class="auth-brand-badge mb-4">
                            <span class="brand-symbol-box">
                                <i class="bi bi-mortarboard-fill"></i>
                            </span>
                            <span class="brand-title">
                                LUMORA <span class="text-info">English</span> Center
                            </span>
                        </div>

                        <!-- Capsule đối tác chính thức British Council & IDP -->
                        <div class="auth-partner-strip mb-4">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-patch-check-fill text-warning"></i>
                                <span class="small text-white-50 fw-semibold text-uppercase" style="letter-spacing: 0.5px; font-size: 11px;">
                                    Platinum Partner
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge-official-bc">BRITISH COUNCIL</span>
                                <span class="badge-official-idp">IDP</span>
                            </div>
                        </div>

                        <!-- Tiêu đề & Giới thiệu ngắn -->
                        <h3 class="fw-bold text-white mb-2" style="font-size: 24px; line-height: 1.3;">
                            Bắt Đầu Lộ Trình Chinh Phục <span style="color: #38bdf8;">IELTS 7.5+</span>
                        </h3>
                        <p class="text-white-50 small mb-4" style="line-height: 1.6;">
                            Đăng ký tài khoản học viên để truy cập không giới hạn kho đề thi chuẩn hóa, thi thử format máy tính và nhận phản hồi chi tiết.
                        </p>

                        <!-- 4 Kỹ năng IELTS chính thức -->
                        <div class="auth-skills-row mb-4">
                            <span class="auth-skill-pill auth-skill-listening">
                                <i class="bi bi-headphones me-1"></i> Listening
                            </span>
                            <span class="auth-skill-pill auth-skill-reading">
                                <i class="bi bi-book me-1"></i> Reading
                            </span>
                            <span class="auth-skill-pill auth-skill-writing">
                                <i class="bi bi-pencil-square me-1"></i> Writing
                            </span>
                            <span class="auth-skill-pill auth-skill-speaking">
                                <i class="bi bi-mic me-1"></i> Speaking
                            </span>
                        </div>

                        <!-- Danh sách quyền lợi thành viên -->
                        <div class="auth-feature-list">
                            <div class="auth-feature-item">
                                <i class="bi bi-gift-fill text-warning"></i>
                                <span>Miễn phí 100% kho 500+ bộ đề thi thử cập nhật format mới nhất</span>
                            </div>
                            <div class="auth-feature-item">
                                <i class="bi bi-journal-check text-info"></i>
                                <span>Đáp án chuẩn xác kèm phân tích giải thích chi tiết từng câu hỏi</span>
                            </div>
                            <div class="auth-feature-item">
                                <i class="bi bi-award text-success"></i>
                                <span>Lộ trình học cá nhân hóa thiết kế bởi cựu giám khảo chấm thi</span>
                            </div>
                        </div>
                    </div>

                    <!-- Footer nhỏ cột trái -->
                    <div class="auth-trust-strip d-flex align-items-center justify-content-between mt-4">
                        <span><i class="bi bi-people-fill text-warning me-1"></i> 2.5M+ Học viên tin cậy</span>
                        <span><i class="bi bi-star-fill text-warning me-1"></i> 4.9/5 Đánh giá</span>
                    </div>
                </div>

                <!-- Cột phải: Form Đăng Ký -->
                <div class="col-lg-7 auth-form-col">
                    <!-- Brand thu nhỏ trên màn hình Mobile -->
                    <div class="d-lg-none text-center mb-4">
                        <div class="d-inline-flex align-items-center gap-2">
                            <span class="brand-symbol-box" style="width: 36px; height: 36px; font-size: 1rem;">
                                <i class="bi bi-mortarboard-fill"></i>
                            </span>
                            <span class="fw-bold fs-5" style="color: var(--navy);">
                                LUMORA <span style="color: var(--brand);">English</span> Center
                            </span>
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                            <span class="badge-official-bc" style="width: 110px; height: 24px; font-size: 10px;">BRITISH COUNCIL</span>
                            <span class="badge-official-idp" style="width: 110px; height: 24px; font-size: 10px;">IDP</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <span class="auth-section-badge mb-2">
                            <i class="bi bi-person-plus-fill me-1"></i> TẠO TÀI KHOẢN MỚI
                        </span>
                        <h2 class="auth-card-title mb-1">Đăng Ký Học Viên</h2>
                        <p class="text-muted small mb-0">
                            Chỉ mất 30 giây để bắt đầu hành trình nâng band IELTS cùng LUMORA.
                        </p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small border-0 shadow-sm mb-3" role="alert"></div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label small fw-semibold text-dark">
                                <i class="bi bi-envelope text-primary me-1"></i> Địa chỉ Email
                            </label>
                            <div class="input-group auth-input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-at"></i>
                                </span>
                                <input asp-for="Input.Email" class="form-control auth-control" autocomplete="username" aria-required="true" placeholder="vidu@gmail.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Mật khẩu -->
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label small fw-semibold text-dark mb-1">
                                <i class="bi bi-lock text-primary me-1"></i> Mật khẩu
                            </label>
                            <div class="input-group auth-input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input asp-for="Input.Password" class="form-control auth-control border-end-0" id="registerPasswordInput" autocomplete="new-password" aria-required="true" placeholder="Tối thiểu 6 ký tự" />
                                <button class="btn btn-pwd-toggle border border-start-0" type="button" id="toggleRegisterPasswordBtn" title="Hiện/ẩn mật khẩu">
                                    <i class="bi bi-eye" id="toggleRegisterPasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label small fw-semibold text-dark mb-1">
                                <i class="bi bi-shield-check text-primary me-1"></i> Xác nhận mật khẩu
                            </label>
                            <div class="input-group auth-input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-check2-circle"></i>
                                </span>
                                <input asp-for="Input.ConfirmPassword" class="form-control auth-control border-end-0" id="registerConfirmPasswordInput" autocomplete="new-password" aria-required="true" placeholder="Nhập lại mật khẩu" />
                                <button class="btn btn-pwd-toggle border border-start-0" type="button" id="toggleConfirmPasswordBtn" title="Hiện/ẩn mật khẩu">
                                    <i class="bi bi-eye" id="toggleConfirmPasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Điều khoản sử dụng -->
                        <div class="form-check my-3">
                            <input class="form-check-input auth-checkbox" type="checkbox" id="termsCheck" checked required />
                            <label class="form-check-label small text-muted user-select-none" for="termsCheck">
                                Tôi đồng ý với <a asp-controller="Home" asp-action="Privacy" class="auth-link-subtle">Điều khoản & Chính sách</a> của LUMORA
                            </label>
                        </div>

                        <!-- Nút Đăng Ký -->
                        <button id="registerSubmit" type="submit" class="btn btn-cta-accent w-100 auth-submit-btn">
                            <i class="bi bi-person-plus-fill me-2"></i> TẠO TÀI KHOẢN NGAY
                        </button>

                        <!-- Đăng ký qua dịch vụ ngoài nếu có -->
                        @{
                            if ((Model.ExternalLogins?.Count ?? 0) > 0)
                            {
                                <div class="auth-divider">
                                    <span>hoặc đăng ký với</span>
                                </div>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" form="external-account" class="btn auth-social-btn d-flex align-items-center justify-content-center gap-2" name="provider" value="@provider.Name" title="Register using your @provider.DisplayName account">
                                            <i class="bi bi-box-arrow-up-right text-primary"></i>
                                            <span>Đăng ký qua @provider.DisplayName</span>
                                        </button>
                                    }
                                </div>
                            }
                        }

                        <!-- Footer: Đã có tài khoản -> Đăng nhập -->
                        <div class="text-center mt-4 pt-3 border-top">
                            <p class="small text-muted mb-2">Đã có tài khoản học viên tại LUMORA?</p>
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-brand btn-sm px-4 py-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                            </a>
                        </div>
                    </form>

                    @* Form hỗ trợ External Account nếu có cấu hình *@
                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-none"></form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setupToggle(btnId, inputId, iconId) {
            document.getElementById(btnId)?.addEventListener('click', function () {
                const pwd = document.getElementById(inputId);
                const icon = document.getElementById(iconId);
                if (pwd && icon) {
                    const isPassword = pwd.type === 'password';
                    pwd.type = isPassword ? 'text' : 'password';
                    icon.classList.toggle('bi-eye', !isPassword);
                    icon.classList.toggle('bi-eye-slash', isPassword);
                }
            });
        }
        setupToggle('toggleRegisterPasswordBtn', 'registerPasswordInput', 'toggleRegisterPasswordIcon');
        setupToggle('toggleConfirmPasswordBtn', 'registerConfirmPasswordInput', 'toggleConfirmPasswordIcon');
    </script>
}

